function Show-OctaneCollectBackups {
    Clear-Host
    Write-Host 'Collect template backups (owner)' -ForegroundColor Cyan
    Write-Host ''
    $s = Connect-OctaneAccount -Owner
    if (-not $s) { Wait-Enter; return }
    $emails = @{}
    try { foreach ($a in @(Invoke-OctaneRpc -Name 'octane_license_list')) { $emails[[string]$a.user_id] = [string]$a.email } } catch { }
    $root = Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'Octane template backups'
    $count = 0
    try {
        $folders = @(Invoke-OctaneStorage -Method Post -Path 'object/list/octane-template-backups' -Body @{ prefix = ''; limit = 1000 })
        foreach ($f in $folders) {
            $uid = [string]$f.name
            if (-not $uid) { continue }
            $who = if ($emails.ContainsKey($uid)) { $emails[$uid] } else { $uid }
            $dir = Join-Path $root ($who -replace '[\\/:*?"<>|]', '_')
            New-Item -ItemType Directory -Force -Path $dir | Out-Null
            $files = @(Invoke-OctaneStorage -Method Post -Path 'object/list/octane-template-backups' -Body @{ prefix = "$uid/"; limit = 1000 })
            foreach ($file in $files) {
                if (-not $file.id) { continue }
                $target = Join-Path $dir $file.name
                if (Test-Path -LiteralPath $target) { continue }
                Invoke-OctaneStorage -Path "object/authenticated/octane-template-backups/$uid/$($file.name)" -OutFile $target | Out-Null
                $count++
            }
        }
        Write-Host ("Downloaded {0} new backup file(s) to {1}" -f $count, $root) -ForegroundColor Green
        if (Test-Path -LiteralPath $root) { Start-Process explorer.exe $root }
    } catch {
        Write-Host ("Could not collect backups: {0}" -f (Get-OctaneApiError $_)) -ForegroundColor Red
    }
    Wait-Enter
}

