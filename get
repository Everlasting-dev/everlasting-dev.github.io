function Test-SlipConsoleKeys {
    try {
        if ([Console]::IsInputRedirected) { return $false }
    } catch { return $false }
    try {
        if ($Host.Name -ne 'ConsoleHost') { return $false }
        $null = $Host.UI.RawUI.KeyAvailable
        return $true
    } catch { return $false }
}

function Read-SlipKey {
    $raw = $Host.UI.RawUI.ReadKey('NoEcho,IncludeKeyDown')
    $code = [int]$raw.VirtualKeyCode
    $char = ''
    if ($raw.Character -and ([int][char]$raw.Character) -ge 32) { $char = [string]$raw.Character }
    $name = ''
    switch ($code) {
        38 { $name = 'UpArrow' }
        40 { $name = 'DownArrow' }
        8 { $name = 'Backspace' }
        13 { $name = 'Enter' }
        27 { $name = 'Escape' }
        32 { $name = 'Spacebar' }
        { $_ -ge 96 -and $_ -le 105 } { $char = [string]($_ - 96) }
    }
    return @{ Name = $name; Char = $char; Code = $code }
}

function Read-PickerAction {
    if (-not (Test-SlipConsoleKeys)) { return (Read-Host 'Type a number') }
    $key = Read-SlipKey
    switch ($key.Name) {
        'UpArrow' { return 'UP' }
        'DownArrow' { return 'DOWN' }
        'Spacebar' { return 'TOGGLE' }
        'Enter' { return 'C' }
        'Escape' { return 'Q' }
    }
    $chars = [string]$key.Char
    if ($chars -match '\d') {
        $watch = [Diagnostics.Stopwatch]::StartNew()
        while ($watch.ElapsedMilliseconds -lt 450) {
            if ($Host.UI.RawUI.KeyAvailable) {
                $next = Read-SlipKey
                if ($next.Char -match '\d') {
                    $chars += $next.Char
                    $watch.Restart()
                }
                else { break }
            }
            Start-Sleep -Milliseconds 20
        }
        return $chars
    }
    return $chars
}

function Read-ArrowMenu {
    param(
        [string[]]$Items,
        [string]$Title,
        [string[]]$Lines = @(),
        [string]$ZeroLabel = 'Back',
        [string]$Hint = 'Arrow keys move. Enter chooses. Type the number to choose that line. 0 goes back.'
    )
    $index = 0
    $interactive = Test-SlipConsoleKeys
    while ($true) {
        Clear-Host
        if ($Title) {
            Write-Host $Title -ForegroundColor Cyan
            Write-Host ("Version {0}" -f $script:Version) -ForegroundColor DarkGray
            Write-Host ''
        }
        foreach ($line in $Lines) {
            if ($line) { Write-Host $line }
            else { Write-Host '' }
        }
        if ($Lines.Count -gt 0) { Write-Host '' }
        for ($i = 0; $i -lt $Items.Count; $i++) {
            $row = "[{0}] {1}" -f ($i + 1), $Items[$i]
            if ($i -eq $index -and $interactive) {
                Write-Host ("  > " + $row) -ForegroundColor Green
            }
            else {
                Write-Host ("    " + $row)
            }
        }
        Write-Host ''
        if ($ZeroLabel) { Write-Host ("    [0] {0}" -f $ZeroLabel) }
        Write-Host ''
        Write-Host $Hint -ForegroundColor DarkGray
        if (-not $interactive) {
            $typed = Read-Host 'Type a number'
            if ([string]::IsNullOrWhiteSpace($typed)) { return -1 }
            if ($typed -eq '0') { return -1 }
            if ($typed -match '^\d+$') {
                $n = [int]$typed
                if ($n -ge 1 -and $n -le $Items.Count) { return ($n - 1) }
            }
            continue
        }
        $key = Read-SlipKey
        if ($key.Name -eq 'UpArrow') {
            if ($index -gt 0) { $index-- } else { $index = $Items.Count - 1 }
            continue
        }
        if ($key.Name -eq 'DownArrow') {
            if ($index -lt ($Items.Count - 1)) { $index++ } else { $index = 0 }
            continue
        }
        if ($key.Name -eq 'Enter') { return $index }
        if ($key.Name -eq 'Escape' -or $key.Char -eq '0') { return -1 }
        if ($key.Char -match '^\d$') {
            $n = [int]$key.Char
            if ($n -ge 1 -and $n -le $Items.Count) { return ($n - 1) }
        }
    }
}

function Get-QuickPath { Join-Path (Get-SlipRoot) 'quick.txt' }
function Get-ListenPidPath { Join-Path (Get-SlipCommandDir) 'listen.pid' }
function Get-ListenPortPath { Join-Path (Get-SlipCommandDir) 'listen.port' }

function Get-QuickReceiveCommandLine {
    $scriptPath = Get-InstalledScriptPath
    return "`"powershell.exe`" -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File `"$scriptPath`" listen"
}

function Get-QuickReceiveRunValue {
    try {
        return [string](Get-ItemPropertyValue -LiteralPath 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Run' -Name (Get-QuickRunName) -ErrorAction Stop)
    } catch {
        return ''
    }
}

function Get-QuickListenerPid {
    $pidPath = Get-ListenPidPath
    if (-not (Test-Path -LiteralPath $pidPath)) { return 0 }
    $listenPid = 0
    if ([int]::TryParse((Get-Content -LiteralPath $pidPath -Raw -ErrorAction SilentlyContinue).Trim(), [ref]$listenPid)) {
        return $listenPid
    }
    return 0
}

function Test-QuickListenerAlive {
    $listenPid = Get-QuickListenerPid
    if ($listenPid -le 0) { return $false }
    return $null -ne (Get-Process -Id $listenPid -ErrorAction SilentlyContinue)
}

function Get-QuickListenerPorts {
    $ports = @()
    $portPath = Get-ListenPortPath
    if (Test-Path -LiteralPath $portPath) {
        $port = 0
        if ([int]::TryParse((Get-Content -LiteralPath $portPath -Raw -ErrorAction SilentlyContinue).Trim(), [ref]$port)) {
            if ($port -gt 0) { $ports += $port }
        }
    }
    $listenPid = Get-QuickListenerPid
    if ($listenPid -gt 0) {
        try {
            $ports += @(Get-NetTCPConnection -State Listen -OwningProcess $listenPid -ErrorAction Stop |
                Where-Object { $_.LocalPort -ge $script:PortFirst -and $_.LocalPort -le $script:PortLast } |
                Select-Object -ExpandProperty LocalPort)
        } catch { }
    }
    return @($ports | Where-Object { $_ } | Sort-Object -Unique)
}

function Show-QuickReceiveStatus {
    $quickOn = Test-QuickReceive
    if ($quickOn) { Write-Host 'Quick receive: on' -ForegroundColor Green }
    else { Write-Host 'Quick receive: off' -ForegroundColor Yellow }

    $runValue = Get-QuickReceiveRunValue
    if ($quickOn) {
        if ($runValue) {
            Write-Host 'Startup:       registry entry present' -ForegroundColor Green
        } else {
            Write-Host 'Startup:       registry entry missing' -ForegroundColor Yellow
        }
    } else {
        if ($runValue) {
            Write-Host 'Startup:       stale registry entry present' -ForegroundColor Yellow
        } else {
            Write-Host 'Startup:       off'
        }
    }

    $listenPid = Get-QuickListenerPid
    if ($listenPid -le 0) {
        Write-Host 'Listener:      not running' -ForegroundColor Yellow
        return
    }
    if (-not (Test-QuickListenerAlive)) {
        Write-Host ("Listener:      pid {0} is not running" -f $listenPid) -ForegroundColor Yellow
        return
    }

    $ports = @(Get-QuickListenerPorts)
    if ($ports.Count -eq 0) {
        Write-Host ("Listener:      pid {0} alive, port unknown" -f $listenPid) -ForegroundColor Yellow
        return
    }

    $checks = @()
    foreach ($port in $ports) {
        $checks += ("{0} {1}" -f $port, (Format-Check (Test-TcpOpen '127.0.0.1' $port)))
    }
    Write-Host ("Listener:      pid {0}, port {1}" -f $listenPid, ($checks -join ', ')) -ForegroundColor Green
}

function Test-QuickReceive {
    $path = Get-QuickPath
    if (-not (Test-Path -LiteralPath $path)) { return $false }
