function Get-EntryOptions {
    $o = @{
        Entry = 'launcher'
        Address = $null
        Port = 0
        Pin = $null
        Token = $null
        OutDir = $null
        ReadyFile = $null
        DisplayName = $null
        QuickReceive = $false
        MakeNetworkPrivate = $false
        Quiet = $false
        Room = $null
        PeerName = $null
        OpeningB64 = $null
        PeopleB64 = $null
        Paths = @()
    }
    if ($env:SLIP_ENTRY) { $o.Entry = $env:SLIP_ENTRY }
    $pending = @($script:RawArgs)
    $paths = @()
    $i = 0
    while ($i -lt $pending.Count) {
        $token = [string]$pending[$i]
        if ($token -eq 'menu') { $o.Entry = 'menu' }
        elseif ($token -eq 'firewall') { $o.Entry = 'firewall' }
        elseif ($token -eq 'unfirewall') { $o.Entry = 'unfirewall' }
        elseif ($token -eq 'netprivate') { $o.Entry = 'netprivate' }
        elseif ($token -eq 'serve') { $o.Entry = 'serve' }
        elseif ($token -eq 'recv') { $o.Entry = 'recv' }
        elseif ($token -eq 'listen') { $o.Entry = 'listen' }
        elseif ($token -eq 'chatlisten') { $o.Entry = 'chatlisten' }
        elseif ($token -eq 'chatjoin') { $o.Entry = 'chatjoin' }
        elseif ($token -eq 'chathost') { $o.Entry = 'chathost' }
        elseif ($token -eq 'install' -or $token -eq 'setup') { $o.Entry = 'install' }
        elseif ($token -eq 'upgrade' -or $token -eq 'update' -or $token -eq 'migrate' -or $token -eq 'repair') { $o.Entry = 'upgrade' }
        elseif ($token -eq '-Address' -and ($i + 1) -lt $pending.Count) { $i++; $o.Address = [string]$pending[$i] }
        elseif ($token -eq '-Port' -and ($i + 1) -lt $pending.Count) { $i++; $o.Port = [int]$pending[$i] }
        elseif ($token -eq '-Pin' -and ($i + 1) -lt $pending.Count) { $i++; $o.Pin = [string]$pending[$i] }
        elseif ($token -eq '-Token' -and ($i + 1) -lt $pending.Count) { $i++; $o.Token = [string]$pending[$i] }
        elseif ($token -eq '-OutDir' -and ($i + 1) -lt $pending.Count) { $i++; $o.OutDir = [string]$pending[$i] }
        elseif ($token -eq '-ReadyFile' -and ($i + 1) -lt $pending.Count) { $i++; $o.ReadyFile = [string]$pending[$i] }
        elseif ($token -eq '-DisplayName' -and ($i + 1) -lt $pending.Count) { $i++; $o.DisplayName = [string]$pending[$i] }
        elseif ($token -eq '-QuickReceive' -or $token -eq '-EnableQuickReceive' -or $token -eq '-AutoReceive') { $o.QuickReceive = $true }
        elseif ($token -eq '-MakeNetworkPrivate' -or $token -eq '-PrivateNetwork') { $o.MakeNetworkPrivate = $true }
        elseif ($token -eq '-Quiet' -or $token -eq '-Silent' -or $token -eq '/quiet' -or $token -eq '/silent') { $o.Quiet = $true }
        elseif ($token -eq '-Room' -and ($i + 1) -lt $pending.Count) { $i++; $o.Room = [string]$pending[$i] }
        elseif ($token -eq '-PeerName' -and ($i + 1) -lt $pending.Count) { $i++; $o.PeerName = [string]$pending[$i] }
        elseif ($token -eq '-OpeningB64' -and ($i + 1) -lt $pending.Count) { $i++; $o.OpeningB64 = [string]$pending[$i] }
        elseif ($token -eq '-PeopleB64' -and ($i + 1) -lt $pending.Count) { $i++; $o.PeopleB64 = [string]$pending[$i] }
        elseif ($token -like '-*') { }
        else { $paths += $token }
        $i++
    }
    $o.Paths = $paths
    return $o
}

function Exit-Slip {
    param([int]$Code)
    if ($PSCommandPath) { exit $Code }
}

$script:Opt = Get-EntryOptions
switch ($script:Opt.Entry) {
    'install' {
        try {
            if (Invoke-UnattendedInstall -DisplayName $script:Opt.DisplayName -QuickReceive:$script:Opt.QuickReceive -Quiet:$script:Opt.Quiet -MakeNetworkPrivate:$script:Opt.MakeNetworkPrivate) {
                Exit-Slip 0
            } else {
                Exit-Slip 1
            }
        } catch {
            if (-not $script:Opt.Quiet) {
                [Console]::Error.WriteLine($_.Exception.Message)
            }
            Exit-Slip 1
        }
    }
    'upgrade' {
        try {
            if ($env:SLIP_FETCHED_UPGRADE -eq '1') {
                $upgraded = Invoke-UnattendedUpgrade -DisplayName $script:Opt.DisplayName -QuickReceive:$script:Opt.QuickReceive -Quiet:$script:Opt.Quiet -MakeNetworkPrivate:$script:Opt.MakeNetworkPrivate
            } else {
                if (-not $script:Opt.Quiet) { Write-Host "Downloading the latest $($script:AppName)..." -ForegroundColor Cyan }
                $payload = Join-Path $env:TEMP 'slip-upgrade.ps1'
                Remove-Item -LiteralPath $payload -Force -ErrorAction SilentlyContinue
                Invoke-RestMethod -Uri $script:SourceUrl -OutFile $payload -ErrorAction Stop
                $payloadVersion = 'unknown'
                $payloadBytes = 0
                try {
                    $payloadBytes = (Get-Item -LiteralPath $payload -ErrorAction Stop).Length
                    $match = [regex]::Match([IO.File]::ReadAllText($payload), "\`$script:Version\s*=\s*'([^']+)'")
                    if ($match.Success) { $payloadVersion = $match.Groups[1].Value }
                } catch { }
                Write-SlipLog "Upgrade downloaded online payload. source=$($script:SourceUrl) version=$payloadVersion bytes=$payloadBytes."
                $forward = @('upgrade')
                if ($script:Opt.DisplayName) { $forward += @('-DisplayName', $script:Opt.DisplayName) }
                if ($script:Opt.QuickReceive) { $forward += '-QuickReceive' }
                if ($script:Opt.MakeNetworkPrivate) { $forward += '-MakeNetworkPrivate' }
                if ($script:Opt.Quiet) { $forward += '-Quiet' }
                $env:SLIP_FETCHED_UPGRADE = '1'
                try {
                    & powershell.exe -NoProfile -ExecutionPolicy Bypass -File $payload @forward
                    $upgraded = ($LASTEXITCODE -eq 0)
                } finally {
                    Remove-Item Env:SLIP_FETCHED_UPGRADE -ErrorAction SilentlyContinue
                    Remove-Item -LiteralPath $payload -Force -ErrorAction SilentlyContinue
                }
            }
            if ($upgraded) { Exit-Slip 0 } else { Exit-Slip 1 }
        } catch {
            if (-not $script:Opt.Quiet) {
                [Console]::Error.WriteLine($_.Exception.Message)
            }
            Write-SlipLog "Upgrade failed: $($_.Exception.Message)"
            Exit-Slip 1
        }
    }
    'firewall' {
        try {
            Install-FirewallRules
            Exit-Slip 0
        } catch {
            Write-Host $_.Exception.Message -ForegroundColor Red
            Exit-Slip 1
        }
    }
    'unfirewall' {
        try {
            Uninstall-FirewallRules
            Exit-Slip 0
        } catch {
            Write-Host $_.Exception.Message -ForegroundColor Red
            Exit-Slip 1
        }
    }
    'netprivate' {
        try {
            [void](Set-ActiveNetworksPrivate)
            if (@(Get-PublicNetworkProfiles).Count -eq 0) { Exit-Slip 0 } else { Exit-Slip 1 }
        } catch {
            Write-Host $_.Exception.Message -ForegroundColor Red
            Exit-Slip 1
        }
    }
    'serve' {
        if ($script:Opt.Paths.Count -lt 1) {
            [Console]::Error.WriteLine('serve needs a file path')
            Exit-Slip 1
        } else {
            $items = @(foreach ($path in $script:Opt.Paths) { Get-Item -LiteralPath $path })
            $payload = New-SendPayload $items
            $ok = Start-ShareServer -FilePath $payload.Path -DownloadName $payload.Name -TempToDelete $payload.Temp -ReadyFile $script:Opt.ReadyFile -Quiet
            if ($ok) { Exit-Slip 0 } else { Exit-Slip 2 }
        }
    }
    'recv' {
        if (-not $script:Opt.Address -or -not $script:Opt.Port -or -not $script:Opt.Pin -or -not $script:Opt.Token) {
            [Console]::Error.WriteLine('recv needs -Address -Port -Pin -Token')
            Exit-Slip 1
        } else {
            $destDir = if ($script:Opt.OutDir) { $script:Opt.OutDir } else { Get-InboxPath }
            $url = "http://$($script:Opt.Address):$($script:Opt.Port)/d/$($script:Opt.Token)?pin=$([Uri]::EscapeDataString($script:Opt.Pin))"
            try {
                $saved = Save-RemoteFile -Url $url -Directory $destDir -Quiet
                [Console]::Out.WriteLine($saved)
                if (-not $script:Opt.Quiet) {
                    Open-ContainingFolder $saved -Force
                }
                Exit-Slip 0
            } catch {
                [Console]::Error.WriteLine($_.Exception.Message)
                Exit-Slip 1
            }
        }
    }
    'listen' {
        try {
            Start-QuickListener
            Exit-Slip 0
        } catch {
            [Console]::Error.WriteLine($_.Exception.Message)
            Exit-Slip 1
        }
    }
    'chatlisten' {
        try {
            Start-ChatListener
            Exit-Slip 0
        } catch {
            [Console]::Error.WriteLine($_.Exception.Message)
            Exit-Slip 1
        }
    }
    'chatjoin' {
        try {
            $from = ''
            $text = ''
            if ($script:Opt.PeerName) { $from = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($script:Opt.PeerName)) }
            if ($script:Opt.OpeningB64) { $text = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($script:Opt.OpeningB64)) }
            $client = New-Object System.Net.Sockets.TcpClient
            $wait = $client.BeginConnect($script:Opt.Address, [int]$script:Opt.Port, $null, $null)
            if (-not $wait.AsyncWaitHandle.WaitOne(5000, $false)) { throw 'chat closed' }
            $client.EndConnect($wait)
            Show-ChatSession -Room $script:Opt.Room -Title $from -Stream $client.GetStream() -Client $client -OpeningFrom $from -OpeningText $text
            Exit-Slip 0
        } catch {
            Write-Host 'chat closed' -ForegroundColor DarkGray
            Exit-Slip 1
        }
    }
    'chathost' {
        try {
            $people = @()
            if ($script:Opt.PeopleB64) {
                $json = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($script:Opt.PeopleB64))
                $people = @(ConvertFrom-Json $json)
            }
            $text = ''
            if ($script:Opt.OpeningB64) { $text = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($script:Opt.OpeningB64)) }
            if ($people.Count -gt 0 -and $text) {
                Start-ChatWith -People $people -Text $text
            } else {
                Write-Host 'Nothing to chat.' -ForegroundColor Yellow
            }
            Write-Host ''
            Write-Host 'Chat closed. Press Enter to close this window.' -ForegroundColor DarkGray
            [void](Read-Host)
            Exit-Slip 0
        } catch {
            Write-Host 'chat closed' -ForegroundColor DarkGray
            [void](Read-Host)
            Exit-Slip 1
        }
    }
    'menu' { Show-SlipMenu }
    default { Show-Launcher }
}
