}

function Get-OutboxItems {
    $path = Get-OutboxPath
    if (-not (Test-Path -LiteralPath $path)) { return @() }
    return @(Get-ChildItem -LiteralPath $path -Force |
        Where-Object { $_.Name -notin @('desktop.ini', 'Thumbs.db') } |
        Sort-Object -Property @{ Expression = { if ($_.PSIsContainer) { 0 } else { 1 } } }, Name)
}

function Open-DebugFolder {
    Ensure-SlipFiles | Out-Null
    Open-Folder (Get-DebugPath)
}

function Write-SlipLog {
    param([string]$Message)
    try {
        $debug = Get-DebugPath
        if (-not (Test-Path -LiteralPath $debug)) {
            New-Item -ItemType Directory -Force -Path $debug | Out-Null
        }
        $line = '{0} {1}' -f (Get-Date -Format 'o'), ($Message -replace '[\r\n]+', ' ')
        Add-Content -LiteralPath (Join-Path $debug "$($script:CommandName).log") -Value $line -Encoding ASCII
    } catch { }
}

function Get-TransferDebugPath {
    Join-Path (Get-DebugPath) 'transfer-debug.log'
}

function ConvertTo-LogField {
    param($Value)
    if ($null -eq $Value) { return '-' }
    $text = [string]$Value
    $text = ($text -replace '[\r\n\t|]+', ' ').Trim()
    if ($text.Length -gt 300) { $text = $text.Substring(0, 300) + '...' }
    if (-not $text) { return '-' }
    return $text
}

function Write-TransferDebug {
    param([string]$Event, [hashtable]$Fields)
    try {
        $debug = Get-DebugPath
        if (-not (Test-Path -LiteralPath $debug)) {
            New-Item -ItemType Directory -Force -Path $debug | Out-Null
        }
        $pairs = @()
        if ($Fields) {
            foreach ($key in ($Fields.Keys | Sort-Object)) {
                $pairs += ("{0}={1}" -f $key, (ConvertTo-LogField $Fields[$key]))
            }
        }
        $line = '{0} {1}' -f (Get-Date -Format 'o'), (ConvertTo-LogField $Event)
        if ($pairs.Count -gt 0) { $line += ' | ' + ($pairs -join ' | ') }
        Add-Content -LiteralPath (Get-TransferDebugPath) -Value $line -Encoding ASCII
    } catch { }
}

function Get-TreeSize {
    param($Item)
    if (-not $Item.PSIsContainer) { return [long]$Item.Length }
    $sum = (Get-ChildItem -LiteralPath $Item.FullName -Recurse -File -Force -ErrorAction SilentlyContinue | Measure-Object -Property Length -Sum).Sum
    if (-not $sum) { return 0L }
    return [long]$sum
}

function Start-ExplorerWindow {
    param([string]$Argument)
    $explorer = Join-Path $env:WINDIR 'explorer.exe'
    try {
        Start-Process -FilePath $explorer -ArgumentList $Argument -WindowStyle Normal -ErrorAction Stop | Out-Null
        return $true
    } catch {
        Write-SlipLog "Explorer Start-Process failed: $($_.Exception.Message)"
    }
    try {
        $psi = New-Object System.Diagnostics.ProcessStartInfo
        $psi.FileName = $explorer
        $psi.Arguments = $Argument
        $psi.UseShellExecute = $true
        $psi.WindowStyle = [System.Diagnostics.ProcessWindowStyle]::Normal
        [System.Diagnostics.Process]::Start($psi) | Out-Null
        return $true
    } catch {
        Write-SlipLog "Explorer ShellExecute failed: $($_.Exception.Message)"
    }
    return $false
}

function Open-Folder {
    param([string]$Path, [switch]$Force)
    if (-not (Test-Path -LiteralPath $Path)) {
        New-Item -ItemType Directory -Force -Path $Path | Out-Null
    }
    $full = [IO.Path]::GetFullPath($Path)
    if (-not $Force -and (Focus-ExplorerFolder -FolderPath $full)) { return }
    if (Start-ExplorerWindow -Argument ("`"{0}`"" -f $full)) {
        Start-Sleep -Milliseconds 500
        [void](Focus-ExplorerFolder -FolderPath $full)
    }
}

function Open-ContainingFolder {
    param([string]$Path, [switch]$Force)
    if (-not $Path) { return }
    $full = [IO.Path]::GetFullPath($Path)
    $isFolder = Test-Path -LiteralPath $full -PathType Container
    $folder = if ($isFolder) { $full } else { Split-Path -Parent $full }
    if (-not (Test-Path -LiteralPath $folder)) {
        New-Item -ItemType Directory -Force -Path $folder | Out-Null
    }
    if (-not $isFolder -and (Test-Path -LiteralPath $full -PathType Leaf)) {
        if (-not $Force -and (Focus-ExplorerFolder -FolderPath $folder -SelectPath $full)) { return }
        if (Start-ExplorerWindow -Argument ("/select,`"{0}`"" -f $full)) {
            Start-Sleep -Milliseconds 500
            [void](Focus-ExplorerFolder -FolderPath $folder -SelectPath $full)
        } else {
            Open-Folder $folder -Force:$Force
        }
        return
    }
    Open-Folder $folder -Force:$Force
}

function Focus-ExplorerFolder {
    param([string]$FolderPath, [string]$SelectPath)
    $folder = [IO.Path]::GetFullPath($FolderPath)
    $select = $null
    if ($SelectPath) { $select = [IO.Path]::GetFullPath($SelectPath) }
    $ps = [PowerShell]::Create()
    [void]$ps.AddScript({
        param($Folder, $Select)
        try {
            $shell = New-Object -ComObject Shell.Application
            foreach ($window in @($shell.Windows())) {
                try { $location = [string]$window.Document.Folder.Self.Path } catch { continue }
                if (-not $location) { continue }
                try { $location = [IO.Path]::GetFullPath($location) } catch { continue }
                if ($location -ine $Folder) { continue }
                if ($Select) {
                    try {
                        $leaf = [IO.Path]::GetFileName($Select)
                        $item = $window.Document.Folder.ParseName($leaf)
                        if ($item) {
                            $flags = 1 -bor 4 -bor 8 -bor 16
                            $window.Document.SelectItem($item, $flags)
                        }
                    } catch { }
                }
                if (-not ('SlipWin.SlipWindow' -as [type])) {
                    Add-Type -MemberDefinition '[DllImport("user32.dll")] public static extern bool ShowWindow(IntPtr hWnd, int nCmdShow); [DllImport("user32.dll")] public static extern bool SetForegroundWindow(IntPtr hWnd);' -Name SlipWindow -Namespace SlipWin | Out-Null
                }
                $hwnd = [IntPtr]$window.HWND
                [void][SlipWin.SlipWindow]::ShowWindow($hwnd, 9)
                [void][SlipWin.SlipWindow]::SetForegroundWindow($hwnd)
                return $true
            }
        } catch { }
        return $false
    }).AddArgument($folder).AddArgument($select)
    $handle = $ps.BeginInvoke()
    $focused = $false
    if ($handle.AsyncWaitHandle.WaitOne(1500, $false)) {
        try {
            $result = @($ps.EndInvoke($handle))
            if ($result.Count -gt 0 -and $result[-1]) { $focused = $true }
        } catch { }
    }
    else {
        try { $ps.Stop() } catch { }
    }
    try { $ps.Dispose() } catch { }
    return $focused
}

function New-SendPayload {
    param($Items)
    $files = @($Items | Where-Object { -not $_.PSIsContainer })
    $dirs = @($Items | Where-Object { $_.PSIsContainer })
    if ($files.Count -eq 1 -and $dirs.Count -eq 0) {
        return @{
            Path = $files[0].FullName
            Name = $files[0].Name
            Temp = $null
            Size = [long]$files[0].Length
        }
    }
    $stage = Join-Path $env:TEMP ("{0}-stage-{1}" -f $script:CommandName, [guid]::NewGuid().ToString('N'))
    New-Item -ItemType Directory -Force -Path $stage | Out-Null
    $zip = Join-Path $env:TEMP ("{0}-{1}.zip" -f $script:CommandName, [guid]::NewGuid().ToString('N'))
    $downloadName = if ($files.Count -eq 0 -and $dirs.Count -eq 1) {
        "{0}.zip" -f $dirs[0].Name
    } else {
        "{0}-files-{1}.zip" -f $script:AppName, (Get-Date -Format 'yyyyMMdd-HHmmss')
    }
    try {
        foreach ($dir in $dirs) {
            Copy-Item -LiteralPath $dir.FullName -Destination (Join-Path $stage $dir.Name) -Recurse -Force
        }
        foreach ($file in $files) {
            $dest = Join-Path $stage $file.Name
            $n = 1
            while (Test-Path -LiteralPath $dest) {
                $dest = Join-Path $stage ("{0} ({1}){2}" -f $file.BaseName, $n, $file.Extension)
                $n++
            }
            Copy-Item -LiteralPath $file.FullName -Destination $dest -Force
        }
        Add-Type -AssemblyName System.IO.Compression.FileSystem
        [IO.Compression.ZipFile]::CreateFromDirectory($stage, $zip)
    }
    finally {
        Remove-Item -LiteralPath $stage -Recurse -Force -ErrorAction SilentlyContinue
    }
    return @{
        Path = $zip
        Name = $downloadName
        Temp = $zip
        Size = [long](Get-Item -LiteralPath $zip).Length
    }
}

function Read-HttpHeaders {
    param($Stream)
    $ms = New-Object System.IO.MemoryStream
    $one = New-Object byte[] 1
    while ($ms.Length -lt 16384) {
        $n = $Stream.Read($one, 0, 1)
        if ($n -le 0) { break }
        $ms.Write($one, 0, 1)
        if ($ms.Length -ge 4) {
            $buffer = $ms.GetBuffer()
            $i = [int]$ms.Length - 4
            if ($buffer[$i] -eq 13 -and $buffer[$i + 1] -eq 10 -and $buffer[$i + 2] -eq 13 -and $buffer[$i + 3] -eq 10) { break }
        }
    }
    return [Text.Encoding]::ASCII.GetString($ms.ToArray(), 0, [int]$ms.Length)
}

function Write-HttpBytes {
    param($Stream, [string]$Head, [byte[]]$Body)
    $headBytes = [Text.Encoding]::ASCII.GetBytes($Head)
    $Stream.Write($headBytes, 0, $headBytes.Length)
    if ($Body -and $Body.Length -gt 0) {
        $Stream.Write($Body, 0, $Body.Length)
    }
}

function Send-HttpText {
    param($Stream, [int]$Code, [string]$Status, [string]$ContentType, [string]$Body)
    $bytes = [Text.Encoding]::UTF8.GetBytes($Body)
    $head = "HTTP/1.1 $Code $Status`r`nContent-Type: $ContentType; charset=utf-8`r`nContent-Length: $($bytes.Length)`r`nConnection: close`r`n`r`n"
    Write-HttpBytes -Stream $Stream -Head $head -Body $bytes
}

function Write-PercentLine {
    param([string]$Label, [int]$Percent, [long]$Size = -1)
    $sizeText = ''
    if ($Size -ge 0) { $sizeText = Format-ByteSize $Size }
    $text = '{0,-32} {1,8} {2,3}%' -f $Label, $sizeText, $Percent
    Write-Host ("`r" + $text) -NoNewline
}

function Send-FileResponse {
    param($Stream, [string]$FilePath, [string]$DownloadName, [switch]$Quiet)
    $len = [long](Get-Item -LiteralPath $FilePath).Length
    $ascii = ($DownloadName -replace '[^\x20-\x7E]', '_') -replace '"', ''
    $star = [Uri]::EscapeDataString($DownloadName)
    $head = "HTTP/1.1 200 OK`r`nContent-Type: application/octet-stream`r`nContent-Length: $len`r`nContent-Disposition: attachment; filename=`"$ascii`"; filename*=UTF-8''$star`r`nConnection: close`r`n`r`n"
    $headBytes = [Text.Encoding]::ASCII.GetBytes($head)
    $Stream.Write($headBytes, 0, $headBytes.Length)
    $fs = [IO.File]::Open($FilePath, 'Open', 'Read', 'ReadWrite')
    $last = -1
    try {
        $buf = New-Object byte[] (1MB)
        $sent = 0L
        while (($n = $fs.Read($buf, 0, $buf.Length)) -gt 0) {
            $Stream.Write($buf, 0, $n)
            $sent += $n
            if (-not $Quiet -and $len -gt 0) {
                $pct = [int](($sent * 100) / $len)
                if ($pct -gt 100) { $pct = 100 }
                if ($pct -ne $last) {
                    Write-PercentLine -Label ("Sending " + (Get-ShortText $DownloadName 28)) -Percent $pct -Size $len
                    $last = $pct
                }
            }
        }
        $Stream.Flush()
        if (-not $Quiet -and $last -ge 0) { Write-Host '' }
    } finally {
        $fs.Dispose()
    }
}

function Test-PinMatch {
    param([string]$Given, [string]$Expected)
    if ([string]::IsNullOrEmpty($Given) -or [string]::IsNullOrEmpty($Expected)) { return $false }
    if ($Given.Length -ne $Expected.Length) { return $false }
    $diff = 0
    for ($i = 0; $i -lt $Given.Length; $i++) {
        $diff = $diff -bor ([int][char]$Given[$i] -bxor [int][char]$Expected[$i])
    }
    return ($diff -eq 0)
}

function Handle-HttpClient {
    param($Client, [string]$Token, [string]$Pin, [string]$FilePath, [string]$DownloadName, [switch]$Quiet)
    $Client.ReceiveTimeout = 20000
    $remote = $null
    try { $remote = [string]$Client.Client.RemoteEndPoint } catch { $remote = 'unknown' }
    $stream = $Client.GetStream()
    $raw = Read-HttpHeaders $stream
    $line = ($raw -split "`r`n")[0]
    Write-TransferDebug 'send.pin.http-request' @{ remote = $remote; request = $line; file = $DownloadName }
    if ($line -notmatch '^GET\s+(\S+)\s+HTTP/') {
        Send-HttpText $stream 400 'Bad Request' 'text/plain' 'Bad request'
        Write-TransferDebug 'send.pin.rejected' @{ remote = $remote; reason = 'bad request'; request = $line }
        return $false
    }
    $target = $Matches[1]
    $q = $target.IndexOf('?')
    $path = if ($q -ge 0) { $target.Substring(0, $q) } else { $target }
    $query = if ($q -ge 0) { $target.Substring($q + 1) } else { '' }
    $given = $null
    foreach ($pair in ($query -split '&')) {
        if (-not $pair) { continue }
        $kv = $pair -split '=', 2
        if ($kv[0] -eq 'pin' -and $kv.Length -eq 2) {
            $given = [Uri]::UnescapeDataString(($kv[1] -replace '\+', ' '))
        }
    }
    $downloadPath = "/d/$Token"
    if ($path -eq '/' -or ($path -eq $downloadPath -and -not $given)) {
        $html = @"
<!DOCTYPE html>
<html><head><meta charset="utf-8"><title>$($script:AppName)</title></head>
<body>
<p>Enter the PIN from the other PC.</p>
<form method="get" action="$downloadPath">
<input name="pin" inputmode="numeric" autofocus>
<button type="submit">Download</button>
</form>
</body></html>
"@
        Send-HttpText $stream 200 'OK' 'text/html' $html
        return $false
    }
    if ($path -ne $downloadPath) {
        Send-HttpText $stream 404 'Not Found' 'text/plain' 'Not found'
        Write-TransferDebug 'send.pin.rejected' @{ remote = $remote; reason = 'not found'; path = $path }
        return $false
    }
    if (-not (Test-PinMatch $given $Pin)) {
        Send-HttpText $stream 401 'Unauthorized' 'text/plain' 'Wrong PIN'
        Write-TransferDebug 'send.pin.rejected' @{ remote = $remote; reason = 'wrong pin'; path = $path }
        return $false
    }
    Write-TransferDebug 'send.pin.accepted' @{ remote = $remote; file = $DownloadName; size = (Get-Item -LiteralPath $FilePath).Length }
    Send-FileResponse -Stream $stream -FilePath $FilePath -DownloadName $DownloadName -Quiet:$Quiet
    Write-TransferDebug 'send.pin.completed' @{ remote = $remote; file = $DownloadName; size = (Get-Item -LiteralPath $FilePath).Length }
    return $true
}

function Send-Beacon {
    param([string]$Token, [int]$Port, [long]$Size, [string]$FileName)
    $msg = @(
        $script:BeaconPrefix,
        $Token,
        $Port,
        (ConvertTo-BeaconField (Get-DisplayName)),
        (ConvertTo-BeaconField $env:COMPUTERNAME),
        $Size,
        (ConvertTo-BeaconField $FileName)
    ) -join '|'
    return (Send-BeaconPayload -Payload $msg -Port $script:BeaconPort)
}

function Start-ShareServer {
    param(
        [string]$FilePath,
        [string]$DownloadName,
        [string]$TempToDelete,
        [string]$ReadyFile,
        [switch]$Quiet
    )
    $listener = $null
    $port = 0
    foreach ($candidate in $script:PortFirst..$script:PortLast) {
        $tryListen = $null
        try {
            $tryListen = New-Object System.Net.Sockets.TcpListener ([Net.IPAddress]::Any, $candidate)
            $tryListen.Start()
            $listener = $tryListen
            $port = $candidate
            break
        } catch {
            if ($tryListen) { try { $tryListen.Stop() } catch {} }
        }
    }
    if (-not $listener) { throw "No free port between $($script:PortFirst) and $($script:PortLast)." }

    $token = ([guid]::NewGuid().ToString('N')).Substring(0, 16)
    $pin = (Get-Random -Minimum 0 -Maximum 1000000).ToString('000000')
    $size = [long](Get-Item -LiteralPath $FilePath).Length
    Write-TransferDebug 'send.pin.ready' @{ file = $DownloadName; size = $size; port = $port; quiet = [bool]$Quiet }
    $done = $false
    try {
        if ($ReadyFile) {
            Set-Content -LiteralPath $ReadyFile -Value "$port $pin $token" -Encoding ASCII
        }
        if ($Quiet) {
            [Console]::Out.WriteLine("READY $port $pin $token")
            [Console]::Out.Flush()
        } else {
            Write-Host ''
            Write-Host ("Other PCs see you as: {0} ({1})" -f (Get-DisplayName), $env:COMPUTERNAME)
            Write-Host ("File: {0}  ({1})" -f $DownloadName, (Format-ByteSize $size))
            Write-Host ''
            Write-Host "PIN  $pin" -ForegroundColor Yellow
            $shown = @(Get-LanIPv4)
            if ($shown.Count -eq 0) { $shown = @('127.0.0.1') }
            foreach ($ip in $shown) {
                Write-Host "URL  http://${ip}:$port/" -ForegroundColor Yellow
            }
            Write-Host ''
            Write-Host 'Leave this window open. Waiting up to 15 minutes for one download.'
            Write-Host 'Press Q to cancel.' -ForegroundColor DarkGray
        }
        $deadline = (Get-Date).AddMinutes(15)
        $lastBeacon = [datetime]::MinValue
        while (-not $done -and (Get-Date) -lt $deadline) {
            if (((Get-Date) - $lastBeacon).TotalSeconds -ge 1) {
                try { [void](Send-Beacon $token $port $size $DownloadName) } catch {}
                $lastBeacon = Get-Date
            }
            if (-not $Quiet) {
                try {
                    if (-not [Console]::IsInputRedirected -and [Console]::KeyAvailable) {
                        $key = [Console]::ReadKey($true)
                        if ($key.Key -eq 'Q' -or $key.Key -eq 'Escape') { break }
                    }
                } catch {}
            }
            if (-not $listener.Pending()) {
                Start-Sleep -Milliseconds 200
                continue
            }
            $client = $listener.AcceptTcpClient()
            try {
                $ok = Handle-HttpClient -Client $client -Token $token -Pin $pin -FilePath $FilePath -DownloadName $DownloadName -Quiet:$Quiet
                if ($ok) { $done = $true }
            } catch {
                Write-TransferDebug 'send.pin.failed' @{ file = $DownloadName; error = $_.Exception.Message }
            } finally {
                try { $client.Close() } catch {}
            }
        }
        if ($done) {
            Write-TransferDebug 'send.pin.finished' @{ file = $DownloadName; size = $size; port = $port }
        } else {
            Write-TransferDebug 'send.pin.stopped' @{ file = $DownloadName; size = $size; port = $port }
        }
        if (-not $Quiet) {
            Write-Host ''
            if ($done) { Write-Host 'Download finished. The other PC has the file.' -ForegroundColor Green }
            else { Write-Host 'Stopped before a download finished.' -ForegroundColor Yellow }
        }
    } finally {
        try { $listener.Stop() } catch {}
        if ($TempToDelete) {
            Remove-Item -LiteralPath $TempToDelete -Force -ErrorAction SilentlyContinue
        }
    }
    return $done
}

function Show-SendFiles {
    while ($true) {
        $items = @(Get-OutboxItems)
        Clear-Host
        Write-Host 'Send files' -ForegroundColor Cyan
        Write-Host ''
        Write-Host (Get-SendStepsText)
        Write-Host ''
        if ($items.Count -eq 0) {
            Write-Host 'The Outbox is empty.' -ForegroundColor Yellow
            Write-Host ("Put files in {0}" -f (Get-OutboxPath))
            Write-Host ''
            $open = Read-Host '[O] Open Outbox  [R] Refresh  [Q] Back'
            if ($open -match '^[Oo]') {
                Open-Folder (Get-OutboxPath)
                Write-Host ''
                Write-Host 'Add files to Outbox, then press Enter to refresh.' -ForegroundColor DarkGray
                [void](Read-Host)
                continue
            }
            if ([string]::IsNullOrWhiteSpace($open) -or $open -match '^[Rr]') { continue }
            return
        }
        $selected = @{}
        for ($i = 0; $i -lt $items.Count; $i++) { $selected[$i] = $true }
        $cursor = 0
        $picked = @()
        # Step loop: file selection, then choosing a PC. Backing out of the PC
        # search returns here to the file list instead of the main menu.
        while ($true) {
        $confirmed = $false
        while (-not $confirmed) {
            Clear-Host
            Write-Host 'Send files' -ForegroundColor Cyan
            Write-Host ''
            Write-Host (Get-SendStepsText)
            Write-Host ''
            Write-Host ("  {0,-6} {1,-6} {2,-42} {3}" -f '#', 'Send', 'Name', 'Size')
            for ($i = 0; $i -lt $items.Count; $i++) {
                $mark = if ($selected[$i]) { '[x]' } else { '[ ]' }
                $line = "[{0}]  {1,-6} {2,-42} {3}" -f ($i + 1), $mark, (Get-ShortText $items[$i].Name), (Format-ByteSize (Get-TreeSize $items[$i]))
                if ($i -eq $cursor -and (Test-SlipConsoleKeys)) {
                    Write-Host ("  > " + $line) -ForegroundColor Green
                }
                else {
                    Write-Host ("    " + $line)
                }
            }
            Write-Host ''
            Write-Host 'Arrow keys move. Space toggles. Type a number to toggle that file.'
            Write-Host 'A all, N none, O open folder, C or Enter continue, Q back.'
            $choice = Read-PickerAction
            if ([string]::IsNullOrWhiteSpace($choice) -and [Console]::IsInputRedirected) { return }
            if ($choice -eq 'UP') {
                if ($cursor -gt 0) { $cursor-- } else { $cursor = $items.Count - 1 }
                continue
            }
            if ($choice -eq 'DOWN') {
                if ($cursor -lt ($items.Count - 1)) { $cursor++ } else { $cursor = 0 }
                continue
            }
            if ($choice -eq 'TOGGLE') {
                $selected[$cursor] = -not $selected[$cursor]
                continue
            }
            if ($choice -match '^[Qq]$') { return }
            if ($choice -match '^[Aa]$') {
                for ($i = 0; $i -lt $items.Count; $i++) { $selected[$i] = $true }
                continue
            }
            if ($choice -match '^[Nn]$') {
                for ($i = 0; $i -lt $items.Count; $i++) { $selected[$i] = $false }
                continue
            }
            if ($choice -match '^[Oo]$') { Open-Folder (Get-OutboxPath); continue }
            if ($choice -match '^\d+$') {
                $number = 0
                if ([int]::TryParse($choice, [ref]$number)) {
                    $idx = $number - 1
                    if ($idx -ge 0 -and $idx -lt $items.Count) {
                        $selected[$idx] = -not $selected[$idx]
                        $cursor = $idx
                    }
                }
                continue
            }
            if ($choice -match '^[Cc]$') {
                $picked = @()
                for ($i = 0; $i -lt $items.Count; $i++) {
                    if ($selected[$i]) { $picked += $items[$i] }
                }
                if ($picked.Count -eq 0) {
                    Write-Host 'Select at least one file.' -ForegroundColor Yellow
                    Start-Sleep -Seconds 1
                    continue
                }
                $total = 0L
                foreach ($item in $picked) { $total += Get-TreeSize $item }
                Clear-Host
                Write-Host 'Confirm send' -ForegroundColor Cyan
                Write-Host ''
                foreach ($item in $picked) {
                    Write-Host ("  {0}  ({1})" -f $item.Name, (Format-ByteSize (Get-TreeSize $item)))
                }
                Write-Host ''
                Write-Host ("{0} item(s), {1}" -f $picked.Count, (Format-ByteSize $total))
                $folders = @($picked | Where-Object { $_.PSIsContainer })
                if ($picked.Count -gt 1 -or $folders.Count -gt 0) {
                    Write-Host 'These will be sent as one zip.'
                }
                $yes = Read-Host 'Send these? [Y/N]'
                if ($yes -match '^[Yy]') { $confirmed = $true }
            }
        }
        $usePin = $true
        $quickTarget = $null
        $sendTotal = 0L
        foreach ($item in $picked) { $sendTotal += Get-TreeSize $item }
        $mine = @(Get-LanIPv4 -IncludeVirtual)
        $quick = @()
        Clear-Host
        Write-Host 'Choose a PC' -ForegroundColor Cyan
        Write-Host ''
        Write-Host ("This send is {0}." -f (Format-ByteSize $sendTotal))
        Write-Host 'Looking for PCs with Quick receive...'
        try {
            $quick = @(Receive-Beacons -Seconds 3 | Where-Object {
                $_.Token -eq 'QUICK' -and $_.Port -gt 0 -and ($mine -notcontains $_.IP)
            })
        } catch { $quick = @() }
        if ($quick.Count -eq 0) {
            Write-Host ''
            Write-Host 'No other PC with Quick receive was found.' -ForegroundColor Yellow
            Write-Host 'If Quick receive is on but discovery is blocked, type that PC''s IP.'
            $fallback = Read-Host '[I] Type IP  [P] Send with PIN  [Q] Back'
            if ($fallback -match '^[Ii]') {
                $manual = Read-QuickReceiveTargetByIp
                if (-not $manual) { continue }
                $usePin = $false
                $quickTarget = $manual
            }
            elseif ($fallback -match '^[PpYy]') {
                $usePin = $true
            }
            else {
                continue
            }
        }
        else {
            $labels = @($quick | ForEach-Object { "{0} ({1})  {2}" -f $_.Display, $_.Windows, $_.IP })
            $labels += 'Type IP for Quick receive'
            $labels += 'Send with a PIN instead'
            $how = Read-ArrowMenu -Title 'Choose a PC' -Lines @(
                ("This send is {0}." -f (Format-ByteSize $sendTotal)),
                'Pick the PC that should receive these files.'
            ) -Items $labels -ZeroLabel 'Back' -Hint 'Arrow keys move. Enter chooses. Type the number to choose that PC. 0 goes back.'
            if ($how -lt 0) { continue }
            if ($how -lt $quick.Count) {
                $usePin = $false
                $quickTarget = $quick[$how]
            }
            elseif ($how -eq $quick.Count) {
                $manual = Read-QuickReceiveTargetByIp
                if (-not $manual) { continue }
                $usePin = $false
                $quickTarget = $manual
            }
        }
        Write-Host ''
        Write-Host 'Preparing the transfer...' -ForegroundColor DarkGray
        $payload = $null
        try {
            Write-TransferDebug 'send.prepare' @{ items = $picked.Count; total = $sendTotal; mode = $(if ($usePin) { 'pin' } else { 'quick' }); target = $(if ($quickTarget) { $quickTarget.Display } else { '-' }) }
            $payload = New-SendPayload $picked
            Write-TransferDebug 'send.payload-ready' @{ file = $payload.Name; path = $payload.Path; size = $payload.Size; temp = [bool]$payload.Temp }
            if (-not $usePin) {
                try {
                    Invoke-QuickUpload -Address $quickTarget.IP -Port $quickTarget.Port -FilePath $payload.Path -DownloadName $payload.Name -TargetName $quickTarget.Display
                } finally {
                    if ($payload.Temp) {
                        Remove-Item -LiteralPath $payload.Temp -Force -ErrorAction SilentlyContinue
                    }
                }
            }
            else {
                [void](Start-ShareServer -FilePath $payload.Path -DownloadName $payload.Name -TempToDelete $payload.Temp)
            }
        } catch {
            Write-TransferDebug 'send.failed' @{ error = $_.Exception.Message }
            Write-Host $_.Exception.Message -ForegroundColor Red
            if ($payload -and $payload.Temp) {
                Remove-Item -LiteralPath $payload.Temp -Force -ErrorAction SilentlyContinue
            }
        }
        Wait-Enter
        return
        }
    }
}

function Receive-Beacons {
    param([int]$Seconds = 4)
    $udp = New-Object System.Net.Sockets.UdpClient
    $found = @{}
    try {
        $udp.Client.SetSocketOption([Net.Sockets.SocketOptionLevel]::Socket, [Net.Sockets.SocketOptionName]::ReuseAddress, $true)
        $udp.Client.Bind((New-Object System.Net.IPEndPoint ([Net.IPAddress]::Any, $script:BeaconPort)))
        $udp.Client.ReceiveTimeout = 400
        $end = (Get-Date).AddSeconds($Seconds)
        while ((Get-Date) -lt $end) {
            try {
                $remote = New-Object System.Net.IPEndPoint ([Net.IPAddress]::Any, 0)
                $bytes = $udp.Receive([ref]$remote)
                $msg = [Text.Encoding]::UTF8.GetString($bytes)
                $parts = $msg.Split('|')
                if ($parts.Length -lt 7) { continue }
                if ($parts[0] -ne $script:BeaconPrefix) { continue }
                $key = '{0}:{1}:{2}' -f $remote.Address.ToString(), $parts[2], $parts[1]
                $found[$key] = @{
                    IP = $remote.Address.ToString()
                    Token = $parts[1]
                    Port = [int]$parts[2]
                    Display = $parts[3]
                    Windows = $parts[4]
                    Size = [long]$parts[5]
                    File = ($parts[6..($parts.Length - 1)] -join '|')
                }
            } catch {}
        }
    } catch {
        Write-Host "Could not listen for other PCs. $($_.Exception.Message)" -ForegroundColor Yellow
        return @()
    } finally {
        try { $udp.Close() } catch {}
    }
    return @($found.Values)
}

function Test-TcpOpen {
    param([string]$Address, [int]$Port, [int]$TimeoutMs = 800)
    $client = New-Object System.Net.Sockets.TcpClient
    try {
        $iar = $client.BeginConnect($Address, $Port, $null, $null)
        if (-not $iar.AsyncWaitHandle.WaitOne($TimeoutMs, $false)) { return $false }
        $client.EndConnect($iar)
        return [bool]$client.Connected
    } catch {
        return $false
    } finally {
        try { $client.Close() } catch {}
    }
}

