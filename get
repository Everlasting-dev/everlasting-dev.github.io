function Get-QuickListenerPid {
    $pidPath = Get-ListenPidPath
    if (-not (Test-Path -LiteralPath $pidPath)) { return 0 }
    $listenPid = 0
    if ([int]::TryParse((Get-Content -LiteralPath $pidPath -Raw -ErrorAction SilentlyContinue).Trim(), [ref]$listenPid)) {
        return $listenPid
    }
    return 0
}

function Get-SlipListenerProcess {
    param([int]$ProcessId, [ValidateSet('listen', 'chatlisten', 'remotehelp')][string]$Entry)
    if ($ProcessId -le 0 -or $ProcessId -eq $PID) { return $null }
    # Windows reuses PIDs; do not stop or trust unrelated processes from stale files.
    $process = Get-CimInstance Win32_Process -Filter "ProcessId = $ProcessId" -ErrorAction SilentlyContinue
    if (-not $process -or $process.Name -ine 'powershell.exe') { return $null }
    $path = [regex]::Escape((Get-InstalledScriptPath))
    if ($process.CommandLine -notmatch ('(?i)-File\s+"' + $path + '"\s+' + $Entry + '(?:\s|$)')) { return $null }
    return $process
}

function Stop-SlipListenerProcess {
    param([int]$ProcessId, [string]$Entry)
    $owned = Get-SlipListenerProcess -ProcessId $ProcessId -Entry $Entry
    if ($owned) {
        Stop-Process -Id $ProcessId -Force -ErrorAction SilentlyContinue
        $parent = Get-CimInstance Win32_Process -Filter "ProcessId = $($owned.ParentProcessId)" -ErrorAction SilentlyContinue
        if ($parent -and $parent.ExecutablePath -ieq (Get-BackgroundLauncherPath)) {
            Wait-Process -Id $parent.ProcessId -Timeout 5 -ErrorAction SilentlyContinue
        }
    }
}

function Test-QuickListenerAlive {
    $listenPid = Get-QuickListenerPid
    if ($listenPid -le 0) { return $false }
    return $null -ne (Get-SlipListenerProcess -ProcessId $listenPid -Entry 'listen')
}

function Get-QuickListenerPorts {
    $ports = @()
    $portPath = Get-ListenPortPath
    if (Test-Path -LiteralPath $portPath) {
        $port = 0
        if ([int]::TryParse((Get-Content -LiteralPath $portPath -Raw -ErrorAction SilentlyContinue).Trim(), [ref]$port)) {
            if ($port -gt 0) { $ports += $port }
        }
    }
    $listenPid = Get-QuickListenerPid
    if ($listenPid -gt 0) {
        try {
            $ports += @(Get-NetTCPConnection -State Listen -OwningProcess $listenPid -ErrorAction Stop |
                Where-Object { $_.LocalPort -ge $script:PortFirst -and $_.LocalPort -le $script:PortLast } |
                Select-Object -ExpandProperty LocalPort)
        } catch { }
    }
    return @($ports | Where-Object { $_ } | Sort-Object -Unique)
}

function Show-QuickReceiveStatus {
    $quickOn = Test-QuickReceive
    if ($quickOn) { Write-Host 'Quick receive: on' -ForegroundColor Green }
    else { Write-Host 'Quick receive: off' -ForegroundColor Yellow }

    $runValue = Get-QuickReceiveRunValue
    if ($quickOn) {
        if ($runValue) {
            Write-Host 'Startup:       registry entry present' -ForegroundColor Green
        } else {
            Write-Host 'Startup:       registry entry missing' -ForegroundColor Yellow
        }
    } else {
        if ($runValue) {
            Write-Host 'Startup:       stale registry entry present' -ForegroundColor Yellow
        } else {
            Write-Host 'Startup:       off'
        }
    }

    $listenPid = Get-QuickListenerPid
    if ($listenPid -le 0) {
        Write-Host 'Listener:      not running' -ForegroundColor Yellow
        return
    }
    if (-not (Test-QuickListenerAlive)) {
        Write-Host ("Listener:      pid {0} is not running" -f $listenPid) -ForegroundColor Yellow
        return
    }

    $ports = @(Get-QuickListenerPorts)
    if ($ports.Count -eq 0) {
        Write-Host ("Listener:      pid {0} alive, port unknown" -f $listenPid) -ForegroundColor Yellow
        return
    }

    $checks = @()
    foreach ($port in $ports) {
        $checks += ("{0} {1}" -f $port, (Format-Check (Test-TcpOpen '127.0.0.1' $port)))
    }
    Write-Host ("Listener:      pid {0}, port {1}" -f $listenPid, ($checks -join ', ')) -ForegroundColor Green
}

function Test-QuickReceive {
