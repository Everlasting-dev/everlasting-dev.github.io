function Write-SlipLog {
    param([string]$Message)
    try {
        $debug = Get-DebugPath
        if (-not (Test-Path -LiteralPath $debug)) {
            New-Item -ItemType Directory -Force -Path $debug | Out-Null
        }
        $line = '{0} {1}' -f (Get-Date -Format 'o'), ($Message -replace '[\r\n]+', ' ')
        Add-Content -LiteralPath (Join-Path $debug "$($script:CommandName).log") -Value $line -Encoding ASCII
