function Get-ProfilePaths {
    $doc = Join-Path $env:USERPROFILE 'Documents'
    $win = Join-Path (Join-Path $doc 'WindowsPowerShell') 'Microsoft.PowerShell_profile.ps1'
    $ps7 = Join-Path (Join-Path $doc 'PowerShell') 'Microsoft.PowerShell_profile.ps1'
    $list = @($win)
    if (Test-Path -LiteralPath $ps7) { $list += $ps7 }
    return @($list | Select-Object -Unique)
}

function Get-SlipFunctionBlock {
    $installedScript = Get-InstalledScriptPath
    $template = @'
# >>> __COMMAND__ >>>
function __COMMAND__ {
    $local = '__INSTALLED_SCRIPT__'
    $cmd = if ($args.Count -gt 0) { [string]$args[0] } else { '' }
    if ($cmd -match '^(?i:upgrade|update|migrate)$') {
        $tmp = Join-Path $env:TEMP '__COMMAND__-upgrade.ps1'
        Remove-Item -LiteralPath $tmp -Force -ErrorAction SilentlyContinue
        try { [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12 } catch { }
        Invoke-RestMethod -Uri '__SOURCE_URL__' -OutFile $tmp -ErrorAction Stop
        $env:SLIP_FETCHED_UPGRADE = '1'
        try {
            & powershell.exe -NoProfile -ExecutionPolicy Bypass -File $tmp upgrade @($args | Select-Object -Skip 1)
            return
        } finally {
            Remove-Item Env:SLIP_FETCHED_UPGRADE -ErrorAction SilentlyContinue
            Remove-Item -LiteralPath $tmp -Force -ErrorAction SilentlyContinue
        }
    }
    if (Test-Path -LiteralPath $local) {
        if ($args.Count -eq 0) {
            & powershell.exe -NoProfile -ExecutionPolicy Bypass -File $local menu
        } else {
            & powershell.exe -NoProfile -ExecutionPolicy Bypass -File $local @args
        }
        return
    }
    $tmp = Join-Path $env:TEMP '__COMMAND__-get.ps1'
    Remove-Item -LiteralPath $tmp -Force -ErrorAction SilentlyContinue
    try { [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12 } catch { }
    Invoke-RestMethod -Uri '__SOURCE_URL__' -OutFile $tmp -ErrorAction Stop
    if (-not (Test-Path -LiteralPath $tmp)) { throw 'Could not download __APP_NAME__.' }
    try {
        if ($args.Count -eq 0) {
            & powershell.exe -NoProfile -ExecutionPolicy Bypass -File $tmp menu
        } else {
            & powershell.exe -NoProfile -ExecutionPolicy Bypass -File $tmp @args
        }
    } finally {
        Remove-Item -LiteralPath $tmp -Force -ErrorAction SilentlyContinue
    }
}
# <<< __COMMAND__ <<<
'@
    $block = $template.Replace('__COMMAND__', $script:CommandName)
    $block = $block.Replace('__INSTALLED_SCRIPT__', ($installedScript -replace "'", "''"))
    $block = $block.Replace('__SOURCE_URL__', ($script:SourceUrl -replace "'", "''"))
    $block = $block.Replace('__APP_NAME__', ($script:AppName -replace "'", "''"))
    return $block
}

function Set-SlipScriptPolicy {
    param([switch]$Quiet)
    $result = @{ Changed = @(); Notes = @(); Locked = $false }
    $safe = @('RemoteSigned', 'Unrestricted', 'Bypass')
    # A Group Policy can pin a policy we cannot override from here. Report it so
    # the user knows the rest has to be done by whoever manages the PC.
    foreach ($gpoScope in @('MachinePolicy', 'UserPolicy')) {
        try {
            $val = Get-ExecutionPolicy -Scope $gpoScope -ErrorAction Stop
            if ($val -and $val -ne 'Undefined' -and $safe -notcontains $val) {
                $result.Locked = $true
                $result.Notes += ("Group Policy ({0}) forces {1}." -f $gpoScope, $val)
            }
        } catch { }
    }
    $scopes = @('CurrentUser')
    if (Test-IsAdmin) { $scopes += 'LocalMachine' }
    foreach ($scope in $scopes) {
        try {
            $cur = Get-ExecutionPolicy -Scope $scope -ErrorAction Stop
            if ($safe -notcontains $cur) {
                Set-ExecutionPolicy -Scope $scope -ExecutionPolicy RemoteSigned -Force -ErrorAction Stop
                $result.Changed += ("{0}: {1} -> RemoteSigned" -f $scope, $cur)
            }
        } catch {
            $result.Notes += ("{0}: {1}" -f $scope, $_.Exception.Message)
        }
    }
    # RemoteSigned still blocks unsigned scripts that carry an internet mark.
    # Slip writes its own files locally, but unblock them so nothing is flagged.
    try {
        $files = @()
        try { $files += (Get-InstalledScriptPath) } catch { }
        try { $files += @(Get-ProfilePaths) } catch { }
        foreach ($p in $files) {
            if ($p -and (Test-Path -LiteralPath $p)) {
                Unblock-File -LiteralPath $p -ErrorAction SilentlyContinue
            }
        }
    } catch { }
    if (-not $Quiet) {
        if ($result.Changed.Count -gt 0) {
            Write-Host 'PowerShell now allows local scripts:' -ForegroundColor Green
            foreach ($c in $result.Changed) { Write-Host ("  {0}" -f $c) }
        } else {
            Write-Host 'PowerShell already allows local scripts. Nothing to change.' -ForegroundColor Green
        }
        if ($result.Locked) {
            Write-Host ''
            Write-Host 'A Group Policy still forces a stricter setting:' -ForegroundColor Yellow
            foreach ($n in $result.Notes) { Write-Host ("  {0}" -f $n) -ForegroundColor Yellow }
            Write-Host 'That part has to be changed by whoever manages this PC.' -ForegroundColor Yellow
        }
    }
    return $result
}

function Set-ProfileBlock {
    $block = (Get-SlipFunctionBlock).Trim() + "`r`n"
    $pattern = "(?s)# >>> $($script:CommandName) >>>.*?# <<< $($script:CommandName) <<<\s*"
    foreach ($path in (Get-ProfilePaths)) {
        $dir = Split-Path -Parent $path
        if (-not (Test-Path -LiteralPath $dir)) {
            New-Item -ItemType Directory -Force -Path $dir | Out-Null
        }
        $existing = ''
        if (Test-Path -LiteralPath $path) {
            $existing = [IO.File]::ReadAllText($path)
        }
        if ($existing -match $pattern) {
            $updated = [regex]::Replace($existing, $pattern, $block)
        } else {
            $prefix = $existing
            if ($prefix -and -not $prefix.EndsWith("`n")) { $prefix += "`r`n" }
            if ($prefix) { $prefix += "`r`n" }
            $updated = $prefix + $block
        }
        [IO.File]::WriteAllText($path, $updated)
        $profileMarker = '$cmd -match ''^(?i:upgrade|update|migrate)$'''
        try {
            $check = [IO.File]::ReadAllText($path)
            if ($check -notlike "*$profileMarker*") {
                [IO.File]::WriteAllText($path, $block)
            }
        } catch { }
    }
    Install-SlipCommand
}

function Get-SlipCommandDir {
    Join-Path $env:LOCALAPPDATA $script:AppName
}
function Get-SlipShimDir {
    Join-Path (Get-SlipCommandDir) 'bin'
}
function Get-InstalledScriptPath {
    # Not named slip.ps1. PowerShell resolves a PATH command to a .ps1 of the
    # same name before slip.cmd, then refuses to run it when scripts are disabled.
    Join-Path (Get-SlipCommandDir) "$($script:CommandName)-host.ps1"
}

function Get-SendToShortcutPath {
    if (-not $env:APPDATA) { return $null }
    return (Join-Path (Join-Path $env:APPDATA 'Microsoft\Windows\SendTo') "$($script:AppName).lnk")
}

function Install-SendToShortcut {
    $path = Get-SendToShortcutPath
    if (-not $path) { return $false }
    try {
        $dir = Split-Path -Parent $path
        if (-not (Test-Path -LiteralPath $dir)) { New-Item -ItemType Directory -Force -Path $dir | Out-Null }
        $powershell = Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'
        $shortcut = (New-Object -ComObject WScript.Shell).CreateShortcut($path)
        $shortcut.TargetPath = $powershell
        $shortcut.Arguments = '-NoProfile -ExecutionPolicy Bypass -File "{0}" sendto' -f (Get-InstalledScriptPath)
        $shortcut.WorkingDirectory = Get-SlipCommandDir
        $shortcut.WindowStyle = 1
        $shortcut.Description = "Send selected files with $($script:AppName)"
        $shortcut.IconLocation = "$env:SystemRoot\System32\shell32.dll,146"
        $shortcut.Save()
        return (Test-Path -LiteralPath $path)
    } catch {
        Write-SlipLog "Send To shortcut failed: $($_.Exception.Message)"
        return $false
    }
}

function Remove-SendToShortcut {
    $path = Get-SendToShortcutPath
    if ($path) { Remove-Item -LiteralPath $path -Force -ErrorAction SilentlyContinue }
}

function Remove-LegacySlipArtifacts {
    $dir = Get-SlipCommandDir
    $current = ''
    if ($PSCommandPath) {
        try { $current = [IO.Path]::GetFullPath($PSCommandPath) } catch { $current = $PSCommandPath }
    }
    $candidates = @(
        (Join-Path $dir "$($script:CommandName).ps1"),
        (Join-Path $dir "$($script:CommandName)-listen.cmd"),
        (Join-Path $env:TEMP "$($script:CommandName)-get.ps1"),
        (Join-Path $env:TEMP "$($script:CommandName)-upgrade.ps1"),
        (Join-Path $env:TEMP "$($script:CommandName)-admin.ps1"),
        (Join-Path $env:TEMP 'slip-get.ps1'),
        (Join-Path $env:TEMP 'slip-upgrade.ps1')
    )
    foreach ($path in @($candidates | Select-Object -Unique)) {
        if (-not (Test-Path -LiteralPath $path)) { continue }
        $full = $path
        try { $full = [IO.Path]::GetFullPath($path) } catch { }
        if ($current -and ($full -ieq $current)) { continue }
        Remove-Item -LiteralPath $path -Force -ErrorAction SilentlyContinue
    }
}

function Update-InstalledSlipScript {
    $target = Get-InstalledScriptPath
    $dir = Split-Path -Parent $target
    if (-not (Test-Path -LiteralPath $dir)) {
        New-Item -ItemType Directory -Force -Path $dir | Out-Null
    }
    if ($PSCommandPath -and (Test-Path -LiteralPath $PSCommandPath)) {
        $sourcePath = [IO.Path]::GetFullPath($PSCommandPath)
        $targetPath = [IO.Path]::GetFullPath($target)
        if ($sourcePath -ieq $targetPath) { return }
        if (Test-Path -LiteralPath $target) {
            try {
                $sourceItem = Get-Item -LiteralPath $sourcePath -ErrorAction Stop
                $targetItem = Get-Item -LiteralPath $targetPath -ErrorAction Stop
                if ($sourceItem.Length -eq $targetItem.Length) {
                    $sourceHash = (Get-FileHash -LiteralPath $sourcePath -Algorithm SHA256 -ErrorAction Stop).Hash
                    $targetHash = (Get-FileHash -LiteralPath $targetPath -Algorithm SHA256 -ErrorAction Stop).Hash
                    if ($sourceHash -eq $targetHash) { return }
                }
            } catch { }
        }
        Copy-Item -LiteralPath $PSCommandPath -Destination $target -Force
        return
    }
    Invoke-RestMethod -Uri $script:SourceUrl -OutFile $target -ErrorAction Stop
}

function Get-BackgroundLauncherPath { Join-Path (Get-SlipCommandDir) 'slip-background-v1.exe' }

function Install-BackgroundLauncher {
    $path = Get-BackgroundLauncherPath
    if (Test-Path -LiteralPath $path) { return }
    New-Item -ItemType Directory -Path (Split-Path -Parent $path) -Force | Out-Null
    # A GUI-subsystem executable never allocates a console, including at logon.
    # Do not shell-expand paths or accept arbitrary commands from startup entries.
    $source = @'
using System;
using System.Diagnostics;
using System.IO;
using System.Threading;
public static class SlipBackground {
    [STAThread]
    public static int Main(string[] args) {
        if (args.Length != 1 || Array.IndexOf(new[] { "listen", "chatlisten", "remotehelp", "updatecheck" }, args[0]) < 0) return 2;
        bool created;
        using (var gate = new Mutex(true, "Local\\Slip.Background." + args[0], out created)) {
            if (!created && !gate.WaitOne(3000)) return 0;
            try {
                string script = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "slip-host.ps1");
                var start = new ProcessStartInfo {
                    FileName = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.System), @"WindowsPowerShell\v1.0\powershell.exe"),
                    Arguments = "-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File \"" + script + "\" " + args[0],
                    UseShellExecute = false,
                    CreateNoWindow = true,
                    WindowStyle = ProcessWindowStyle.Hidden
                };
                using (var child = Process.Start(start)) { child.WaitForExit(); return child.ExitCode; }
            } catch (Exception ex) {
                try { File.AppendAllText(Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "background-errors.log"), DateTime.Now + " " + ex.Message + Environment.NewLine); } catch { }
                return 1;
            } finally { gate.ReleaseMutex(); }
        }
    }
}
'@
    Add-Type -TypeDefinition $source -Language CSharp -OutputAssembly $path -OutputType WindowsApplication -ErrorAction Stop
}

function Get-BackgroundCommandLine {
    param([ValidateSet('listen', 'chatlisten', 'remotehelp', 'updatecheck')][string]$Entry)
    return ('"{0}" {1}' -f (Get-BackgroundLauncherPath), $Entry)
}

function Start-SlipBackground {
    param([ValidateSet('listen', 'chatlisten', 'remotehelp', 'updatecheck')][string]$Entry)
    Install-BackgroundLauncher
    Start-Process -FilePath (Get-BackgroundLauncherPath) -ArgumentList $Entry -WindowStyle Hidden -PassThru -ErrorAction Stop
}

function Install-SlipCommand {
    $dir = Get-SlipCommandDir
    if (-not (Test-Path -LiteralPath $dir)) {
        New-Item -ItemType Directory -Force -Path $dir | Out-Null
    }
    Update-InstalledSlipScript
    Install-BackgroundLauncher
    $installedScript = Get-InstalledScriptPath
    $menuTemplate = @'
@echo off
setlocal
if /I "%~1"=="upgrade" goto slipfetch
if /I "%~1"=="update" goto slipfetch
if /I "%~1"=="migrate" goto slipfetch
if "%~1"=="" (
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "__INSTALLED_SCRIPT__" menu
    exit /b %errorlevel%
)
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "__INSTALLED_SCRIPT__" %*
exit /b %errorlevel%
:slipfetch
echo Downloading the latest Slip...
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "try { [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12 } catch { }; try { Invoke-RestMethod -Uri '__SOURCE_URL__' -OutFile (Join-Path $env:TEMP 'slip-upgrade.ps1') -ErrorAction Stop; exit 0 } catch { Write-Host $_.Exception.Message -ForegroundColor Red; exit 1 }"
if errorlevel 1 exit /b 1
set SLIP_FETCHED_UPGRADE=1
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%TEMP%\slip-upgrade.ps1" %*
set SLIP_ERR=%ERRORLEVEL%
set SLIP_FETCHED_UPGRADE=
del /f /q "%TEMP%\slip-upgrade.ps1" >nul 2>&1
exit /b %SLIP_ERR%
'@
    $menuCmd = $menuTemplate.Replace('__INSTALLED_SCRIPT__', $installedScript).Replace('__SOURCE_URL__', $script:SourceUrl)
    $legacyScript = Join-Path $dir "$($script:CommandName).ps1"
    if ((Test-Path -LiteralPath $legacyScript) -and ($legacyScript -ine $installedScript)) {
        Remove-Item -LiteralPath $legacyScript -Force -ErrorAction SilentlyContinue
    }
    Unblock-File -LiteralPath $installedScript -ErrorAction SilentlyContinue
    $shim = Get-SlipShimDir
    if (-not (Test-Path -LiteralPath $shim)) {
        New-Item -ItemType Directory -Force -Path $shim | Out-Null
    }
    Set-Content -LiteralPath (Join-Path $dir "$($script:CommandName).cmd") -Value $menuCmd -Encoding ASCII
    Set-Content -LiteralPath (Join-Path $shim "$($script:CommandName).cmd") -Value $menuCmd -Encoding ASCII
    Remove-Item -LiteralPath (Join-Path $dir "$($script:CommandName)-listen.cmd") -Force -ErrorAction SilentlyContinue
    $userPath = [Environment]::GetEnvironmentVariable('Path', 'User')
    if (-not $userPath) { $userPath = '' }
    $drop = @($dir.TrimEnd('\').ToLowerInvariant(), $shim.TrimEnd('\').ToLowerInvariant())
    $parts = @($userPath -split ';' | Where-Object { $_ -and ($drop -notcontains $_.Trim().TrimEnd('\').ToLowerInvariant()) })
    $parts += $shim
    $updatedUserPath = $parts -join ';'
    if ($updatedUserPath -cne $userPath) {
        [Environment]::SetEnvironmentVariable('Path', $updatedUserPath, 'User')
        Send-EnvironmentChanged
    }
    if ($env:Path -notlike "*$shim*") { $env:Path = "$shim;$env:Path" }
    $invokeTemplate = @'
function global:__COMMAND__ {
    $cmd = if ($args.Count -gt 0) { [string]$args[0] } else { '' }
    if ($cmd -match '^(?i:upgrade|update|migrate)$') {
        $tmp = Join-Path $env:TEMP 'slip-upgrade.ps1'
        Remove-Item -LiteralPath $tmp -Force -ErrorAction SilentlyContinue
        try { [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12 } catch { }
        Invoke-RestMethod -Uri '__SOURCE_URL__' -OutFile $tmp -ErrorAction Stop
        $env:SLIP_FETCHED_UPGRADE = '1'
        try { & powershell.exe -NoProfile -ExecutionPolicy Bypass -File $tmp upgrade @($args | Select-Object -Skip 1) }
        finally {
            Remove-Item Env:SLIP_FETCHED_UPGRADE -ErrorAction SilentlyContinue
            Remove-Item -LiteralPath $tmp -Force -ErrorAction SilentlyContinue
        }
        return
    }
    if ($args.Count -eq 0) {
        & powershell.exe -NoProfile -ExecutionPolicy Bypass -File '__INSTALLED_SCRIPT__' menu
    } else {
        & powershell.exe -NoProfile -ExecutionPolicy Bypass -File '__INSTALLED_SCRIPT__' @args
    }
}
'@
    $invoke = $invokeTemplate.Replace('__COMMAND__', $script:CommandName).Replace('__SOURCE_URL__', ($script:SourceUrl -replace "'", "''")).Replace('__INSTALLED_SCRIPT__', ($installedScript -replace "'", "''"))
    Invoke-Expression $invoke
    Remove-LegacySlipArtifacts
    [void](Install-SendToShortcut)
}

function Remove-SlipCommand {
    Remove-SendToShortcut
    $dir = Get-SlipCommandDir
    $shim = Get-SlipShimDir
    foreach ($name in @('slip-background-v1.exe', 'background-errors.log', "$($script:CommandName).cmd", "$($script:CommandName)-listen.cmd", "$($script:CommandName).ps1", "$($script:CommandName)-host.ps1")) {
        $path = Join-Path $dir $name
        if (Test-Path -LiteralPath $path) { Remove-Item -LiteralPath $path -Force -ErrorAction SilentlyContinue }
    }
    $shimCmd = Join-Path $shim "$($script:CommandName).cmd"
    if (Test-Path -LiteralPath $shimCmd) { Remove-Item -LiteralPath $shimCmd -Force -ErrorAction SilentlyContinue }
    $userPath = [Environment]::GetEnvironmentVariable('Path', 'User')
    if ($userPath) {
        $drop = @($dir.TrimEnd('\').ToLowerInvariant(), $shim.TrimEnd('\').ToLowerInvariant())
        $parts = @($userPath -split ';' | Where-Object { $_ -and ($drop -notcontains $_.Trim().TrimEnd('\').ToLowerInvariant()) })
        [Environment]::SetEnvironmentVariable('Path', ($parts -join ';'), 'User')
        Send-EnvironmentChanged
    }
    Remove-Item -Path "Function:global:$($script:CommandName)" -ErrorAction SilentlyContinue
}

function Remove-ProfileBlock {
    $pattern = "(?s)# >>> $($script:CommandName) >>>.*?# <<< $($script:CommandName) <<<\s*"
    foreach ($path in (Get-ProfilePaths)) {
        if (-not (Test-Path -LiteralPath $path)) { continue }
        $existing = [IO.File]::ReadAllText($path)
        if ($existing -notmatch $pattern) { continue }
        $updated = [regex]::Replace($existing, $pattern, '')
        [IO.File]::WriteAllText($path, $updated)
    }
}

function Test-FirewallRule {
    param([string]$Name)
    try {
        $rules = @(Get-NetFirewallRule -DisplayName $Name -ErrorAction Stop | Where-Object { $_.DisplayName -eq $Name })
        return ($rules.Count -gt 0)
    } catch {
        return $false
    }
}

function Install-FirewallRules {
    if (-not (Test-FirewallRule $script:RuleTcp)) {
        New-NetFirewallRule -DisplayName $script:RuleTcp -Direction Inbound -Action Allow -Protocol TCP -LocalPort "$($script:PortFirst)-$($script:PortLast)" -Profile Private | Out-Null
    }
    if (-not (Test-FirewallRule $script:RuleUdp)) {
        New-NetFirewallRule -DisplayName $script:RuleUdp -Direction Inbound -Action Allow -Protocol UDP -LocalPort $script:BeaconPort -Profile Private | Out-Null
    }
}

function Uninstall-FirewallRules {
    foreach ($name in @($script:RuleTcp, $script:RuleUdp)) {
        if (Test-FirewallRule $name) {
            Remove-NetFirewallRule -DisplayName $name -ErrorAction SilentlyContinue
        }
    }
}

function Invoke-ElevatedEntry {
    param([string]$Entry)
    if ($PSCommandPath) {
        $argList = "-NoProfile -ExecutionPolicy Bypass -File `"$PSCommandPath`" $Entry"
    } else {
        $cmd = "`$tmp=Join-Path `$env:TEMP '$($script:CommandName)-admin.ps1'; Remove-Item -LiteralPath `$tmp -Force -ErrorAction SilentlyContinue; try { [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12 } catch { }; Invoke-RestMethod -Uri '$($script:SourceUrl)' -OutFile `$tmp -ErrorAction Stop; & `$tmp $Entry; exit `$LASTEXITCODE"
        $argList = "-NoProfile -ExecutionPolicy Bypass -Command `"$cmd`""
    }
    try {
        $proc = Start-Process -FilePath powershell.exe -Verb RunAs -Wait -PassThru -ArgumentList $argList
        if ($proc -and $null -ne $proc.ExitCode) { return [int]$proc.ExitCode }
        return 1
    } catch {
        return 1
    }
}

function Ensure-SlipFiles {
    param([string]$DisplayName)
    foreach ($dir in @((Get-SlipRoot), (Get-OutboxPath), (Get-InboxPath), (Get-DebugPath))) {
        if (-not (Test-Path -LiteralPath $dir)) {
            New-Item -ItemType Directory -Force -Path $dir | Out-Null
        }
    }
    Set-Content -LiteralPath (Get-HowToPath) -Value (Get-HowToText) -Encoding ASCII
    if ($DisplayName) {
        Set-Content -LiteralPath (Get-NamePath) -Value $DisplayName.Trim() -Encoding ASCII
    } elseif (-not (Test-Path -LiteralPath (Get-NamePath))) {
        Set-Content -LiteralPath (Get-NamePath) -Value $env:COMPUTERNAME -Encoding ASCII
    }
    Set-ProfileBlock
}

function Complete-SlipSetup {
    param([string]$DisplayName, [switch]$Quiet, [switch]$NoPrompt, [switch]$MakeNetworkPrivate)
    Ensure-SlipFiles -DisplayName $DisplayName
    $ready = (Test-FirewallRule $script:RuleTcp) -and (Test-FirewallRule $script:RuleUdp)
    if (-not $ready) {
        if (Test-IsAdmin) {
            Install-FirewallRules
        } else {
            if (-not $Quiet) {
                Write-Host 'Windows needs approval to allow this app on private networks.' -ForegroundColor Yellow
            }
            $code = Invoke-ElevatedEntry -Entry 'firewall'
            if ($code -ne 0) {
                if (-not $Quiet) {
                    Write-Host 'Firewall rules were not added. Setup is not finished.' -ForegroundColor Red
                }
                return $false
            }
        }
    }
    $ready = (Test-FirewallRule $script:RuleTcp) -and (Test-FirewallRule $script:RuleUdp)
    if (-not $ready) {
        if (-not $Quiet) {
            Write-Host 'Firewall rules are still missing. Setup is not finished.' -ForegroundColor Red
        }
        return $false
    }
    # The rules exist, but a rule scoped to Private does nothing on an interface
    # Windows has tagged Public, so setup is not really finished until that is
    # sorted. An unattended run only logs it; it must not stop for a prompt.
    if (@(Get-PublicNetworkProfiles).Count -gt 0) {
        if ($MakeNetworkPrivate) {
            [void](Invoke-MakeNetworkPrivate -Quiet:$Quiet -NoPrompt)
        } elseif ($NoPrompt -or $Quiet) {
            # An unattended run must never stop on a Read-Host, so it only says so.
            Write-SlipLog 'Setup finished but the active network is Public, so nothing can reach this PC.'
            if (-not $Quiet) { Show-NetworkWarning }
        } else {
            [void](Invoke-MakeNetworkPrivate)
        }
    }
    Set-Content -LiteralPath (Get-InstalledPath) -Value (Get-Date -Format 'o') -Encoding ASCII
    return $true
}

function ConvertTo-CleanDisplayName {
    param([string]$Name, [string]$Fallback)
    if ([string]::IsNullOrWhiteSpace($Name)) { return $Fallback }
    $clean = ($Name -replace '[|\r\n]', ' ').Trim()
    if ($clean.Length -gt 40) { $clean = $clean.Substring(0, 40).Trim() }
    if (-not $clean) { return $Fallback }
    return $clean
}

function Invoke-UnattendedInstall {
    param([string]$DisplayName, [switch]$QuickReceive, [switch]$Quiet, [switch]$MakeNetworkPrivate)
    $name = ConvertTo-CleanDisplayName -Name $DisplayName -Fallback $env:COMPUTERNAME
    if (-not $Quiet) {
        Write-Host "Installing $($script:AppName)..." -ForegroundColor Cyan
    }
    $ok = Complete-SlipSetup -DisplayName $name -Quiet:$Quiet -NoPrompt -MakeNetworkPrivate:$MakeNetworkPrivate
    if ($ok) {
        Enable-AutoChat -Quiet:$Quiet
        if ($QuickReceive) {
            Enable-QuickReceive -Quiet:$Quiet
        }
        Write-SlipLog "Install completed. quickReceive=$([bool]$QuickReceive)."
        if (-not $Quiet) {
            Write-Host "$($script:AppName) is ready." -ForegroundColor Green
            Write-Host ("Shown as: {0}" -f (Get-DisplayName))
            Write-Host "Command: $($script:CommandName)"
            Write-Host ("Outbox:  {0}" -f (Get-OutboxPath))
            Write-Host ("Inbox:   {0}" -f (Get-InboxPath))
            if ($QuickReceive) {
                Write-Host 'Quick receive: on'
            }
            Write-Host 'Auto chat: on'
        }
        return $true
    }
    if (-not $Quiet) {
        Write-Host "$($script:AppName) was not installed." -ForegroundColor Red
    }
    return $false
}

function Get-SlipMenuParentProcessId {
    try {
        $current = Get-CimInstance Win32_Process -Filter ("ProcessId = {0}" -f $PID) -ErrorAction Stop
        $parentProcessId = [int]$current.ParentProcessId
        if ($parentProcessId -le 0) { return 0 }
        $parent = Get-CimInstance Win32_Process -Filter ("ProcessId = {0}" -f $parentProcessId) -ErrorAction Stop
        $commandLine = [string]$parent.CommandLine
        $installedPath = [IO.Path]::GetFullPath((Get-InstalledScriptPath))
        $menuPattern = '(?i)-File\s+"?{0}"?\s+menu(?:\s|$)' -f [regex]::Escape($installedPath)
        if ([string]$parent.Name -notmatch '(?i)^powershell(\.exe)?$') { return 0 }
        if ($commandLine -notmatch $menuPattern) { return 0 }
        return $parentProcessId
    } catch {
        return 0
    }
}

function Start-SlipMenuReplacement {
    param([int]$ParentProcessId, [int]$WaitProcessId)
    if ($ParentProcessId -le 0 -or $WaitProcessId -le 0) { return $false }
    $scriptPath = Get-InstalledScriptPath
    if (-not (Test-Path -LiteralPath $scriptPath)) { return $false }
    $arguments = '-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "{0}" restartmenu -ParentProcessId {1} -WaitProcessId {2}' -f $scriptPath, $ParentProcessId, $WaitProcessId
    Start-Process -FilePath powershell.exe -ArgumentList $arguments -WindowStyle Hidden | Out-Null
    return $true
}

function Invoke-SlipMenuReplacement {
    param([int]$ParentProcessId, [int]$WaitProcessId)
    if ($WaitProcessId -gt 0 -and $WaitProcessId -ne $PID) {
        Wait-Process -Id $WaitProcessId -Timeout 60 -ErrorAction SilentlyContinue
    }
    Start-Sleep -Milliseconds 250
    if ($ParentProcessId -gt 0 -and $ParentProcessId -ne $PID) {
        Stop-Process -Id $ParentProcessId -Force -ErrorAction SilentlyContinue
        Wait-Process -Id $ParentProcessId -Timeout 5 -ErrorAction SilentlyContinue
    }
    $scriptPath = Get-InstalledScriptPath
    if (-not (Test-Path -LiteralPath $scriptPath)) { return $false }
    $arguments = '-NoProfile -ExecutionPolicy Bypass -File "{0}" menu' -f $scriptPath
    Start-Process -FilePath powershell.exe -ArgumentList $arguments -WindowStyle Normal | Out-Null
    return $true
}

function Invoke-UnattendedUpgrade {
    param([string]$DisplayName, [switch]$QuickReceive, [switch]$Quiet, [switch]$MakeNetworkPrivate)
    $menuParentProcessId = Get-SlipMenuParentProcessId
    $name = $null
    if (-not [string]::IsNullOrWhiteSpace($DisplayName)) {
        $name = ConvertTo-CleanDisplayName -Name $DisplayName -Fallback $env:COMPUTERNAME
    }
    if (-not $Quiet) {
        Write-Host "Updating $($script:AppName)..." -ForegroundColor Cyan
    }
    Write-SlipLog "Upgrade applying fetched payload. version=$($script:Version) source=$($script:SourceUrl)."
    $quickShouldRun = $QuickReceive -or (Test-QuickReceive)
    $chatShouldRun = Test-AutoChat
    $remoteHelpShouldRun = Test-RemoteHelp
    Stop-QuickReceive
    Stop-AutoChat
    Stop-RemoteHelp -KeepSetting
    $ok = Complete-SlipSetup -DisplayName $name -Quiet:$Quiet -NoPrompt -MakeNetworkPrivate:$MakeNetworkPrivate
    if ($chatShouldRun) { Enable-AutoChat -Quiet:$Quiet }
    if ($quickShouldRun) {
        Enable-QuickReceive -Quiet:$Quiet
    } else {
        Remove-QuickReceiveTask
        Remove-QuickReceiveRunKey
    }
    if ($remoteHelpShouldRun) { Enable-RemoteHelp -Quiet }
    if ((Get-UpdateReminderState).Enabled) { [void](Register-UpdateReminderTask) }
    Write-SlipLog "Upgrade completed. version=$($script:Version) setupOk=$([bool]$ok) quickReceive=$([bool]$quickShouldRun) autoChat=$chatShouldRun remoteHelp=$([bool]$remoteHelpShouldRun)."
    if ($menuParentProcessId -gt 0) {
        if (Start-SlipMenuReplacement -ParentProcessId $menuParentProcessId -WaitProcessId $PID) {
            Write-SlipLog "Upgrade scheduled menu replacement. parentPid=$menuParentProcessId helperWaitPid=$PID."
        }
    }
    if (-not $Quiet) {
        Write-Host "$($script:AppName) $($script:Version) is installed." -ForegroundColor Green
        Write-Host ("Shown as: {0}" -f (Get-DisplayName))
        Write-Host "Command: $($script:CommandName)"
        if ($chatShouldRun) { Write-Host 'Auto chat: on' } else { Write-Host 'Auto chat: off' }
        if ($quickShouldRun) { Write-Host 'Quick receive: on' } else { Write-Host 'Quick receive: off' }
        Write-Host "Type $($script:CommandName) again in this window."
        if (-not $ok) {
            Write-Host 'The new Slip is in place. The firewall prompt still needs a Yes before other PCs can connect.' -ForegroundColor Yellow
        }
    }
    return $true
}

function Read-CleanName {
    param([string]$Fallback)
    $entered = Read-Host "Display name (Enter keeps $Fallback)"
    return (ConvertTo-CleanDisplayName -Name $entered -Fallback $Fallback)
}

function Show-NetworkWarning {
    $public = @(Get-PublicNetworkProfiles)
    if ($public.Count -eq 0) { return }
    foreach ($item in $public) {
        Write-Host ("This network ({0}) is {1}. The {2} rules only apply to Private" -f $item.Name, $item.NetworkCategory, $script:AppName) -ForegroundColor Yellow
        Write-Host 'networks, so other PCs cannot reach this one yet.' -ForegroundColor Yellow
    }
        Write-Host 'Settings > Network lets you mark a trusted network Private.' -ForegroundColor Yellow
}

function Invoke-MakeNetworkPrivate {
    param([switch]$Quiet, [switch]$NoPrompt)
    $public = @(Get-PublicNetworkProfiles)
    if ($public.Count -eq 0) {
        if (-not $Quiet) {
            if (@(Get-ActiveNetworkProfiles).Count -eq 0) {
                Write-Host 'This PC is not on a network right now.' -ForegroundColor Yellow
            } else {
                Write-Host 'This network is already Private. Nothing to change.' -ForegroundColor Green
            }
        }
        return $true
    }
    if (-not $Quiet) {
        Write-Host ''
        foreach ($item in $public) {
            Write-Host ("Network: {0} ({1}) is {2}." -f $item.Name, $item.InterfaceAlias, $item.NetworkCategory) -ForegroundColor Yellow
        }
        Write-Host ''
        Write-Host "$($script:AppName) only opens its ports on Private networks, so nothing can"
        Write-Host 'reach this PC while the network is marked Public.'
        Write-Host ''
        Write-Host 'Marking it Private also turns on normal Windows network discovery' -ForegroundColor DarkGray
        Write-Host 'for this network. Only do it on a network you trust, such as home' -ForegroundColor DarkGray
        Write-Host 'or the office, not on cafe or hotel wifi.' -ForegroundColor DarkGray
        Write-Host ''
    }
    if (-not $NoPrompt) {
        $answer = Read-Host '[Y] Mark Private  [N] Leave it'
        if ($answer -notmatch '^[Yy]') { return $false }
    }
    if (Test-IsAdmin) {
        [void](Set-ActiveNetworksPrivate)
    } else {
        if (-not $Quiet) { Write-Host 'Windows needs approval to change the network type.' -ForegroundColor Yellow }
        [void](Invoke-ElevatedEntry -Entry 'netprivate')
    }
    if (@(Get-PublicNetworkProfiles).Count -eq 0) {
        if (-not $Quiet) { Write-Host 'This network is Private now. Other PCs can reach this one.' -ForegroundColor Green }
        return $true
    }
    if (-not $Quiet) {
        Write-Host 'The network is still Public.' -ForegroundColor Red
        Write-Host 'Settings > Network and internet > your network > Network profile type > Private' -ForegroundColor DarkGray
    }
    return $false
}

function Invoke-GetSlipFromLauncher {
    $installed = Test-SlipInstalled
    Clear-Host
    Write-Host "Get $($script:AppName)" -ForegroundColor Cyan
    Write-Host ''
    Write-Host "Windows name: $env:COMPUTERNAME"
    Write-Host ("Shown to other PCs as: " + (Get-DisplayName))
    Write-Host ''
    if (-not $installed) {
        Write-Host "$($script:AppName) is not on this PC yet." -ForegroundColor Yellow
        Write-Host ''
        Write-Host "Install will allow $($script:AppName) on private networks, create"
        Write-Host "Documents\$($script:AppName)\Outbox and Inbox, save the how-to,"
        Write-Host "and add the command: $($script:CommandName)"
        Write-Host ''
        Write-Host 'Nothing of yours is deleted.'
        Write-Host ''
        $name = Read-CleanName -Fallback $env:COMPUTERNAME
        $answer = Read-Host '[Y] Install  [N] Back'
        if ($answer -notmatch '^[Yy]') { return }
        Write-Host ''
        if (Complete-SlipSetup -DisplayName $name) {
            Write-Host ''
            Write-Host "$($script:AppName) is installed." -ForegroundColor Green
            Write-Host "Type $($script:CommandName) in this window." -ForegroundColor Green
            Write-Host 'New Command Prompt and PowerShell windows can type it too.' -ForegroundColor Green
            Write-Host 'A window that was already open before install needs to be closed and opened once.' -ForegroundColor DarkGray
            Write-Host 'Send files is the first choice. Auto chat is on.' -ForegroundColor Green
            Enable-AutoChat -Quiet
            Show-NetworkWarning
            Write-Host ''
            Write-Host (Get-HowToText)
            Wait-Enter
            Show-SlipMenu -CanReturn
        } else {
            Wait-Enter
        }
        return
    }

    Show-SlipMenu -CanReturn
}

function Show-RepairScreen {
    Clear-Host
    Write-Host 'Repair' -ForegroundColor Cyan
    Write-Host ''
    Write-Host "Windows name: $env:COMPUTERNAME"
    Write-Host ("Shown to other PCs as: " + (Get-DisplayName))
    Write-Host ''
    Write-Host 'Repair puts the firewall rules and the command back,'
    Write-Host 'recreates missing folders, and refreshes startup.'
    Write-Host ''
    Write-Host 'Repair will not delete files in Outbox or Inbox.' -ForegroundColor Green
    Write-Host ''
    $answer = Read-Host '[Y] Repair  [N] Back'
    if ($answer -notmatch '^[Yy]') { return }
    Write-Host ''
    if (Complete-SlipSetup -DisplayName $null) {
        if (Test-QuickReceive) {
            Enable-QuickReceive -Quiet
            Write-Host 'Quick receive startup refreshed.' -ForegroundColor Green
        } else {
            Remove-QuickReceiveTask
            Remove-QuickReceiveRunKey
        }
        if (Test-AutoChat) {
            Enable-AutoChat -Quiet
            Write-Host 'Auto chat startup refreshed.' -ForegroundColor Green
        } else {
            Stop-AutoChat
        }
        if (Test-RemoteHelp) {
            Enable-RemoteHelp -Quiet
            Write-Host 'Remote help startup refreshed.' -ForegroundColor Green
        }
        if ((Get-UpdateReminderState).Enabled) {
            if (Register-UpdateReminderTask) { Write-Host 'Update reminder refreshed.' -ForegroundColor Green }
            else { Write-Host 'Update reminder could not be refreshed.' -ForegroundColor Yellow }
        }
        Write-Host 'Repair finished. Your Outbox and Inbox files are still there.' -ForegroundColor Green
        Write-Host "Type $($script:CommandName) in this window. It runs even when Windows is set to block scripts." -ForegroundColor Green
    }
    Wait-Enter
}

function Invoke-RemoveSlip {
