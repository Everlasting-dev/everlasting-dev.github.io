# Slip — launcher (Get Octane / Get Slip) and LAN file transfer.
# Published as https://everlasting-dev.github.io/get
# Rename the app in $script:AppName. The command, folders, and firewall rules follow it.
$script:AppName = 'Slip'
$script:CommandName = $script:AppName.ToLowerInvariant()
$script:SourceUrl = 'https://everlasting-dev.github.io/get'
$script:BeaconPort = 47654
$script:PortFirst = 8787
$script:PortLast = 8796
$script:RawArgs = @($args)

$script:RuleTcp = "$($script:AppName) TCP"
$script:RuleUdp = "$($script:AppName) Discovery"
$script:BeaconPrefix = $script:AppName.ToUpperInvariant() + '1'

function Get-SlipRoot {
    Join-Path (Join-Path $env:USERPROFILE 'Documents') $script:AppName
}
function Get-OutboxPath { Join-Path (Get-SlipRoot) 'Outbox' }
function Get-InboxPath { Join-Path (Get-SlipRoot) 'Inbox' }
function Get-HowToPath { Join-Path (Get-SlipRoot) 'HOWTO.txt' }
function Get-NamePath { Join-Path (Get-SlipRoot) 'name.txt' }
function Get-InstalledPath { Join-Path (Get-SlipRoot) 'installed.txt' }

function Test-SlipInstalled {
    Test-Path -LiteralPath (Get-InstalledPath)
}

function Test-IsAdmin {
    $id = [Security.Principal.WindowsIdentity]::GetCurrent()
    $principal = New-Object Security.Principal.WindowsPrincipal($id)
    return $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
}

function Format-ByteSize {
    param([long]$Bytes)
    if ($Bytes -ge 1GB) { return ('{0:N1} GB' -f ($Bytes / 1GB)) }
    if ($Bytes -ge 1MB) { return ('{0:N1} MB' -f ($Bytes / 1MB)) }
    if ($Bytes -ge 1KB) { return ('{0:N1} KB' -f ($Bytes / 1KB)) }
    return "$Bytes B"
}

function Get-ShortText {
    param([string]$Text, [int]$Max = 42)
    if ([string]::IsNullOrEmpty($Text)) { return '' }
    if ($Text.Length -le $Max) { return $Text }
    return $Text.Substring(0, $Max - 3) + '...'
}

function Wait-Enter {
    Write-Host ''
    Write-Host 'Press Enter to continue.' -ForegroundColor DarkGray
    [void](Read-Host)
}

function Get-LanIPv4 {
    $ips = @()
    try {
        $ips = @(Get-NetIPAddress -AddressFamily IPv4 -ErrorAction Stop |
            Where-Object {
                $_.IPAddress -notlike '127.*' -and
                $_.IPAddress -notlike '169.254.*' -and
                $_.PrefixOrigin -ne 'WellKnown'
            } |
            Select-Object -ExpandProperty IPAddress)
    } catch {
        $ips = @()
    }
    if ($ips.Count -eq 0) {
        try {
            $ips = @([Net.Dns]::GetHostAddresses([Net.Dns]::GetHostName()) |
                Where-Object {
                    $_.AddressFamily -eq 'InterNetwork' -and
                    $_.ToString() -notlike '127.*' -and
                    $_.ToString() -notlike '169.254.*'
                } |
                ForEach-Object { $_.ToString() })
        } catch {
            $ips = @()
        }
    }
    return $ips
}

function Get-DisplayName {
    $path = Get-NamePath
    if (Test-Path -LiteralPath $path) {
        $name = Get-Content -LiteralPath $path -Raw -ErrorAction SilentlyContinue
        if ($name) { $name = $name.Trim() }
        if ($name) { return $name }
    }
    return $env:COMPUTERNAME
}

function ConvertTo-BeaconField {
    param([string]$Text)
    if (-not $Text) { return '' }
    return (($Text -replace '[|\r\n]', ' ').Trim())
}

