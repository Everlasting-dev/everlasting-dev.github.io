function Write-OctaneLicense {
    param($License)
    if (-not $License) { return }
    $exp = [DateTime]::Parse([string]$License.expires_at).ToLocalTime()
    $first = [DateTime]::Parse([string]$License.first_login_at).ToLocalTime()
    Write-Host ''
    Write-Host ("Account:       {0}" -f $License.email)
    Write-Host ("First sign-in: {0}" -f $first.ToString('yyyy-MM-dd HH:mm'))
    if ($License.is_owner) {
        Write-Host 'License:       Owner (never expires)' -ForegroundColor Green
        return
    }
    $left = $exp - (Get-Date)
    if ($left.TotalSeconds -gt 0) {
        Write-Host ("License:       active until {0} ({1} days left)" -f $exp.ToString('yyyy-MM-dd HH:mm'), [math]::Floor($left.TotalDays)) -ForegroundColor Green
    } else {
        Write-Host ("License:       EXPIRED on {0}. Ask the owner to renew." -f $exp.ToString('yyyy-MM-dd HH:mm')) -ForegroundColor Red
    }
}

function Invoke-OctaneStorage {
