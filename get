        (ConvertTo-BeaconField (Get-DisplayName)),
        (ConvertTo-BeaconField $env:COMPUTERNAME),
        $Size,
        (ConvertTo-BeaconField $FileName)
    ) -join '|'
    return (Send-BeaconPayload -Payload $msg -Port $script:BeaconPort)
}

function Start-ShareServer {
    param(
        [string]$FilePath,
        [string]$DownloadName,
        [string]$TempToDelete,
        [string]$ReadyFile,
        [switch]$Quiet
    )
    $listener = $null
    $port = 0
    foreach ($candidate in $script:PortFirst..$script:PortLast) {
        $tryListen = $null
        try {
            $tryListen = New-Object System.Net.Sockets.TcpListener ([Net.IPAddress]::Any, $candidate)
            $tryListen.Start()
            $listener = $tryListen
            $port = $candidate
            break
        } catch {
            if ($tryListen) { try { $tryListen.Stop() } catch {} }
        }
    }
    if (-not $listener) { throw "No free port between $($script:PortFirst) and $($script:PortLast)." }

    $token = ([guid]::NewGuid().ToString('N')).Substring(0, 16)
    $pin = (Get-Random -Minimum 0 -Maximum 1000000).ToString('000000')
    $size = [long](Get-Item -LiteralPath $FilePath).Length
    Write-TransferDebug 'send.pin.ready' @{ file = $DownloadName; size = $size; port = $port; quiet = [bool]$Quiet }
    $done = $false
    try {
        if ($ReadyFile) {
            Set-Content -LiteralPath $ReadyFile -Value "$port $pin $token" -Encoding ASCII
        }
        if ($Quiet) {
            [Console]::Out.WriteLine("READY $port $pin $token")
            [Console]::Out.Flush()
        } else {
            Write-Host ''
            Write-Host ("Other PCs see you as: {0} ({1})" -f (Get-DisplayName), $env:COMPUTERNAME)
            Write-Host ("File: {0}  ({1})" -f $DownloadName, (Format-ByteSize $size))
            Write-Host ''
            Write-Host "PIN  $pin" -ForegroundColor Yellow
            $shown = @(Get-LanIPv4)
            if ($shown.Count -eq 0) { $shown = @('127.0.0.1') }
            foreach ($ip in $shown) {
                Write-Host "URL  http://${ip}:$port/" -ForegroundColor Yellow
            }
            Write-Host ''
            Write-Host 'Leave this window open. Waiting up to 15 minutes for one download.'
            Write-Host 'Press Q to cancel.' -ForegroundColor DarkGray
        }
        $deadline = (Get-Date).AddMinutes(15)
        $lastBeacon = [datetime]::MinValue
        while (-not $done -and (Get-Date) -lt $deadline) {
            if (((Get-Date) - $lastBeacon).TotalSeconds -ge 1) {
                try { [void](Send-Beacon $token $port $size $DownloadName) } catch {}
                $lastBeacon = Get-Date
            }
            if (-not $Quiet) {
                try {
                    if (-not [Console]::IsInputRedirected -and [Console]::KeyAvailable) {
                        $key = [Console]::ReadKey($true)
                        if ($key.Key -eq 'Q' -or $key.Key -eq 'Escape') { break }
                    }
                } catch {}
            }
            if (-not $listener.Pending()) {
                Start-Sleep -Milliseconds 200
                continue
            }
            $client = $listener.AcceptTcpClient()
            try {
                $ok = Handle-HttpClient -Client $client -Token $token -Pin $pin -FilePath $FilePath -DownloadName $DownloadName -Quiet:$Quiet
                if ($ok) { $done = $true }
            } catch {
                Write-TransferDebug 'send.pin.failed' @{ file = $DownloadName; error = $_.Exception.Message }
            } finally {
                try { $client.Close() } catch {}
            }
        }
        if ($done) {
            Write-TransferDebug 'send.pin.finished' @{ file = $DownloadName; size = $size; port = $port }
        } else {
            Write-TransferDebug 'send.pin.stopped' @{ file = $DownloadName; size = $size; port = $port }
        }
        if (-not $Quiet) {
            Write-Host ''
            if ($done) { Write-Host 'Download finished. The other PC has the file.' -ForegroundColor Green }
            else { Write-Host 'Stopped before a download finished.' -ForegroundColor Yellow }
        }
    } finally {
        try { $listener.Stop() } catch {}
        if ($TempToDelete) {
            Remove-Item -LiteralPath $TempToDelete -Force -ErrorAction SilentlyContinue
        }
    }
    return $done
}

function Show-SendFiles {
    while ($true) {
        $items = @(Get-OutboxItems)
        Clear-Host
        Write-Host 'Send files' -ForegroundColor Cyan
        Write-Host ''
        Write-Host (Get-SendStepsText)
        Write-Host ''
        if ($items.Count -eq 0) {
            Write-Host 'The Outbox is empty.' -ForegroundColor Yellow
            Write-Host ("Put files in {0}" -f (Get-OutboxPath))
            Write-Host ''
            $open = Read-Host '[O] Open Outbox  [R] Refresh  [Q] Back'
            if ($open -match '^[Oo]') {
                Open-Folder (Get-OutboxPath)
                Write-Host ''
                Write-Host 'Add files to Outbox, then press Enter to refresh.' -ForegroundColor DarkGray
                [void](Read-Host)
                continue
            }
            if ([string]::IsNullOrWhiteSpace($open) -or $open -match '^[Rr]') { continue }
            return
        }
        $selected = @{}
        for ($i = 0; $i -lt $items.Count; $i++) { $selected[$i] = $true }
        $cursor = 0
        $picked = @()
        # Step loop: file selection, then choosing a PC. Backing out of the PC
        # search returns here to the file list instead of the main menu.
        while ($true) {
        $confirmed = $false
        while (-not $confirmed) {
            Clear-Host
            Write-Host 'Send files' -ForegroundColor Cyan
            Write-Host ''
            Write-Host (Get-SendStepsText)
            Write-Host ''
            Write-Host ("  {0,-6} {1,-6} {2,-42} {3}" -f '#', 'Send', 'Name', 'Size')
            for ($i = 0; $i -lt $items.Count; $i++) {
                $mark = if ($selected[$i]) { '[x]' } else { '[ ]' }
                $line = "[{0}]  {1,-6} {2,-42} {3}" -f ($i + 1), $mark, (Get-ShortText $items[$i].Name), (Format-ByteSize (Get-TreeSize $items[$i]))
                if ($i -eq $cursor -and (Test-SlipConsoleKeys)) {
                    Write-Host ("  > " + $line) -ForegroundColor Green
                }
                else {
                    Write-Host ("    " + $line)
                }
            }
            Write-Host ''
            Write-Host 'Arrow keys move. Space toggles. Type a number to toggle that file.'
            Write-Host 'A all, N none, O open folder, C or Enter continue, Q back.'
            $choice = Read-PickerAction
            if ([string]::IsNullOrWhiteSpace($choice) -and [Console]::IsInputRedirected) { return }
            if ($choice -eq 'UP') {
                if ($cursor -gt 0) { $cursor-- } else { $cursor = $items.Count - 1 }
                continue
            }
            if ($choice -eq 'DOWN') {
                if ($cursor -lt ($items.Count - 1)) { $cursor++ } else { $cursor = 0 }
                continue
            }
            if ($choice -eq 'TOGGLE') {
                $selected[$cursor] = -not $selected[$cursor]
                continue
            }
            if ($choice -match '^[Qq]$') { return }
            if ($choice -match '^[Aa]$') {
                for ($i = 0; $i -lt $items.Count; $i++) { $selected[$i] = $true }
                continue
            }
            if ($choice -match '^[Nn]$') {
                for ($i = 0; $i -lt $items.Count; $i++) { $selected[$i] = $false }
                continue
            }
            if ($choice -match '^[Oo]$') { Open-Folder (Get-OutboxPath); continue }
            if ($choice -match '^\d+$') {
                $number = 0
                if ([int]::TryParse($choice, [ref]$number)) {
                    $idx = $number - 1
                    if ($idx -ge 0 -and $idx -lt $items.Count) {
                        $selected[$idx] = -not $selected[$idx]
                        $cursor = $idx
                    }
                }
                continue
            }
            if ($choice -match '^[Cc]$') {
                $picked = @()
                for ($i = 0; $i -lt $items.Count; $i++) {
                    if ($selected[$i]) { $picked += $items[$i] }
                }
                if ($picked.Count -eq 0) {
                    Write-Host 'Select at least one file.' -ForegroundColor Yellow
                    Start-Sleep -Seconds 1
                    continue
                }
                $total = 0L
                foreach ($item in $picked) { $total += Get-TreeSize $item }
                Clear-Host
                Write-Host 'Confirm send' -ForegroundColor Cyan
                Write-Host ''
                foreach ($item in $picked) {
                    Write-Host ("  {0}  ({1})" -f $item.Name, (Format-ByteSize (Get-TreeSize $item)))
                }
                Write-Host ''
                Write-Host ("{0} item(s), {1}" -f $picked.Count, (Format-ByteSize $total))
                $folders = @($picked | Where-Object { $_.PSIsContainer })
                if ($picked.Count -gt 1 -or $folders.Count -gt 0) {
                    Write-Host 'These will be sent as one zip.'
                }
                $yes = Read-Host 'Send these? [Y/N]'
                if ($yes -match '^[Yy]') { $confirmed = $true }
            }
        }
        $usePin = $true
        $quickTarget = $null
        $sendTotal = 0L
        foreach ($item in $picked) { $sendTotal += Get-TreeSize $item }
        $mine = @(Get-LanIPv4 -IncludeVirtual)
        $quick = @()
        Clear-Host
        Write-Host 'Choose a PC' -ForegroundColor Cyan
        Write-Host ''
        Write-Host ("This send is {0}." -f (Format-ByteSize $sendTotal))
        Write-Host 'Looking for PCs with Quick receive...'
        try {
            $quick = @(Receive-Beacons -Seconds 3 | Where-Object {
                $_.Token -eq 'QUICK' -and $_.Port -gt 0 -and ($mine -notcontains $_.IP)
            })
        } catch { $quick = @() }
        if ($quick.Count -eq 0) {
            Write-Host ''
            Write-Host 'No other PC with Quick receive was found.' -ForegroundColor Yellow
            Write-Host 'If Quick receive is on but discovery is blocked, type that PC''s IP.'
            $fallback = Read-Host '[I] Type IP  [P] Send with PIN  [Q] Back'
            if ($fallback -match '^[Ii]') {
                $manual = Read-QuickReceiveTargetByIp
                if (-not $manual) { continue }
                $usePin = $false
                $quickTarget = $manual
            }
            elseif ($fallback -match '^[PpYy]') {
                $usePin = $true
            }
            else {
                continue
            }
        }
        else {
            $labels = @($quick | ForEach-Object { "{0} ({1})  {2}" -f $_.Display, $_.Windows, $_.IP })
            $labels += 'Type IP for Quick receive'
            $labels += 'Send with a PIN instead'
            $how = Read-ArrowMenu -Title 'Choose a PC' -Lines @(
                ("This send is {0}." -f (Format-ByteSize $sendTotal)),
                'Pick the PC that should receive these files.'
            ) -Items $labels -Descriptions (@($quick | ForEach-Object { 'Send straight to this PC. It has Quick receive on, so nobody needs to type anything.' }) + @(
                'Type the IP address of a PC that has Quick receive on.',
                'Make a PIN here. The other PC types it in Receive files to download.'
            )) -ZeroLabel 'Back' -Hint 'Arrow keys move. Enter chooses. Type the number to choose that PC. 0 goes back.'
            if ($how -lt 0) { continue }
            if ($how -lt $quick.Count) {
                $usePin = $false
                $quickTarget = $quick[$how]
            }
            elseif ($how -eq $quick.Count) {
                $manual = Read-QuickReceiveTargetByIp
                if (-not $manual) { continue }
                $usePin = $false
                $quickTarget = $manual
            }
        }
        Write-Host ''
        Write-Host 'Preparing the transfer...' -ForegroundColor DarkGray
        $payload = $null
        try {
            Write-TransferDebug 'send.prepare' @{ items = $picked.Count; total = $sendTotal; mode = $(if ($usePin) { 'pin' } else { 'quick' }); target = $(if ($quickTarget) { $quickTarget.Display } else { '-' }) }
            $payload = New-SendPayload $picked
            Write-TransferDebug 'send.payload-ready' @{ file = $payload.Name; path = $payload.Path; size = $payload.Size; temp = [bool]$payload.Temp }
            if (-not $usePin) {
                try {
                    Invoke-QuickUpload -Address $quickTarget.IP -Port $quickTarget.Port -FilePath $payload.Path -DownloadName $payload.Name -TargetName $quickTarget.Display
                } finally {
                    if ($payload.Temp) {
                        Remove-Item -LiteralPath $payload.Temp -Force -ErrorAction SilentlyContinue
                    }
                }
            }
            else {
                [void](Start-ShareServer -FilePath $payload.Path -DownloadName $payload.Name -TempToDelete $payload.Temp)
            }
        } catch {
            Write-TransferDebug 'send.failed' @{ error = $_.Exception.Message }
            Write-Host $_.Exception.Message -ForegroundColor Red
            if ($payload -and $payload.Temp) {
                Remove-Item -LiteralPath $payload.Temp -Force -ErrorAction SilentlyContinue
            }
        }
        Wait-Enter
        return
        }
    }
}

function Get-QuickReceiveTargets {
    $mine = @(Get-LanIPv4 -IncludeVirtual)
    try {
        return @(Receive-Beacons -Seconds 3 | Where-Object {
            $_.Token -eq 'QUICK' -and $_.Port -gt 0 -and ($mine -notcontains $_.IP)
        } | Sort-Object Display, Windows, IP)
    } catch { return @() }
}

function Show-SendToSlip {
    param([string[]]$Paths)
    Clear-Host
    Write-Host 'Send with Slip' -ForegroundColor Cyan
    Write-Host ''
    $items = @()
    $seen = @{}
    foreach ($path in @($Paths)) {
        if ([string]::IsNullOrWhiteSpace($path)) { continue }
        try {
            $item = Get-Item -LiteralPath $path -Force -ErrorAction Stop
            $key = $item.FullName.ToLowerInvariant()
            if (-not $seen.ContainsKey($key)) {
                $seen[$key] = $true
                $items += $item
            }
        } catch {
            Write-Host ("Skipped missing item: {0}" -f $path) -ForegroundColor Yellow
        }
    }
    if ($items.Count -eq 0) {
        Write-Host 'No file or folder was selected.' -ForegroundColor Yellow
        Wait-Enter
        return $false
    }
    $total = 0L
    foreach ($item in $items) { $total += Get-TreeSize $item }
    foreach ($item in $items) { Write-Host ("  {0}" -f $item.Name) }
    if ($items.Count -gt 1 -or @($items | Where-Object { $_.PSIsContainer }).Count -gt 0) {
        Write-Host ("  {0} item(s), {1}; sent as one zip" -f $items.Count, (Format-ByteSize $total)) -ForegroundColor DarkGray
    } else {
        Write-Host ("  {0}" -f (Format-ByteSize $total)) -ForegroundColor DarkGray
    }
    Write-Host ''
    Write-Host 'Looking for PCs with Quick receive...'
    $targets = @(Get-QuickReceiveTargets)
    if ($targets.Count -eq 0) {
        Write-Host ''
        Write-Host 'No PC with Quick receive was found.' -ForegroundColor Yellow
        Write-Host 'On the receiving PC: Slip > Settings > Quick receive: On.'
        Write-Host 'Both PCs must be on the same trusted Private network.' -ForegroundColor DarkGray
        Wait-Enter
        return $false
    }
    if ($targets.Count -eq 1) {
        $target = $targets[0]
        Write-Host ("Found {0} ({1}). Sending now." -f $target.Display, $target.Windows) -ForegroundColor Green
    } else {
        $labels = @($targets | ForEach-Object { "{0} ({1})  {2}" -f $_.Display, $_.Windows, $_.IP })
        $pick = Read-ArrowMenu -Title 'Send with Slip' -Lines @(
            ("{0} item(s), {1}" -f $items.Count, (Format-ByteSize $total)),
            'Pick the PC that should receive them.'
        ) -Items $labels -Descriptions @($targets | ForEach-Object { 'Send the selected files to this PC now.' }) -ZeroLabel 'Cancel'
        if ($pick -lt 0) { return $false }
        $target = $targets[$pick]
    }
    $payload = $null
    try {
        Write-Host ''
        Write-Host 'Preparing the transfer...' -ForegroundColor DarkGray
        Write-TransferDebug 'send.sendto.prepare' @{ items = $items.Count; total = $total; target = $target.Display }
        $payload = New-SendPayload $items
        Invoke-QuickUpload -Address $target.IP -Port $target.Port -FilePath $payload.Path -DownloadName $payload.Name -TargetName $target.Display
        Write-Host ''
        Write-Host 'Done. This window will close.' -ForegroundColor Green
        Start-Sleep -Seconds 2
        return $true
    } catch {
        Write-TransferDebug 'send.sendto.failed' @{ error = $_.Exception.Message; target = $target.Display }
        Write-Host ''
        Write-Host $_.Exception.Message -ForegroundColor Red
        Wait-Enter
        return $false
    } finally {
        if ($payload -and $payload.Temp) { Remove-Item -LiteralPath $payload.Temp -Force -ErrorAction SilentlyContinue }
    }
}

function Receive-Beacons {
    param([int]$Seconds = 4)
    $udp = New-Object System.Net.Sockets.UdpClient
    $found = @{}
    try {
        $udp.Client.SetSocketOption([Net.Sockets.SocketOptionLevel]::Socket, [Net.Sockets.SocketOptionName]::ReuseAddress, $true)
        $udp.Client.Bind((New-Object System.Net.IPEndPoint ([Net.IPAddress]::Any, $script:BeaconPort)))
        $udp.Client.ReceiveTimeout = 400
        $end = (Get-Date).AddSeconds($Seconds)
        while ((Get-Date) -lt $end) {
            try {
                $remote = New-Object System.Net.IPEndPoint ([Net.IPAddress]::Any, 0)
                $bytes = $udp.Receive([ref]$remote)
                $msg = [Text.Encoding]::UTF8.GetString($bytes)
                $parts = $msg.Split('|')
                if ($parts.Length -lt 7) { continue }
                if ($parts[0] -ne $script:BeaconPrefix) { continue }
                $key = '{0}:{1}:{2}' -f $remote.Address.ToString(), $parts[2], $parts[1]
                $found[$key] = @{
                    IP = $remote.Address.ToString()
                    Token = $parts[1]
                    Port = [int]$parts[2]
                    Display = $parts[3]
                    Windows = $parts[4]
                    Size = [long]$parts[5]
                    File = ($parts[6..($parts.Length - 1)] -join '|')
                }
            } catch {}
        }
    } catch {
        Write-Host "Could not listen for other PCs. $($_.Exception.Message)" -ForegroundColor Yellow
        return @()
    } finally {
        try { $udp.Close() } catch {}
    }
    return @($found.Values)
}

function Test-TcpOpen {
    param([string]$Address, [int]$Port, [int]$TimeoutMs = 800)
    $client = New-Object System.Net.Sockets.TcpClient
    try {
        $iar = $client.BeginConnect($Address, $Port, $null, $null)
        if (-not $iar.AsyncWaitHandle.WaitOne($TimeoutMs, $false)) { return $false }
        $client.EndConnect($iar)
        return [bool]$client.Connected
    } catch {
        return $false
    } finally {
        try { $client.Close() } catch {}
    }
}

