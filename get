    if (-not (Test-Path -LiteralPath $path)) { return @() }
    return @(Get-ChildItem -LiteralPath $path -Force | Where-Object { $_.Name -notin @('desktop.ini', 'Thumbs.db') })
}

function Get-TreeSize {
    param($Item)
    if (-not $Item.PSIsContainer) { return [long]$Item.Length }
    $sum = (Get-ChildItem -LiteralPath $Item.FullName -Recurse -File -Force -ErrorAction SilentlyContinue | Measure-Object -Property Length -Sum).Sum
    if (-not $sum) { return 0L }
    return [long]$sum
}

function Open-Folder {
    param([string]$Path)
    if (-not (Test-Path -LiteralPath $Path)) {
        New-Item -ItemType Directory -Force -Path $Path | Out-Null
    }
    Start-Process explorer.exe -ArgumentList $Path
}

function New-SendPayload {
    param($Items)
    $files = @($Items | Where-Object { -not $_.PSIsContainer })
    $dirs = @($Items | Where-Object { $_.PSIsContainer })
    if ($files.Count -eq 1 -and $dirs.Count -eq 0) {
        return @{
            Path = $files[0].FullName
            Name = $files[0].Name
            Temp = $null
            Size = [long]$files[0].Length
        }
    }
    $stage = Join-Path $env:TEMP ("{0}-stage-{1}" -f $script:CommandName, [guid]::NewGuid().ToString('N'))
    New-Item -ItemType Directory -Force -Path $stage | Out-Null
    foreach ($dir in $dirs) {
        Copy-Item -LiteralPath $dir.FullName -Destination (Join-Path $stage $dir.Name) -Recurse -Force
    }
    foreach ($file in $files) {
        $dest = Join-Path $stage $file.Name
        $n = 1
        while (Test-Path -LiteralPath $dest) {
            $dest = Join-Path $stage ("{0} ({1}){2}" -f $file.BaseName, $n, $file.Extension)
            $n++
        }
        Copy-Item -LiteralPath $file.FullName -Destination $dest -Force
    }
    $zip = Join-Path $env:TEMP ("{0}-{1}.zip" -f $script:AppName, [guid]::NewGuid().ToString('N'))
    Add-Type -AssemblyName System.IO.Compression.FileSystem
    [IO.Compression.ZipFile]::CreateFromDirectory($stage, $zip)
    Remove-Item -LiteralPath $stage -Recurse -Force -ErrorAction SilentlyContinue
    return @{
        Path = $zip
        Name = "$($script:AppName).zip"
        Temp = $zip
        Size = [long](Get-Item -LiteralPath $zip).Length
    }
}

function Read-HttpHeaders {
    param($Stream)
    $ms = New-Object System.IO.MemoryStream
    $one = New-Object byte[] 1
    while ($ms.Length -lt 16384) {
        $n = $Stream.Read($one, 0, 1)
        if ($n -le 0) { break }
        $ms.Write($one, 0, 1)
        if ($ms.Length -ge 4) {
            $buffer = $ms.GetBuffer()
            $i = [int]$ms.Length - 4
            if ($buffer[$i] -eq 13 -and $buffer[$i + 1] -eq 10 -and $buffer[$i + 2] -eq 13 -and $buffer[$i + 3] -eq 10) { break }
        }
    }
    return [Text.Encoding]::ASCII.GetString($ms.ToArray(), 0, [int]$ms.Length)
}

function Write-HttpBytes {
    param($Stream, [string]$Head, [byte[]]$Body)
    $headBytes = [Text.Encoding]::ASCII.GetBytes($Head)
    $Stream.Write($headBytes, 0, $headBytes.Length)
    if ($Body -and $Body.Length -gt 0) {
        $Stream.Write($Body, 0, $Body.Length)
    }
}

function Send-HttpText {
    param($Stream, [int]$Code, [string]$Status, [string]$ContentType, [string]$Body)
    $bytes = [Text.Encoding]::UTF8.GetBytes($Body)
    $head = "HTTP/1.1 $Code $Status`r`nContent-Type: $ContentType; charset=utf-8`r`nContent-Length: $($bytes.Length)`r`nConnection: close`r`n`r`n"
    Write-HttpBytes -Stream $Stream -Head $head -Body $bytes
}

function Send-FileResponse {
    param($Stream, [string]$FilePath, [string]$DownloadName)
    $len = [long](Get-Item -LiteralPath $FilePath).Length
    $ascii = ($DownloadName -replace '[^\x20-\x7E]', '_') -replace '"', ''
    $star = [Uri]::EscapeDataString($DownloadName)
    $head = "HTTP/1.1 200 OK`r`nContent-Type: application/octet-stream`r`nContent-Length: $len`r`nContent-Disposition: attachment; filename=`"$ascii`"; filename*=UTF-8''$star`r`nConnection: close`r`n`r`n"
    $headBytes = [Text.Encoding]::ASCII.GetBytes($head)
    $Stream.Write($headBytes, 0, $headBytes.Length)
    $fs = [IO.File]::Open($FilePath, 'Open', 'Read', 'ReadWrite')
    try {
        $buf = New-Object byte[] (1MB)
        while (($n = $fs.Read($buf, 0, $buf.Length)) -gt 0) {
            $Stream.Write($buf, 0, $n)
        }
        $Stream.Flush()
    } finally {
        $fs.Dispose()
    }
}

function Test-PinMatch {
    param([string]$Given, [string]$Expected)
    if ([string]::IsNullOrEmpty($Given) -or [string]::IsNullOrEmpty($Expected)) { return $false }
    if ($Given.Length -ne $Expected.Length) { return $false }
    $diff = 0
    for ($i = 0; $i -lt $Given.Length; $i++) {
        $diff = $diff -bor ([int][char]$Given[$i] -bxor [int][char]$Expected[$i])
    }
    return ($diff -eq 0)
}

function Handle-HttpClient {
    param($Client, [string]$Token, [string]$Pin, [string]$FilePath, [string]$DownloadName)
    $Client.ReceiveTimeout = 20000
    $stream = $Client.GetStream()
    $raw = Read-HttpHeaders $stream
    $line = ($raw -split "`r`n")[0]
    if ($line -notmatch '^GET\s+(\S+)\s+HTTP/') {
        Send-HttpText $stream 400 'Bad Request' 'text/plain' 'Bad request'
        return $false
    }
    $target = $Matches[1]
    $q = $target.IndexOf('?')
    $path = if ($q -ge 0) { $target.Substring(0, $q) } else { $target }
    $query = if ($q -ge 0) { $target.Substring($q + 1) } else { '' }
    $given = $null
    foreach ($pair in ($query -split '&')) {
        if (-not $pair) { continue }
        $kv = $pair -split '=', 2
        if ($kv[0] -eq 'pin' -and $kv.Length -eq 2) {
            $given = [Uri]::UnescapeDataString(($kv[1] -replace '\+', ' '))
        }
    }
    $downloadPath = "/d/$Token"
    if ($path -eq '/' -or ($path -eq $downloadPath -and -not $given)) {
        $html = @"
<!DOCTYPE html>
<html><head><meta charset="utf-8"><title>$($script:AppName)</title></head>
<body>
<p>Enter the PIN from the other PC.</p>
<form method="get" action="$downloadPath">
<input name="pin" inputmode="numeric" autofocus>
<button type="submit">Download</button>
</form>
</body></html>
"@
        Send-HttpText $stream 200 'OK' 'text/html' $html
        return $false
    }
    if ($path -ne $downloadPath) {
        Send-HttpText $stream 404 'Not Found' 'text/plain' 'Not found'
        return $false
    }
    if (-not (Test-PinMatch $given $Pin)) {
        Send-HttpText $stream 401 'Unauthorized' 'text/plain' 'Wrong PIN'
        return $false
    }
    Send-FileResponse $stream $FilePath $DownloadName
    return $true
}

function Send-Beacon {
    param($Udp, [string]$Token, [int]$Port, [long]$Size, [string]$FileName)
    $msg = @(
        $script:BeaconPrefix,
        $Token,
        $Port,
        (ConvertTo-BeaconField (Get-DisplayName)),
        (ConvertTo-BeaconField $env:COMPUTERNAME),
        $Size,
        (ConvertTo-BeaconField $FileName)
    ) -join '|'
    $bytes = [Text.Encoding]::UTF8.GetBytes($msg)
    [void]$Udp.Send($bytes, $bytes.Length, '255.255.255.255', $script:BeaconPort)
}

function Start-ShareServer {
    param(
        [string]$FilePath,
        [string]$DownloadName,
        [string]$TempToDelete,
        [string]$ReadyFile,
        [switch]$Quiet
    )
    $listener = $null
    $port = 0
    foreach ($candidate in $script:PortFirst..$script:PortLast) {
        $tryListen = $null
        try {
            $tryListen = New-Object System.Net.Sockets.TcpListener ([Net.IPAddress]::Any, $candidate)
            $tryListen.Start()
            $listener = $tryListen
            $port = $candidate
            break
        } catch {
            if ($tryListen) { try { $tryListen.Stop() } catch {} }
        }
    }
    if (-not $listener) { throw "No free port between $($script:PortFirst) and $($script:PortLast)." }

    $token = ([guid]::NewGuid().ToString('N')).Substring(0, 16)
    $pin = (Get-Random -Minimum 0 -Maximum 1000000).ToString('000000')
    $size = [long](Get-Item -LiteralPath $FilePath).Length
    $udp = New-Object System.Net.Sockets.UdpClient
    $udp.EnableBroadcast = $true
    $done = $false
    try {
        if ($ReadyFile) {
            Set-Content -LiteralPath $ReadyFile -Value "$port $pin $token" -Encoding ASCII
        }
        if ($Quiet) {
            [Console]::Out.WriteLine("READY $port $pin $token")
            [Console]::Out.Flush()
        } else {
            Write-Host ''
            Write-Host ("Other PCs see you as: {0} ({1})" -f (Get-DisplayName), $env:COMPUTERNAME)
            Write-Host ("File: {0}  ({1})" -f $DownloadName, (Format-ByteSize $size))
            Write-Host ''
            Write-Host "PIN  $pin" -ForegroundColor Yellow
            $shown = @(Get-LanIPv4)
            if ($shown.Count -eq 0) { $shown = @('127.0.0.1') }
            foreach ($ip in $shown) {
                Write-Host "URL  http://${ip}:$port/" -ForegroundColor Yellow
            }
            Write-Host ''
            Write-Host 'Leave this window open. Waiting up to 15 minutes for one download.'
            Write-Host 'Press Q to cancel.' -ForegroundColor DarkGray
        }
        $deadline = (Get-Date).AddMinutes(15)
        $lastBeacon = [datetime]::MinValue
        while (-not $done -and (Get-Date) -lt $deadline) {
            if (((Get-Date) - $lastBeacon).TotalSeconds -ge 1) {
                try { Send-Beacon $udp $token $port $size $DownloadName } catch {}
                $lastBeacon = Get-Date
            }
            if (-not $Quiet) {
                try {
                    if (-not [Console]::IsInputRedirected -and [Console]::KeyAvailable) {
                        $key = [Console]::ReadKey($true)
                        if ($key.Key -eq 'Q' -or $key.Key -eq 'Escape') { break }
                    }
                } catch {}
            }
            if (-not $listener.Pending()) {
                Start-Sleep -Milliseconds 200
                continue
            }
            $client = $listener.AcceptTcpClient()
            try {
                $ok = Handle-HttpClient $client $token $pin $FilePath $DownloadName
                if ($ok) { $done = $true }
            } catch {
            } finally {
                try { $client.Close() } catch {}
            }
        }
        if (-not $Quiet) {
            Write-Host ''
            if ($done) { Write-Host 'Download finished. You can close this window.' -ForegroundColor Green }
            else { Write-Host 'Stopped before a download finished.' -ForegroundColor Yellow }
        }
    } finally {
        try { $listener.Stop() } catch {}
        try { $udp.Close() } catch {}
        if ($TempToDelete) {
            Remove-Item -LiteralPath $TempToDelete -Force -ErrorAction SilentlyContinue
        }
    }
    return $done
}

function Show-SendFiles {
    while ($true) {
        $items = @(Get-OutboxItems)
        Clear-Host
        Write-Host 'Send files' -ForegroundColor Cyan
        Write-Host ''
        Write-Host (Get-SendStepsText)
        Write-Host ''
        if ($items.Count -eq 0) {
            Write-Host 'The Outbox is empty.' -ForegroundColor Yellow
            Write-Host ("Put files in {0}" -f (Get-OutboxPath))
            Write-Host ''
            $open = Read-Host '[O] Open Outbox  [Q] Back'
            if ($open -match '^[Oo]') { Open-Folder (Get-OutboxPath) }
            return
        }
        $selected = @{}
        for ($i = 0; $i -lt $items.Count; $i++) { $selected[$i] = $true }
        $confirmed = $false
        $picked = @()
        while (-not $confirmed) {
            Clear-Host
            Write-Host 'Send files' -ForegroundColor Cyan
            Write-Host ''
            Write-Host (Get-SendStepsText)
            Write-Host ''
            Write-Host ("  {0,-4} {1,-6} {2,-42} {3}" -f '#', 'Send', 'Name', 'Size')
            for ($i = 0; $i -lt $items.Count; $i++) {
                $mark = if ($selected[$i]) { '[x]' } else { '[ ]' }
                Write-Host ("  {0,-4} {1,-6} {2,-42} {3}" -f ($i + 1), $mark, (Get-ShortText $items[$i].Name), (Format-ByteSize (Get-TreeSize $items[$i])))
            }
            Write-Host ''
            Write-Host 'Number toggles a file. A all, N none, O open folder, C continue, Q back.'
            $choice = Read-Host 'Choice'
            if ($choice -match '^[Qq]$') { return }
            if ($choice -match '^[Aa]$') {
                for ($i = 0; $i -lt $items.Count; $i++) { $selected[$i] = $true }
                continue
            }
            if ($choice -match '^[Nn]$') {
                for ($i = 0; $i -lt $items.Count; $i++) { $selected[$i] = $false }
                continue
            }
            if ($choice -match '^[Oo]$') { Open-Folder (Get-OutboxPath); continue }
            if ($choice -match '^\d+$') {
                $idx = [int]$choice - 1
                if ($idx -ge 0 -and $idx -lt $items.Count) { $selected[$idx] = -not $selected[$idx] }
                continue
            }
            if ($choice -match '^[Cc]$') {
                $picked = @()
                for ($i = 0; $i -lt $items.Count; $i++) {
                    if ($selected[$i]) { $picked += $items[$i] }
                }
                if ($picked.Count -eq 0) {
                    Write-Host 'Select at least one file.' -ForegroundColor Yellow
                    Start-Sleep -Seconds 1
                    continue
                }
                $total = 0L
                foreach ($item in $picked) { $total += Get-TreeSize $item }
                Clear-Host
                Write-Host 'Confirm send' -ForegroundColor Cyan
                Write-Host ''
                foreach ($item in $picked) {
                    Write-Host ("  {0}  ({1})" -f $item.Name, (Format-ByteSize (Get-TreeSize $item)))
                }
                Write-Host ''
                Write-Host ("{0} item(s), {1}" -f $picked.Count, (Format-ByteSize $total))
                $folders = @($picked | Where-Object { $_.PSIsContainer })
                if ($picked.Count -gt 1 -or $folders.Count -gt 0) {
                    Write-Host 'These will be sent as one zip.'
                }
                $yes = Read-Host 'Send these? [Y/N]'
                if ($yes -match '^[Yy]') { $confirmed = $true }
            }
        }
        Write-Host ''
        Write-Host 'Preparing the transfer...' -ForegroundColor DarkGray
        $payload = $null
        try {
            $payload = New-SendPayload $picked
            [void](Start-ShareServer -FilePath $payload.Path -DownloadName $payload.Name -TempToDelete $payload.Temp)
        } catch {
            Write-Host $_.Exception.Message -ForegroundColor Red
            if ($payload -and $payload.Temp) {
                Remove-Item -LiteralPath $payload.Temp -Force -ErrorAction SilentlyContinue
            }
        }
        Wait-Enter
        return
    }
}

function Receive-Beacons {
    param([int]$Seconds = 4)
    $udp = New-Object System.Net.Sockets.UdpClient
    $found = @{}
    try {
        $udp.Client.SetSocketOption([Net.Sockets.SocketOptionLevel]::Socket, [Net.Sockets.SocketOptionName]::ReuseAddress, $true)
        $udp.Client.Bind((New-Object System.Net.IPEndPoint ([Net.IPAddress]::Any, $script:BeaconPort)))
        $udp.Client.ReceiveTimeout = 400
        $end = (Get-Date).AddSeconds($Seconds)
        while ((Get-Date) -lt $end) {
            try {
                $remote = New-Object System.Net.IPEndPoint ([Net.IPAddress]::Any, 0)
                $bytes = $udp.Receive([ref]$remote)
                $msg = [Text.Encoding]::UTF8.GetString($bytes)
                $parts = $msg.Split('|')
                if ($parts.Length -lt 7) { continue }
                if ($parts[0] -ne $script:BeaconPrefix) { continue }
                $key = '{0}:{1}:{2}' -f $remote.Address.ToString(), $parts[2], $parts[1]
                $found[$key] = @{
                    IP = $remote.Address.ToString()
                    Token = $parts[1]
                    Port = [int]$parts[2]
                    Display = $parts[3]
                    Windows = $parts[4]
                    Size = [long]$parts[5]
                    File = ($parts[6..($parts.Length - 1)] -join '|')
                }
            } catch {}
        }
    } catch {
        Write-Host "Could not listen for other PCs. $($_.Exception.Message)" -ForegroundColor Yellow
        return @()
    } finally {
        try { $udp.Close() } catch {}
    }
    return @($found.Values)
}

function Test-TcpOpen {
    param([string]$Address, [int]$Port, [int]$TimeoutMs = 800)
    $client = New-Object System.Net.Sockets.TcpClient
    try {
        $iar = $client.BeginConnect($Address, $Port, $null, $null)
        if (-not $iar.AsyncWaitHandle.WaitOne($TimeoutMs, $false)) { return $false }
        $client.EndConnect($iar)
        return [bool]$client.Connected
    } catch {
        return $false
    } finally {
        try { $client.Close() } catch {}
    }
}

