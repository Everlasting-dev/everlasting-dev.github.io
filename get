function Show-SlipMenu {
    param([switch]$CanReturn)
    $loop = $null
    try {
        $loop = Start-PresenceLoop
        while ($true) {
            $ips = @(Get-LanIPv4)
            $ipText = if ($ips.Count -gt 0) { $ips[0] } else { 'no LAN address' }
            $outCount = @(Get-OutboxItems).Count
            $zero = if ($CanReturn) { 'Back' } else { 'Quit' }
            $pick = Read-ArrowMenu -Title $script:AppName -Lines @(
                ("Shown as: {0}    {1}" -f (Get-DisplayName), $ipText),
