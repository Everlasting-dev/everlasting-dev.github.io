function Get-RemoteHelpReport {
    $activeProfiles = @(Get-ActiveNetworkProfiles)
    $publicProfiles = @($activeProfiles | Where-Object { $_.NetworkCategory -ne 'Private' -and $_.NetworkCategory -ne 'DomainAuthenticated' })
    $networks = @()
    foreach ($item in $activeProfiles) {
        $networks += [ordered]@{ Name = [string]$item.Name; Adapter = [string]$item.InterfaceAlias; Category = [string]$item.NetworkCategory }
    }
    $osName = [Environment]::OSVersion.VersionString
    $build = [Environment]::OSVersion.Version.Build
    try {
        $current = Get-ItemProperty -LiteralPath 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion' -ErrorAction Stop
        if ($current.ProductName) { $osName = [string]$current.ProductName }
        if ($current.CurrentBuildNumber) { $build = [string]$current.CurrentBuildNumber }
    } catch { }
    $uptimeSeconds = $null
    try { $uptimeSeconds = [int64]([Environment]::TickCount64 / 1000) } catch {
        try { $uptimeSeconds = [int64]([uint32][Environment]::TickCount / 1000) } catch { }
    }
    $disk = $null
    try {
        $drive = Get-PSDrive -Name ([IO.Path]::GetPathRoot($env:SystemRoot).TrimEnd(':\')) -ErrorAction Stop
        $disk = [ordered]@{ FreeBytes = [int64]$drive.Free; UsedBytes = [int64]$drive.Used }
    } catch { }
    $quick = Get-ListenerReport -PidPath (Get-ListenPidPath) -PortPath (Get-ListenPortPath) -Enabled (Test-QuickReceive)
    $chat = Get-ListenerReport -PidPath (Get-ChatPidPath) -PortPath (Get-ChatPortPath) -Enabled (Test-AutoChat)
    $support = Get-ListenerReport -PidPath (Get-RemoteHelpPidPath) -PortPath (Get-RemoteHelpPortPath) -Enabled (Test-RemoteHelp)
    $updateState = Get-UpdateReminderState
    $updateReminder = [ordered]@{
        Enabled = $updateState.Enabled
        Time = $updateState.Time
        TaskPresent = (Test-UpdateReminderTask)
        LastCheckedUtc = $updateState.LastCheckedUtc
        LastNotifiedVersion = $updateState.LastNotifiedVersion
    }
    $sendToShortcut = Test-Path -LiteralPath (Get-SendToShortcutPath)
    $firewallTcp = Test-FirewallRule $script:RuleTcp
    $firewallUdp = Test-FirewallRule $script:RuleUdp
    $findings = New-Object Collections.Generic.List[string]
    if ($activeProfiles.Count -eq 0) { $findings.Add('No active physical network profile was found.') }
    elseif ($publicProfiles.Count -gt 0) { $findings.Add('The active network is Public; Slip inbound rules only apply on Private networks.') }
    if (-not $firewallTcp) { $findings.Add("Firewall rule '$($script:RuleTcp)' is missing.") }
    if (-not $firewallUdp) { $findings.Add("Firewall rule '$($script:RuleUdp)' is missing.") }
    if ($quick.Enabled -and -not $quick.Running) { $findings.Add('Quick receive is enabled but its listener is not running.') }
    if ($chat.Enabled -and -not $chat.Running) { $findings.Add('Auto chat is enabled but its listener is not running.') }
    if ($updateReminder.Enabled -and -not $updateReminder.TaskPresent) { $findings.Add('Update reminders are enabled but their Windows task is missing.') }
    if (-not $sendToShortcut) { $findings.Add('The Windows Send to -> Slip shortcut is missing.') }
    if ($disk -and $disk.FreeBytes -lt 2GB) { $findings.Add('The Windows drive has less than 2 GB free.') }
    if ($findings.Count -eq 0) { $findings.Add('No obvious Slip or network problem was found.') }
    return [ordered]@{
        Protocol = 1
        GeneratedUtc = [DateTime]::UtcNow.ToString('o')
        Computer = [ordered]@{ DisplayName = (Get-DisplayName); WindowsName = $env:COMPUTERNAME; User = $env:USERNAME }
        Slip = [ordered]@{
            Version = $script:Version
            Installed = (Test-SlipInstalled)
            FirewallTcp = $firewallTcp
            FirewallUdp = $firewallUdp
            QuickReceive = $quick
            AutoChat = $chat
            RemoteHelp = $support
            UpdateReminder = $updateReminder
            SendToShortcut = $sendToShortcut
        }
        Windows = [ordered]@{ Product = $osName; Build = $build; PowerShell = [string]$PSVersionTable.PSVersion; UptimeSeconds = $uptimeSeconds }
        Network = [ordered]@{ Addresses = @(Get-LanIPv4); Profiles = $networks }
        Disk = $disk
        Findings = @($findings)
        Logs = [ordered]@{
            Slip = (@(Get-RecentRemoteHelpLog -Path (Join-Path (Get-DebugPath) "$($script:CommandName).log")) -join "`n")
            Transfer = (@(Get-RecentRemoteHelpLog -Path (Get-TransferDebugPath)) -join "`n")
        }
    }
}

function Get-RemoteHelpCommandLine {
    return (Get-BackgroundCommandLine 'remotehelp')
}

function Test-RemoteHelpListenerAlive {
    $listenerPid = 0
    $path = Get-RemoteHelpPidPath
    if (Test-Path -LiteralPath $path) {
        [void][int]::TryParse((Get-Content -LiteralPath $path -Raw -ErrorAction SilentlyContinue).Trim(), [ref]$listenerPid)
    }
    return $null -ne (Get-SlipListenerProcess -ProcessId $listenerPid -Entry 'remotehelp')
}

function Set-RemoteHelpRunKey {
    $runPath = 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Run'
    if (-not (Test-Path -LiteralPath $runPath)) { New-Item -Path $runPath -Force | Out-Null }
    New-ItemProperty -LiteralPath $runPath -Name (Get-RemoteHelpRunName) -Value (Get-RemoteHelpCommandLine) -PropertyType String -Force | Out-Null
}

function Enable-RemoteHelp {
    param([switch]$Quiet)
    Ensure-SlipFiles | Out-Null
    [void](Get-RemoteHelpSecret -Create)
    Set-Content -LiteralPath (Get-RemoteHelpFlagPath) -Value 'on' -Encoding ASCII
    Install-SlipCommand
    Set-RemoteHelpRunKey
    if (-not (Test-RemoteHelpListenerAlive)) {
        $scriptPath = Get-InstalledScriptPath
        Start-SlipBackground 'remotehelp' | Out-Null
    }
    if (-not $Quiet) { Write-Host 'Remote help is on.' -ForegroundColor Green }
}

function Ensure-RemoteHelp {
    if (-not (Test-RemoteHelp) -or (Test-RemoteHelpListenerAlive)) { return }
    $scriptPath = Get-InstalledScriptPath
    if (-not (Test-Path -LiteralPath $scriptPath)) { return }
    Start-SlipBackground 'remotehelp' | Out-Null
}

function Stop-RemoteHelp {
    param([switch]$KeepSetting, [switch]$ForgetSecret)
    if (-not $KeepSetting -and (Test-Path -LiteralPath (Get-RemoteHelpFlagPath))) {
        Set-Content -LiteralPath (Get-RemoteHelpFlagPath) -Value 'off' -Encoding ASCII
    }
    $listenerPid = 0
    if (Test-Path -LiteralPath (Get-RemoteHelpPidPath)) {
        [void][int]::TryParse((Get-Content -LiteralPath (Get-RemoteHelpPidPath) -Raw -ErrorAction SilentlyContinue).Trim(), [ref]$listenerPid)
        if ($listenerPid -gt 0) { Stop-SlipListenerProcess -ProcessId $listenerPid -Entry 'remotehelp' }
    }
    Remove-Item -LiteralPath (Get-RemoteHelpPidPath) -Force -ErrorAction SilentlyContinue
    Remove-Item -LiteralPath (Get-RemoteHelpPortPath) -Force -ErrorAction SilentlyContinue
    if (-not $KeepSetting) {
        Remove-ItemProperty -LiteralPath 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Run' -Name (Get-RemoteHelpRunName) -ErrorAction SilentlyContinue
    }
    if ($ForgetSecret) { Remove-Item -LiteralPath (Get-RemoteHelpSecretPath) -Force -ErrorAction SilentlyContinue }
}

function Start-RemoteHelpListener {
    if (-not (Test-RemoteHelp)) { return }
    $key = Get-RemoteHelpKey
    if (-not $key) { throw 'Remote help pairing key is missing.' }
    $listener = New-SlipTcpListener
    $port = ([Net.IPEndPoint]$listener.LocalEndpoint).Port
    Set-Content -LiteralPath (Get-RemoteHelpPidPath) -Value $PID -Encoding ASCII
    Set-Content -LiteralPath (Get-RemoteHelpPortPath) -Value $port -Encoding ASCII
    $seen = New-Object 'System.Collections.Generic.HashSet[string]'
    Write-TransferDebug 'remote-help.listener.started' @{ port = $port; pid = $PID }
    try {
        while (Test-RemoteHelp) {
            $payload = '{0}|SUPPORT|{1}|{2}|{3}|0|support' -f $script:BeaconPrefix, $port, (ConvertTo-BeaconField (Get-DisplayName)), (ConvertTo-BeaconField $env:COMPUTERNAME)
            try { [void](Send-BeaconPayload -Payload $payload -Port $script:BeaconPort) } catch { }
            if (-not $listener.Pending()) { Start-Sleep -Milliseconds 150; continue }
            $client = $listener.AcceptTcpClient()
            try {
                $client.ReceiveTimeout = 5000
                $client.SendTimeout = 10000
                $stream = $client.GetStream()
                $line = Read-RemoteHelpLine -Stream $stream
                $parts = $line.Split('|')
                if ($parts.Length -ne 5 -or $parts[0] -ne 'SUPPORT1' -or $parts[3] -ne 'status') { continue }
                $timestamp = 0L
                if (-not [int64]::TryParse($parts[1], [ref]$timestamp)) { continue }
                $now = [int64]([DateTime]::UtcNow - [DateTime]'1970-01-01').TotalSeconds
                if ([Math]::Abs($now - $timestamp) -gt 120) { continue }
                $nonce = $parts[2]
                if ($nonce -notmatch '^[0-9A-Fa-f]{32,64}$' -or $seen.Contains($nonce)) { continue }
                $provided = ConvertFrom-HexString $parts[4]
                $canonical = [Text.Encoding]::UTF8.GetBytes(('{0}|{1}|{2}' -f $parts[1], $nonce, $parts[3]))
                $requestKey = Get-RemoteHelpSubkey -Key $key -Purpose 'request authentication'
                $expected = Get-HmacBytes -Key $requestKey -Bytes $canonical
                if (-not (Test-FixedTimeBytes -Left $provided -Right $expected)) { continue }
                [void]$seen.Add($nonce)
                if ($seen.Count -gt 500) { $seen.Clear() }
                $json = (Get-RemoteHelpReport | ConvertTo-Json -Depth 5 -Compress)
                $reply = (Protect-RemoteHelpResult -Key $key -Text $json) + "`n"
                $bytes = [Text.Encoding]::UTF8.GetBytes($reply)
                $stream.Write($bytes, 0, $bytes.Length)
                $stream.Flush()
                Write-TransferDebug 'remote-help.status.sent' @{ remote = [string]$client.Client.RemoteEndPoint; bytes = $bytes.Length }
            } catch {
                Write-TransferDebug 'remote-help.request.failed' @{ error = $_.Exception.Message }
            } finally { try { $client.Close() } catch { } }
        }
    } finally {
        try { $listener.Stop() } catch { }
        Remove-Item -LiteralPath (Get-RemoteHelpPidPath) -Force -ErrorAction SilentlyContinue
        Remove-Item -LiteralPath (Get-RemoteHelpPortPath) -Force -ErrorAction SilentlyContinue
        Write-TransferDebug 'remote-help.listener.stopped' @{ port = $port; pid = $PID }
    }
}

function Show-RemoteHelpScreen {
    Clear-Host
    Write-Host 'Remote help' -ForegroundColor Cyan
    Write-Host ("Version {0}" -f $script:Version) -ForegroundColor DarkGray
    Write-Host ''
    Write-Host 'Remote help lets a paired Slip PC request a fixed health report.'
    Write-Host 'It cannot run commands, browse files, control the desktop, or install software.' -ForegroundColor DarkGray
    Write-Host 'Reports are authenticated and encrypted. Use this only on a trusted Private network.' -ForegroundColor DarkGray
    Write-Host ''
    if (-not (Test-RemoteHelp)) {
        $answer = Read-Host '[Y] Turn on  [N] Back'
        if ($answer -notmatch '^[Yy]') { return }
        Enable-RemoteHelp
    }
    Write-Host ''
    Write-Host 'Pairing code (share once with your other Slip PC):' -ForegroundColor Cyan
    Write-Host ("  {0}" -f (Get-RemoteHelpPairingCode)) -ForegroundColor Yellow
    Write-Host ''
    $answer = Read-Host '[R] Reset code  [O] Turn off  [Enter] Back'
    if ($answer -match '^[Rr]') {
        Stop-RemoteHelp -ForgetSecret
        Enable-RemoteHelp -Quiet
        Write-Host ''
        Write-Host ("New pairing code: {0}" -f (Get-RemoteHelpPairingCode)) -ForegroundColor Yellow
        Wait-Enter
    } elseif ($answer -match '^[Oo]') {
        Stop-RemoteHelp
        Write-Host 'Remote help is off.' -ForegroundColor Green
        Wait-Enter
    }
}

function Test-ChatConsoleKeys {
    # The chat's live input relies on the .NET Console key API, which is reliable
    # under both classic conhost and Windows Terminal / ConPTY. $Host.UI.RawUI's
    # KeyAvailable is not: under ConPTY it can report a key when there is none, so
    # ReadKey then blocks and the socket stops being polled - which looked like
    # "messages only appear after I press Enter".
    try { $null = [Console]::KeyAvailable; return $true } catch { return $false }
}

function Read-ChatKey {
    $ck = [Console]::ReadKey($true)
    $name = ''
    switch ($ck.Key) {
        'Enter'     { $name = 'Enter' }
        'Escape'    { $name = 'Escape' }
        'Backspace' { $name = 'Backspace' }
    }
    $char = ''
    if ($ck.KeyChar -and ([int][char]$ck.KeyChar) -ge 32) { $char = [string]$ck.KeyChar }
    return @{ Name = $name; Char = $char }
}

function Show-ChatSession {
    param(
        [string]$Room,
        [string]$Title,
        $Listener,
        $Stream,
        $Client,
        [string]$OpeningFrom,
        [string]$OpeningText,
        [switch]$IsHost
    )
    $me = Get-DisplayName
    $members = @()
    $closed = $false
    $draft = ''
    $rawInput = Test-ChatConsoleKeys
    Write-TransferDebug 'chat.session.input' @{ mode = $(if ($rawInput) { 'console-keys' } else { 'read-host' }); host = $Host.Name }
    Clear-Host
    Write-Host 'Chat' -ForegroundColor Cyan
    Write-Host ("Version {0}    {1}" -f $script:Version, $Title) -ForegroundColor DarkGray
    Write-Host ''
    if ($OpeningText) {
        Write-Host ("{0}: {1}" -f $OpeningFrom, $OpeningText)
        Write-ChatLog -Room $Room -Kind 'msg' -Name $OpeningFrom -Text $OpeningText
    }
    Write-Host 'Type a message and press Enter. Press Esc to leave (it confirms if the other PC is still here).' -ForegroundColor DarkGray
    Write-Host ''

    function Write-ChatNotice([string]$Kind, [string]$Name) {
        Write-ChatLine (Format-ChatNotice $Kind $Name) ([ConsoleColor]::DarkGray)
        Write-ChatLog -Room $Room -Kind $Kind -Name $Name -Text ''
    }
    function Broadcast-Chat([string]$Line, $Except) {
        foreach ($member in @($members)) {
            if ($Except -and ($member -eq $Except)) { continue }
            try { Send-ChatWire -Stream $member.Stream -Line $Line } catch { }
        }
    }
    function Clear-ChatInput {
        $w = 80
        try { $w = $Host.UI.RawUI.BufferSize.Width } catch { }
        if ($w -lt 2) { $w = 80 }
        Write-Host ("`r" + (' ' * ($w - 1)) + "`r") -NoNewline
    }
    function Show-ChatInput {
        Write-Host ("`r> {0}" -f $draft) -NoNewline
    }
    function Write-ChatLine {
        param([string]$Line, [ConsoleColor]$Color = [ConsoleColor]::Gray)
        if ($rawInput) { Clear-ChatInput }
        Write-Host $Line -ForegroundColor $Color
        if ($rawInput) { Show-ChatInput }
    }

    $solo = @{ Stream = $Stream; Pending = '' }
    if (-not $IsHost -and $Stream) {
        try {
            Send-ChatWire -Stream $Stream -Line ("HELLO|{0}" -f [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($me)))
            Write-TransferDebug 'chat.session.joined' @{ room = $Room; peer = $Title }
        } catch {
            Write-Host 'chat closed' -ForegroundColor DarkGray
            Write-TransferDebug 'chat.session.join-failed' @{ room = $Room; peer = $Title; error = $_.Exception.Message }
            return
        }
    }

    if ($rawInput) { Show-ChatInput }
    while (-not $closed) {
        if ($IsHost -and $Listener -and $Listener.Pending()) {
            $incoming = $Listener.AcceptTcpClient()
            $member = @{ Client = $incoming; Stream = $incoming.GetStream(); Name = 'Guest'; Pending = '' }
            $hello = ''
            $deadline = (Get-Date).AddSeconds(3)
            while (-not $hello -and (Get-Date) -lt $deadline) {
                foreach ($line in @(Receive-ChatWire $member)) { $hello = $line; break }
                if (-not $hello) { Start-Sleep -Milliseconds 50 }
            }
            if ($hello -like 'HELLO|*') {
                try { $member.Name = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($hello.Substring(6))) } catch { }
            }
            $members += $member
            Write-TransferDebug 'chat.member.joined' @{ room = $Room; name = $member.Name }
            Write-ChatNotice 'joined' $member.Name
            Broadcast-Chat ("SYS|joined|{0}" -f $member.Name)
        }
        $drop = @()
        foreach ($member in @($members)) {
            if (Test-SocketDead $member.Client) { $drop += $member; continue }
            try {
                foreach ($line in @(Receive-ChatWire $member)) {
                    if ($line -eq 'BYE') { $drop += $member; continue }
                    if ($line.StartsWith('MSG|')) {
                        $text = ''
                        try { $text = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($line.Substring(4))) } catch { continue }
                        Write-ChatLine ("{0}: {1}" -f $member.Name, $text)
                        Write-ChatLog -Room $Room -Kind 'msg' -Name $member.Name -Text $text
                        Write-TransferDebug 'chat.message.received' @{ room = $Room; from = $member.Name; bytes = $text.Length }
                        Broadcast-Chat ("MSG|{0}|{1}" -f $member.Name, $line.Substring(4)) $member
                    }
                }
            } catch { $drop += $member }
        }
        foreach ($member in @($drop)) {
            Write-ChatNotice 'left' $member.Name
            Write-TransferDebug 'chat.member.left' @{ room = $Room; name = $member.Name }
            Broadcast-Chat ("SYS|left|{0}" -f $member.Name)
            try { $member.Client.Close() } catch { }
            $members = @($members | Where-Object { $_ -ne $member })
        }
        if (-not $IsHost -and $Stream -and -not $closed -and (Test-SocketDead $Client)) {
            Write-ChatLine ('{0} left. Chat closed.' -f $Title) ([ConsoleColor]::Yellow)
            Write-ChatLog -Room $Room -Kind 'closed' -Name $Title -Text ''
            Write-TransferDebug 'chat.peer.lost' @{ room = $Room; peer = $Title }
            $closed = $true
        }
        if (-not $IsHost -and $Stream -and -not $closed) {
            try {
                foreach ($line in @(Receive-ChatWire $solo)) {
                    if ($line.StartsWith('SYS|')) {
                        $bits = $line.Split('|')
                        $kind = $bits[1]
                        $who = if ($bits.Length -gt 2) { $bits[2] } else { '' }
                        Write-ChatNotice $kind $who
                        if ($kind -eq 'closed') { $closed = $true }
                    }
                    elseif ($line.StartsWith('MSG|')) {
                        $bits = $line.Split('|')
                        $text = ''
                        try { $text = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($bits[2])) } catch { continue }
                        Write-ChatLine ("{0}: {1}" -f $bits[1], $text)
                        Write-ChatLog -Room $Room -Kind 'msg' -Name $bits[1] -Text $text
                        Write-TransferDebug 'chat.message.received' @{ room = $Room; from = $bits[1]; bytes = $text.Length }
                    }
                }
            } catch {
                Write-ChatNotice 'closed' ''
                $closed = $true
            }
        }
        if ($closed) { break }
        if (-not $rawInput) {
            $typed = Read-Host '>'
            if ($typed -eq '/quit') { $closed = $true; break }
            if ($typed) {
                $packed = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($typed))
                Write-ChatLog -Room $Room -Kind 'msg' -Name $me -Text $typed
                Write-TransferDebug 'chat.message.sent' @{ room = $Room; bytes = $typed.Length }
                if ($IsHost) { Broadcast-Chat ("MSG|{0}|{1}" -f $me, $packed) }
                elseif ($Stream) { Send-ChatWire -Stream $Stream -Line ("MSG|{0}" -f $packed) }
            }
            continue
        }
        $hasKey = $false
        try { $hasKey = [Console]::KeyAvailable } catch { $hasKey = $false }
        if (-not $hasKey) {
            Start-Sleep -Milliseconds 10
            continue
        }
        $key = Read-ChatKey
        if ($key.Name -eq 'Escape') {
            $peersHere = if ($IsHost) { @($members).Count -gt 0 } else { ($Client -and -not (Test-SocketDead $Client)) }
            if (-not $peersHere) { $closed = $true; break }
            Clear-ChatInput
            Write-Host ''
            Write-Host 'Leave the chat? The other PC is still connected.  [Y] Leave   [N] Stay' -ForegroundColor Yellow
            $ans = Read-ChatKey
            while ($ans.Name -ne 'Enter' -and $ans.Name -ne 'Escape' -and ($ans.Char -notmatch '^[YyNn]$')) { $ans = Read-ChatKey }
            if ($ans.Char -match '^[Yy]$' -or $ans.Name -eq 'Escape') { $closed = $true; break }
            Write-Host 'Still in the chat.' -ForegroundColor DarkGray
            Show-ChatInput
            continue
        }
        if ($key.Name -eq 'Enter') {
            $typed = $draft.Trim()
            $draft = ''
            if (-not $typed) { Clear-ChatInput; Show-ChatInput; continue }
            $packed = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($typed))
            Clear-ChatInput
            Write-Host ("You: {0}" -f $typed)
            Write-ChatLog -Room $Room -Kind 'msg' -Name $me -Text $typed
            Write-TransferDebug 'chat.message.sent' @{ room = $Room; bytes = $typed.Length }
            if ($IsHost) { Broadcast-Chat ("MSG|{0}|{1}" -f $me, $packed) }
            elseif ($Stream) { Send-ChatWire -Stream $Stream -Line ("MSG|{0}" -f $packed) }
            Show-ChatInput
            continue
        }
        if ($key.Name -eq 'Backspace') {
            if ($draft.Length -gt 0) { $draft = $draft.Substring(0, $draft.Length - 1) }
        }
        elseif ($key.Char) { $draft += $key.Char }
        Clear-ChatInput
        Show-ChatInput
    }
    if ($IsHost) {
        Broadcast-Chat 'SYS|closed|'
        Write-Host ''
        Write-Host 'chat closed' -ForegroundColor DarkGray
        Write-ChatLog -Room $Room -Kind 'closed' -Name $me -Text ''
        Write-TransferDebug 'chat.session.closed' @{ room = $Room; role = 'host' }
        foreach ($member in @($members)) { try { $member.Client.Close() } catch { } }
        try { $Listener.Stop() } catch { }
    }
    elseif ($Stream) {
        try { Send-ChatWire -Stream $Stream -Line 'BYE' } catch { }
        try { $Stream.Close() } catch { }
        Write-TransferDebug 'chat.session.closed' @{ room = $Room; role = 'guest' }
        if ($rawInput) {
            Write-Host ''
            Write-Host 'Chat closed. Press Enter to close this window.' -ForegroundColor DarkGray
            [void](Read-Host)
        }
    }
}

function Show-ChatPeople {
    param($People)
    $items = @($People | ForEach-Object { "{0} ({1})" -f $_.Display, $_.Windows })
    $pick = Read-ArrowMenu -Title 'Chat' -Lines @('Pick the PC you want to chat with.') -Items $items -Descriptions @($People | ForEach-Object { 'Open a chat window with this PC.' }) -ZeroLabel 'Back' -Hint 'Arrow keys move. Enter opens the chat with that PC. Type its number. 0 goes back.'
    if ($pick -lt 0) { return $null }
    return @($People[$pick])
}

function Invoke-ChatInvite {
    param($Person, [string]$Room, [int]$HostPort, [string]$Text)
    $client = New-Object System.Net.Sockets.TcpClient
    try {
        Write-TransferDebug 'chat.invite.start' @{ target = $Person.Display; address = $Person.IP; port = $Person.Port; room = $Room }
        $wait = $client.BeginConnect($Person.IP, [int]$Person.Port, $null, $null)
        if (-not $wait.AsyncWaitHandle.WaitOne(4000, $false)) {
            Write-TransferDebug 'chat.invite.failed' @{ target = $Person.Display; address = $Person.IP; port = $Person.Port; reason = 'timeout' }
            return $false
        }
        $client.EndConnect($wait)
        $stream = $client.GetStream()
        $from = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes((Get-DisplayName)))
        $body = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($Text))
        $line = "INVITE|{0}|{1}|{2}|{3}`n" -f $Room, $HostPort, $from, $body
        $bytes = [Text.Encoding]::ASCII.GetBytes($line)
        $stream.Write($bytes, 0, $bytes.Length)
        $stream.ReadTimeout = 4000
        $reader = New-Object IO.StreamReader($stream)
        $ack = $reader.ReadLine()
        $ok = ($ack -eq 'OK')
        Write-TransferDebug $(if ($ok) { 'chat.invite.accepted' } else { 'chat.invite.failed' }) @{ target = $Person.Display; address = $Person.IP; port = $Person.Port; room = $Room; ack = $ack }
        return $ok
    } catch {
        Write-TransferDebug 'chat.invite.failed' @{ target = $Person.Display; address = $Person.IP; port = $Person.Port; error = $_.Exception.Message }
        return $false
    }
    finally { try { $client.Close() } catch { } }
}

function Start-ChatWith {
    param($People, [string]$Text)
    $listener = New-SlipTcpListener
    $port = ([Net.IPEndPoint]$listener.LocalEndpoint).Port
    $room = ([guid]::NewGuid().ToString('N')).Substring(0, 8)
    $reached = @()
    $missed = @()
    foreach ($person in @($People)) {
        if (Invoke-ChatInvite -Person $person -Room $room -HostPort $port -Text $Text) { $reached += $person }
        else { $missed += $person }
    }
    Write-TransferDebug 'chat.start.summary' @{ room = $room; reached = $reached.Count; missed = $missed.Count; hostPort = $port }
    $names = @($reached | ForEach-Object { $_.Display })
    $title = if ($names.Count -gt 0) { $names -join ', ' } else { 'waiting' }
    if ($missed.Count -gt 0) {
        Write-Host ("Could not open chat on: {0}" -f (($missed | ForEach-Object { $_.Display }) -join ', ')) -ForegroundColor Yellow
        Start-Sleep -Seconds 1
    }
    Show-ChatSession -Room $room -Title $title -Listener $listener -OpeningFrom (Get-DisplayName) -OpeningText $Text -IsHost
}

function Show-StartChat {
    Clear-Host
    Write-Host 'Chat' -ForegroundColor Cyan
    Write-Host ("Version {0}" -f $script:Version) -ForegroundColor DarkGray
    Write-Host ''
    Write-Host 'Looking for PCs with Auto chat...'
    $mine = @(Get-LanIPv4 -IncludeVirtual)
    $people = @()
    try {
        $people = @(Receive-Beacons -Seconds 3 | Where-Object {
            $_.Token -eq 'CHAT' -and $_.Port -gt 0 -and ($mine -notcontains $_.IP)
        })
    } catch { $people = @() }
    Write-TransferDebug 'chat.discovery' @{ found = $people.Count }
    if ($people.Count -eq 0) {
        Write-Host 'No other PC with Auto chat was found.' -ForegroundColor Yellow
        Write-Host 'That PC needs Slip installed. Auto chat is on unless it was turned off.'
        Wait-Enter
        return
    }
    $picked = Show-ChatPeople $people
    if (-not $picked) { return }
    $text = Read-Host 'Message'
    if ([string]::IsNullOrWhiteSpace($text)) {
        Write-Host 'Type a message to open the chat.' -ForegroundColor Yellow
        Wait-Enter
        return
    }
    # Open the chat in its own Command Prompt window so this Slip window stays on
    # the menu. The host listener, invites, and session all run in that window.
    $slim = @($picked | ForEach-Object { @{ IP = $_.IP; Port = $_.Port; Display = $_.Display; Windows = $_.Windows } })
    $json = ConvertTo-Json $slim -Compress -Depth 4
    $peopleB64 = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($json))
    $openB64 = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($text.Trim()))
    Start-ChatConsole -EntryArgs ("chathost -PeopleB64 {0} -OpeningB64 {1}" -f $peopleB64, $openB64) -Title 'Slip chat'
    Write-Host 'Chat opened in a new window.' -ForegroundColor Green
    Start-Sleep -Milliseconds 700
}

function Show-FoldersMenu {
