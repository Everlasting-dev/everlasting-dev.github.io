function Get-OctaneMachineId {
    $guid = $null
    try { $guid = (Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Cryptography' -Name MachineGuid -ErrorAction Stop).MachineGuid } catch { $guid = $env:COMPUTERNAME }
    $bytes = [Text.Encoding]::UTF8.GetBytes(("{0}:{1}" -f $script:OctaneMachineSalt, ([string]$guid).ToLowerInvariant()))
    $sha = [Security.Cryptography.SHA256]::Create()
    try { return (($sha.ComputeHash($bytes) | ForEach-Object { $_.ToString('x2') }) -join '') } finally { $sha.Dispose() }
}

function Get-OctaneApiError {
    param($ErrorRecord)
    $msg = $ErrorRecord.Exception.Message
    try {
        $body = $ErrorRecord.ErrorDetails.Message
        if ($body) {
            $j = $body | ConvertFrom-Json
            if ($j.error_description) { return $j.error_description }
            if ($j.msg) { return $j.msg }
            if ($j.message) { return $j.message }
        }
    } catch { }
    return $msg
}

function Connect-OctaneAccount {
    param([switch]$Owner)
    if ($script:OctaneSession -and $script:OctaneSession.Expires -gt (Get-Date).AddMinutes(2)) {
        if (-not $Owner -or $script:OctaneSession.IsOwner) { return $script:OctaneSession }
    }
    Write-Host ''
    Write-Host ($(if ($Owner) { 'Sign in with the Octane owner account.' } else { 'Sign in with your Octane account.' })) -ForegroundColor Cyan
    $email = Read-Host 'Email'
    if ([string]::IsNullOrWhiteSpace($email)) { return $null }
    $secure = Read-Host 'Password' -AsSecureString
    $bstr = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($secure)
    try { $plain = [Runtime.InteropServices.Marshal]::PtrToStringBSTR($bstr) } finally { [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($bstr) }
    $body = @{ email = $email.Trim(); password = $plain } | ConvertTo-Json
    $plain = $null
    try {
        $res = Invoke-RestMethod -Method Post -Uri "$($script:OctaneSupabaseUrl)/auth/v1/token?grant_type=password" -Headers @{ apikey = $script:OctaneAnonKey } -ContentType 'application/json' -Body $body -TimeoutSec 20
    } catch {
        Write-Host ("Sign-in failed: {0}" -f (Get-OctaneApiError $_)) -ForegroundColor Red
        return $null
    }
    $session = [pscustomobject]@{
        Token = $res.access_token
        UserId = [string]$res.user.id
        Email = [string]$res.user.email
        Expires = (Get-Date).AddSeconds([int]$res.expires_in)
        IsOwner = $false
        License = $null
    }
    $script:OctaneSession = $session
    $lic = Invoke-OctaneLicenseClaim
    if ($lic) {
        $session.License = $lic
        $session.IsOwner = [bool]$lic.is_owner
    }
    if ($Owner -and -not $session.IsOwner) {
        Write-Host 'That account is not the Octane owner.' -ForegroundColor Red
        return $null
    }
    Write-Host ("Signed in as {0}." -f $session.Email) -ForegroundColor Green
    return $session
}

