}

function Show-UpgradeScreen {
    Clear-Host
    Write-Host 'Upgrade' -ForegroundColor Cyan
    Write-Host ("Version {0}" -f $script:Version) -ForegroundColor DarkGray
    Write-Host ''
    Write-Host 'Upgrade downloads the current Slip script and refreshes this PC.'
    Write-Host 'Outbox, Inbox, chat logs, and the display name stay.' -ForegroundColor Green
    Write-Host ''
    $answer = Read-Host '[Y] Upgrade  [N] Back'
    if ($answer -notmatch '^[Yy]') { return }
    $payload = Join-Path $env:TEMP 'slip-upgrade.ps1'
    Write-Host ''
    try {
        Invoke-RestMethod -Uri $script:SourceUrl -OutFile $payload -ErrorAction Stop
        $quick = if (Test-QuickReceive) { '-QuickReceive' } else { '' }
        $arg = "-NoProfile -ExecutionPolicy Bypass -File `"$payload`" upgrade $quick -Quiet".Trim()
        $env:SLIP_FETCHED_UPGRADE = '1'
        $proc = Start-Process -FilePath powershell.exe -ArgumentList $arg -Wait -PassThru -WindowStyle Hidden
        Remove-Item Env:SLIP_FETCHED_UPGRADE -ErrorAction SilentlyContinue
        if ($proc.ExitCode -eq 0) { Write-Host 'Upgrade finished.' -ForegroundColor Green }
        else { Write-Host "Upgrade stopped (exit $($proc.ExitCode))." -ForegroundColor Yellow }
    } catch {
        Write-Host $_.Exception.Message -ForegroundColor Red
    } finally {
        Remove-Item -LiteralPath $payload -Force -ErrorAction SilentlyContinue
    }
    Wait-Enter
}

function Get-OnlineSlipVersion {
    # Downloads the published script and returns @{ Version; Path; Bytes }, or
    # $null when it cannot be reached. The caller removes the temp file.
    $tmp = Join-Path $env:TEMP ("{0}-online.ps1" -f $script:CommandName)
    Remove-Item -LiteralPath $tmp -Force -ErrorAction SilentlyContinue
    try { [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12 } catch { }
    try {
        Invoke-RestMethod -Uri $script:SourceUrl -OutFile $tmp -ErrorAction Stop
    } catch {
        return $null
    }
    if (-not (Test-Path -LiteralPath $tmp)) { return $null }
    $ver = 'unknown'
    try {
        $text = [IO.File]::ReadAllText($tmp)
        $m = [regex]::Match($text, "\`$script:Version\s*=\s*'([^']+)'")
        if ($m.Success) { $ver = $m.Groups[1].Value }
    } catch { }
    return @{ Version = $ver; Path = $tmp; Bytes = (Get-Item -LiteralPath $tmp).Length }
}

function Get-UpdateReminderPath { Join-Path (Get-SlipRoot) 'update-reminder.json' }

function Get-UpdateReminderState {
    $state = [pscustomobject]@{
        Enabled = $false
        Time = '18:00'
        LastCheckedUtc = ''
        LastNotifiedVersion = ''
    }
    $path = Get-UpdateReminderPath
    if (-not (Test-Path -LiteralPath $path)) { return $state }
    try {
        $saved = Get-Content -LiteralPath $path -Raw -ErrorAction Stop | ConvertFrom-Json
        if ($null -ne $saved.Enabled) { $state.Enabled = [bool]$saved.Enabled }
        if ([string]$saved.Time -match '^([01]?\d|2[0-3]):[0-5]\d$') { $state.Time = [string]$saved.Time }
        if ($saved.LastCheckedUtc) { $state.LastCheckedUtc = [string]$saved.LastCheckedUtc }
        if ($saved.LastNotifiedVersion) { $state.LastNotifiedVersion = [string]$saved.LastNotifiedVersion }
    } catch { }
    return $state
}

function Save-UpdateReminderState {
    param($State)
    $root = Get-SlipRoot
    if (-not (Test-Path -LiteralPath $root)) { New-Item -ItemType Directory -Force -Path $root | Out-Null }
    $State | ConvertTo-Json -Compress | Set-Content -LiteralPath (Get-UpdateReminderPath) -Encoding UTF8
}

function Get-UpdateReminderCommandLine {
    return (Get-BackgroundCommandLine 'updatecheck')
}

function Test-UpdateReminderTask {
    try {
        $null = Get-ScheduledTask -TaskName (Get-UpdateReminderTaskName) -ErrorAction Stop
        return $true
    } catch { return $false }
}

function Register-UpdateReminderTask {
    $state = Get-UpdateReminderState
    if (-not $state.Enabled) { return $false }
    try {
        Install-BackgroundLauncher
        $action = New-ScheduledTaskAction -Execute (Get-BackgroundLauncherPath) -Argument 'updatecheck'
        $trigger = New-ScheduledTaskTrigger -Daily -At $state.Time
        $settings = New-ScheduledTaskSettingsSet -StartWhenAvailable -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries
        $userId = [Security.Principal.WindowsIdentity]::GetCurrent().Name
        $principal = New-ScheduledTaskPrincipal -UserId $userId -LogonType Interactive -RunLevel Limited
        Register-ScheduledTask -TaskName (Get-UpdateReminderTaskName) -Action $action -Trigger $trigger -Settings $settings -Principal $principal -Force -ErrorAction Stop | Out-Null
    } catch {
        Write-SlipLog "Update reminder task failed: $($_.Exception.Message)"
        return $false
    }
    Write-SlipLog "Update reminder scheduled daily at $($state.Time)."
    return $true
}

function Remove-UpdateReminderTask {
    Unregister-ScheduledTask -TaskName (Get-UpdateReminderTaskName) -Confirm:$false -ErrorAction SilentlyContinue
}

function Test-NewerSlipVersion {
    param([string]$Online, [string]$Installed)
    try { return ([version]$Online -gt [version]$Installed) } catch { return ($Online -and $Online -ne 'unknown' -and $Online -ne $Installed) }
}

function Start-UpdateNotice {
    param([string]$OnlineVersion)
    $safeVersion = ($OnlineVersion -replace '[^0-9A-Za-z.\-]', '')
    if (-not $safeVersion) { return }
    $scriptPath = Get-InstalledScriptPath
    $inner = 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "{0}" updatenotice -OnlineVersion {1}' -f $scriptPath, $safeVersion
    Start-Process -FilePath $env:ComSpec -ArgumentList ('/c title Slip update available & ' + $inner) -WindowStyle Normal | Out-Null
}

function Invoke-UpdateReminderCheck {
    param([switch]$Interactive)
    $state = Get-UpdateReminderState
    if (-not $Interactive -and -not $state.Enabled) {
        return [pscustomobject]@{ Status = 'disabled'; Installed = $script:Version; Online = ''; Detail = 'Update reminders are off.' }
    }
    $state.LastCheckedUtc = [DateTime]::UtcNow.ToString('o')
    $online = Get-OnlineSlipVersion
    if (-not $online) {
        Save-UpdateReminderState $state
        return [pscustomobject]@{ Status = 'offline'; Installed = $script:Version; Online = ''; Detail = 'The update site could not be reached.' }
    }
    try {
        if ($online.Version -eq 'unknown') {
            Save-UpdateReminderState $state
            return [pscustomobject]@{ Status = 'unknown'; Installed = $script:Version; Online = ''; Detail = 'The online version could not be read.' }
        }
        if (Test-NewerSlipVersion -Online $online.Version -Installed $script:Version) {
            $alreadyNotified = $state.LastNotifiedVersion -eq $online.Version
            if ($Interactive -or -not $alreadyNotified) { $state.LastNotifiedVersion = $online.Version }
            Save-UpdateReminderState $state
            if (-not $Interactive -and -not $alreadyNotified) { Start-UpdateNotice -OnlineVersion $online.Version }
            return [pscustomobject]@{ Status = 'available'; Installed = $script:Version; Online = $online.Version; Detail = 'An update is available.' }
        }
        Save-UpdateReminderState $state
        return [pscustomobject]@{ Status = 'current'; Installed = $script:Version; Online = $online.Version; Detail = 'Slip is up to date.' }
    } finally {
        if ($online.Path) { Remove-Item -LiteralPath $online.Path -Force -ErrorAction SilentlyContinue }
    }
}

function Show-UpdateNotice {
    param([string]$OnlineVersion)
    Clear-Host
    Write-Host 'Slip update available' -ForegroundColor Cyan
    Write-Host ''
    Write-Host ("Installed: {0}" -f $script:Version)
    Write-Host ("Available: {0}" -f $OnlineVersion) -ForegroundColor Green
    Write-Host ''
    Write-Host 'Open Slip, then choose Help & troubleshooting > Check and fix.'
    Write-Host 'The reminder never installs an update by itself.' -ForegroundColor DarkGray
    Wait-Enter
}

function Read-UpdateReminderTime {
    param([string]$Current)
    while ($true) {
        $entered = Read-Host ("Daily check time (24-hour HH:mm, Enter keeps {0})" -f $Current)
        if ([string]::IsNullOrWhiteSpace($entered)) { return $Current }
        $parsed = [DateTime]::MinValue
        $formats = [string[]]@('H:mm', 'HH:mm')
        if ([DateTime]::TryParseExact($entered.Trim(), $formats, [Globalization.CultureInfo]::InvariantCulture, [Globalization.DateTimeStyles]::None, [ref]$parsed)) {
            return $parsed.ToString('HH:mm')
        }
        Write-Host 'Use a time such as 09:30 or 18:00.' -ForegroundColor Yellow
    }
}

function Show-UpdateReminderScreen {
    while ($true) {
        $state = Get-UpdateReminderState
        $status = if ($state.Enabled) { "Daily at $($state.Time)" } else { 'Off' }
        $items = if ($state.Enabled) { @('Check now', 'Change daily time', 'Turn reminders off') } else { @('Check now', 'Turn on daily reminders') }
        $descs = if ($state.Enabled) {
            @('Look online for a newer Slip right now.', 'Pick the time of day the quiet check runs.', 'Stop the daily update check.')
        } else {
            @('Look online for a newer Slip right now.', 'Check once a day and tell you when a new version exists. Nothing installs by itself.')
        }
        $pick = Read-ArrowMenu -Title 'Update reminders' -Lines @(
            ("Status: {0}" -f $status),
            'Checks quietly and only alerts once for each new version.',
            'Updates are never installed automatically.'
        ) -Items $items -Descriptions $descs -ZeroLabel 'Back'
        if ($pick -lt 0) { return }
        if ($pick -eq 0) {
            Clear-Host
            Write-Host 'Checking for updates...' -ForegroundColor Cyan
            $result = Invoke-UpdateReminderCheck -Interactive
            Write-Host ''
            if ($result.Status -eq 'available') {
                Write-Host ("Slip {0} is available. Installed: {1}." -f $result.Online, $result.Installed) -ForegroundColor Green
                Write-Host 'Use Help & troubleshooting > Check and fix when you are ready.'
            } elseif ($result.Status -eq 'current') {
                Write-Host ("Slip {0} is up to date." -f $result.Installed) -ForegroundColor Green
            } else {
                Write-Host $result.Detail -ForegroundColor Yellow
            }
            Wait-Enter
            continue
        }
        if (-not $state.Enabled -and $pick -eq 1) {
            $state.Time = Read-UpdateReminderTime -Current $state.Time
            $state.Enabled = $true
            Save-UpdateReminderState $state
            if (Register-UpdateReminderTask) { Write-Host ("Update reminders are on for {0} daily." -f $state.Time) -ForegroundColor Green }
            else {
                $state.Enabled = $false
                Save-UpdateReminderState $state
                Write-Host 'Windows did not create the reminder task.' -ForegroundColor Yellow
            }
            Wait-Enter
            continue
        }
        if ($state.Enabled -and $pick -eq 1) {
            $oldTime = $state.Time
            $state.Time = Read-UpdateReminderTime -Current $state.Time
            Save-UpdateReminderState $state
            if (Register-UpdateReminderTask) { Write-Host ("Daily reminder changed to {0}." -f $state.Time) -ForegroundColor Green }
            else {
                $state.Time = $oldTime
                Save-UpdateReminderState $state
                [void](Register-UpdateReminderTask)
                Write-Host 'Windows did not update the reminder task. The previous time was kept.' -ForegroundColor Yellow
            }
            Wait-Enter
            continue
        }
        if ($state.Enabled -and $pick -eq 2) {
            $state.Enabled = $false
            Save-UpdateReminderState $state
            Remove-UpdateReminderTask
            Write-Host 'Update reminders are off.' -ForegroundColor Green
            Wait-Enter
        }
    }
}

function Repair-SlipStartupEntries {
    # Re-writes the command and startup registry entries when they are missing or
    # wrong. Returns the list of things it had to fix.
    $fixed = @()
    $sendToWasMissing = -not (Test-Path -LiteralPath (Get-SendToShortcutPath))
    # Reinforce like Repair does: recreate folders, refresh the profile and the
    # slip command, then reconcile the startup registry entries below.
    try { Ensure-SlipFiles | Out-Null } catch { try { Install-SlipCommand | Out-Null } catch { } }
    if ($sendToWasMissing -and (Test-Path -LiteralPath (Get-SendToShortcutPath))) { $fixed += 'Send To shortcut' }
    $runPath = 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Run'
    $scriptPath = Get-InstalledScriptPath
    if (Test-AutoChat) {
        $expected = Get-BackgroundCommandLine 'chatlisten'
        $have = $null
        try { $have = [string](Get-ItemPropertyValue -LiteralPath $runPath -Name (Get-ChatRunName) -ErrorAction Stop) } catch { }
        if ($have -ne $expected) {
            Enable-AutoChat -Quiet | Out-Null
            $fixed += 'Auto chat startup'
        }
    }
    if (Test-QuickReceive) {
        $expected = Get-QuickReceiveCommandLine
        $have = $null
        try { $have = [string](Get-ItemPropertyValue -LiteralPath $runPath -Name (Get-QuickRunName) -ErrorAction Stop) } catch { }
        if ($have -ne $expected) {
            [void](Set-QuickReceiveRunKey)
            $fixed += 'Quick receive startup'
        }
    }
    if (Test-RemoteHelp) {
        $expected = Get-RemoteHelpCommandLine
        $have = $null
        try { $have = [string](Get-ItemPropertyValue -LiteralPath $runPath -Name (Get-RemoteHelpRunName) -ErrorAction Stop) } catch { }
        if ($have -ne $expected -or -not (Test-RemoteHelpListenerAlive)) {
            Enable-RemoteHelp -Quiet | Out-Null
            $fixed += 'Remote help startup'
        }
    }
    $updateState = Get-UpdateReminderState
    if ($updateState.Enabled) {
        if (Register-UpdateReminderTask) { $fixed += 'Update reminder task' }
    }
    return @($fixed)
}

function Write-HealStep {
    param([string]$Text)
    Write-Host ("  - {0} ... " -f $Text) -NoNewline
}

function Write-HealResult {
    param([string]$Status, [string]$Detail)
    $color = switch ($Status) {
        'ok'     { [ConsoleColor]::Green }
        'fixed'  { [ConsoleColor]::Green }
        'warn'   { [ConsoleColor]::Yellow }
        'failed' { [ConsoleColor]::Red }
        default  { [ConsoleColor]::Gray }
    }
    $label = switch ($Status) {
        'ok'     { 'OK' }
        'fixed'  { 'FIXED' }
        'warn'   { 'CHECK' }
        'failed' { 'FAILED' }
        default  { $Status }
    }
    if ($Detail) { Write-Host ("{0} - {1}" -f $label, $Detail) -ForegroundColor $color }
    else { Write-Host $label -ForegroundColor $color }
}

function Invoke-SlipSelfHeal {
    # Runs every check in order, printing progress as it goes so the window never
    # looks frozen, and returns an ordered report list.
    $report = New-Object System.Collections.ArrayList
    $didUpdate = $false
    function Add-HealReport($name, $status, $detail) {
        [void]$report.Add([pscustomobject]@{ Name = $name; Status = $status; Detail = $detail })
    }

    # 1) Version and update
    Write-HealStep 'Checking for the latest version'
    $online = Get-OnlineSlipVersion
    if (-not $online) {
        Write-HealResult 'warn' 'update site unreachable (offline?)'
        Add-HealReport 'Update' 'warn' 'Update site unreachable'
    }
    elseif ($online.Version -eq 'unknown') {
        Write-HealResult 'warn' 'downloaded, but its version could not be read'
        Add-HealReport 'Update' 'warn' 'Online version unreadable'
    }
    elseif (-not (Test-NewerSlipVersion -Online $online.Version -Installed $script:Version)) {
        Write-HealResult 'ok' ("already on {0}" -f $script:Version)
        Add-HealReport 'Update' 'ok' ("Latest ({0})" -f $script:Version)
    }
    else {
        Write-HealResult 'fixed' ("{0} -> {1}, installing" -f $script:Version, $online.Version)
        Write-HealStep ("Installing {0}" -f $online.Version)
        $code = 1
        try {
            $env:SLIP_FETCHED_UPGRADE = '1'
            # Redirect the child's output so it cannot leak into this function's
            # return value; $LASTEXITCODE still reflects the child's exit code.
            & powershell.exe -NoProfile -ExecutionPolicy Bypass -File $online.Path upgrade -Quiet 2>&1 | Out-Null
            $code = $LASTEXITCODE
        } catch { $code = 1 }
        finally { Remove-Item Env:SLIP_FETCHED_UPGRADE -ErrorAction SilentlyContinue }
        if ($code -eq 0) {
            $didUpdate = $true
            Write-HealResult 'fixed' ("installed {0} - reopen Slip to use it" -f $online.Version)
            Add-HealReport 'Update' 'fixed' ("Updated to {0}; reopen Slip" -f $online.Version)
        } else {
            Write-HealResult 'failed' 'the update did not finish'
            Add-HealReport 'Update' 'failed' 'Update did not finish'
        }
    }
    if ($online -and $online.Path) { Remove-Item -LiteralPath $online.Path -Force -ErrorAction SilentlyContinue }

    # 2) Script policy (enable running scripts)
    Write-HealStep 'Checking PowerShell script policy'
    try {
        $pol = Set-SlipScriptPolicy -Quiet
        if ($pol.Locked) {
            Write-HealResult 'warn' 'a Group Policy forces a stricter setting'
            Add-HealReport 'Script policy' 'warn' (($pol.Notes) -join '; ')
        } elseif ($pol.Changed.Count -gt 0) {
            Write-HealResult 'fixed' (($pol.Changed) -join '; ')
            Add-HealReport 'Script policy' 'fixed' (($pol.Changed) -join '; ')
        } else {
            Write-HealResult 'ok' 'local scripts already allowed'
            Add-HealReport 'Script policy' 'ok' 'Local scripts allowed'
        }
    } catch {
        Write-HealResult 'failed' $_.Exception.Message
        Add-HealReport 'Script policy' 'failed' $_.Exception.Message
    }

    # 3) Files, command, and startup registry entries (reinforced like Repair)
    Write-HealStep 'Reinforcing files, command, and startup entries'
    if ($didUpdate) {
        # The update just reinstalled the command, profile, and startup entries.
        Write-HealResult 'ok' 'reinstalled by the update'
        Add-HealReport 'Startup entries' 'ok' 'Reinstalled by update'
    } else {
    try {
        $entryFix = Repair-SlipStartupEntries
        if ($entryFix.Count -gt 0) {
            Write-HealResult 'fixed' ("re-added: {0}" -f ($entryFix -join ', '))
            Add-HealReport 'Startup entries' 'fixed' ("Re-added: {0}" -f ($entryFix -join ', '))
        } else {
            Write-HealResult 'ok' 'command and startup entries in place'
            Add-HealReport 'Startup entries' 'ok' 'In place'
        }
    } catch {
        Write-HealResult 'failed' $_.Exception.Message
        Add-HealReport 'Startup entries' 'failed' $_.Exception.Message
    }
    }

    # 4+5) Firewall rules and network type. Both can need admin; when they do and
    # this PC is not elevated, one 'fixnet' prompt covers adding the rules AND
    # making the network Private, so the user sees a single approval.
    Write-HealStep 'Checking firewall rules and network type'
    $haveFw = (Test-FirewallRule $script:RuleTcp) -and (Test-FirewallRule $script:RuleUdp)
    $notConnected = @(Get-ActiveNetworkProfiles).Count -eq 0
    $isPublic = (-not $notConnected) -and (@(Get-PublicNetworkProfiles).Count -gt 0)
    $needAdmin = (-not $haveFw) -or $isPublic
    if ($needAdmin) {
        if (Test-IsAdmin) {
            if (-not $haveFw) { try { Install-FirewallRules } catch { } }
            if ($isPublic) { try { [void](Set-ActiveNetworksPrivate) } catch { } }
        } else {
            [void](Invoke-ElevatedEntry -Entry 'fixnet')
        }
        Write-HealResult 'fixed' 'applied firewall / network fixes'
    } else {
        Write-HealResult 'ok' 'nothing to change'
    }

    # Report firewall and network separately from the current state.
    Write-HealStep 'Firewall rules'
    $haveFw = (Test-FirewallRule $script:RuleTcp) -and (Test-FirewallRule $script:RuleUdp)
    if ($haveFw) {
        Write-HealResult 'ok' 'both rules present'
        Add-HealReport 'Firewall' 'ok' 'Both rules present'
    } else {
        Write-HealResult 'failed' 'rules still missing (permission denied?)'
        Add-HealReport 'Firewall' 'failed' 'Rules missing'
    }

    Write-HealStep 'Network type'
    $active = @(Get-ActiveNetworkProfiles)
    $public = @(Get-PublicNetworkProfiles)
    if ($active.Count -eq 0) {
        Write-HealResult 'warn' 'this PC is not on a network'
        Add-HealReport 'Network' 'warn' 'Not connected'
    } elseif ($public.Count -gt 0) {
        Write-HealResult 'failed' 'still Public (permission denied?)'
        Add-HealReport 'Network' 'failed' 'Still Public'
    } else {
        Write-HealResult 'ok' 'Private'
        Add-HealReport 'Network' 'ok' 'Private'
    }

    return @($report)
}

function Show-SelfHealScreen {
    Clear-Host
    Write-Host 'Check and fix' -ForegroundColor Cyan
    Write-Host ("Version {0}" -f $script:Version) -ForegroundColor DarkGray
    Write-Host ''
    Write-Host 'This checks the version, script policy, startup entries, and firewall,'
    Write-Host 'and fixes anything it can. Windows may ask for permission for the firewall.'
    Write-Host ''
    $report = @(Invoke-SlipSelfHeal)
    Write-Host ''
    Write-Host 'Report' -ForegroundColor Cyan
    $bad = 0
    foreach ($row in $report) {
        $color = switch ($row.Status) {
            'ok'     { [ConsoleColor]::Green }
            'fixed'  { [ConsoleColor]::Green }
            'warn'   { [ConsoleColor]::Yellow }
            'failed' { [ConsoleColor]::Red }
            default  { [ConsoleColor]::Gray }
        }
        if ($row.Status -eq 'warn' -or $row.Status -eq 'failed') { $bad++ }
        $label = switch ($row.Status) {
            'ok'     { 'OK' }
            'fixed'  { 'FIXED' }
            'warn'   { 'CHECK' }
            'failed' { 'FAILED' }
            default  { $row.Status }
        }
        Write-Host ("  {0,-16} {1,-7} {2}" -f $row.Name, $label, $row.Detail) -ForegroundColor $color
    }
    Write-Host ''
    if ($bad -eq 0) {
        Write-Host 'Everything looks good.' -ForegroundColor Green
    } else {
        Write-Host ("{0} item(s) need attention - see the lines marked CHECK or FAILED above." -f $bad) -ForegroundColor Yellow
    }
    Wait-Enter
}

