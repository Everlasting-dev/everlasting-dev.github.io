function Send-PresenceBeacon {
    param([string]$Kind, [int]$Port)
    $payload = '{0}|{1}|{2}|{3}|{4}|0|{5}' -f $script:BeaconPrefix, $Kind, $Port, (ConvertTo-BeaconField (Get-DisplayName)), (ConvertTo-BeaconField $env:COMPUTERNAME), $Kind.ToLower()
    return (Send-BeaconPayload -Payload $payload -Port $script:BeaconPort)
}

function Start-PresenceLoop {
    $stopFile = Join-Path $env:TEMP ("{0}-presence-{1}.stop" -f $script:CommandName, $PID)
    if (Test-Path -LiteralPath $stopFile) { Remove-Item -LiteralPath $stopFile -Force }
    $scriptPath = Get-InstalledScriptPath
    if (-not (Test-Path -LiteralPath $scriptPath) -and $PSCommandPath) { $scriptPath = $PSCommandPath }
    $ps = [PowerShell]::Create()
    [void]$ps.AddScript({
        param($StopFile, $Name, $Computer, $BeaconPort, $Prefix, $Helpers, $ScriptPath, $PortFirst, $PortLast)
        . ([scriptblock]::Create($Helpers))
        $listener = $null
        $ctrl = 0
        foreach ($candidate in $PortFirst..$PortLast) {
            $tryListen = $null
            try {
                $tryListen = New-Object System.Net.Sockets.TcpListener ([Net.IPAddress]::Any, $candidate)
                $tryListen.Start()
                $listener = $tryListen
                $ctrl = $candidate
                break
            } catch {
                if ($tryListen) { try { $tryListen.Stop() } catch { } }
            }
        }
        try {
            while (-not (Test-Path -LiteralPath $StopFile)) {
                $payload = '{0}|OPEN|{1}|{2}|{3}|0|open' -f $Prefix, $ctrl, $Name, $Computer
                try { [void](Send-BeaconPayload -Payload $payload -Port $BeaconPort) } catch { }
                if ($listener -and $listener.Pending()) {
                    $client = $null
                    try {
                        $client = $listener.AcceptTcpClient()
                        $stream = $client.GetStream()
                        $stream.ReadTimeout = 3000
                        $reader = New-Object System.IO.StreamReader($stream, [Text.Encoding]::ASCII, $false, 256, $true)
                        $line = $reader.ReadLine()
                        $which = ''
                        if ($line -match '^(?i)ENABLE\s+(chat|quick)$') { $which = $Matches[1].ToLower() }
                        $reply = "NO`n"
                        if ($which) {
                            $entry = if ($which -eq 'chat') { 'enablechat' } else { 'enablequick' }
                            $arg = '-NoProfile -ExecutionPolicy Bypass -File "{0}" {1}' -f $ScriptPath, $entry
                            $proc = Start-Process -FilePath powershell.exe -ArgumentList $arg -WindowStyle Hidden -PassThru -Wait
                            if ($proc.ExitCode -eq 0) { $reply = "OK`n" } else { $reply = "FAIL`n" }
                        }
                        $bytes = [Text.Encoding]::ASCII.GetBytes($reply)
                        $stream.Write($bytes, 0, $bytes.Length)
                        $stream.Flush()
                    } catch { }
                    finally { if ($client) { try { $client.Close() } catch { } } }
                }
                $left = 10
                while ($left -gt 0 -and -not (Test-Path -LiteralPath $StopFile)) {
                    if ($listener -and $listener.Pending()) { break }
                    Start-Sleep -Milliseconds 100
                    $left--
                }
            }
        } finally {
            if ($listener) { try { $listener.Stop() } catch { } }
        }
    }).AddArgument($stopFile).AddArgument((ConvertTo-BeaconField (Get-DisplayName))).AddArgument((ConvertTo-BeaconField $env:COMPUTERNAME)).AddArgument($script:BeaconPort).AddArgument($script:BeaconPrefix).AddArgument($script:NetHelpers.ToString()).AddArgument($scriptPath).AddArgument($script:PortFirst).AddArgument($script:PortLast)
    $handle = $ps.BeginInvoke()
    return @{ PowerShell = $ps; Handle = $handle; StopFile = $stopFile }
}

function Stop-PresenceLoop {
    param($Loop)
    if (-not $Loop) { return }
    try { Set-Content -LiteralPath $Loop.StopFile -Value 'stop' -Encoding ASCII } catch { }
    $deadline = (Get-Date).AddSeconds(3)
    while (-not $Loop.Handle.IsCompleted -and (Get-Date) -lt $deadline) {
        Start-Sleep -Milliseconds 100
    }
    try {
        if ($Loop.Handle.IsCompleted) { $Loop.PowerShell.EndInvoke($Loop.Handle) | Out-Null }
    } catch { }
    try { $Loop.PowerShell.Dispose() } catch { }
    Remove-Item -LiteralPath $Loop.StopFile -Force -ErrorAction SilentlyContinue
}

function Start-QuickReceiveTask {
    $taskName = Get-QuickTaskName
    $taskRun = Get-QuickReceiveCommandLine
    $output = & schtasks.exe /Create /TN $taskName /SC ONLOGON /RL LIMITED /F /TR $taskRun 2>&1
    if ($LASTEXITCODE -ne 0) {
        $text = (@($output) -join ' ').Trim()
        if (-not $text) { $text = "exit code $LASTEXITCODE" }
        Write-SlipLog "Quick receive scheduled task failed: $text"
        return $false
    }
    Write-SlipLog 'Quick receive scheduled task registered.'
    return $true
}

function Set-QuickReceiveRunKey {
    $runPath = 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Run'
    $name = Get-QuickRunName
    $value = Get-QuickReceiveCommandLine
    try {
        if (-not (Test-Path -LiteralPath $runPath)) {
            New-Item -Path $runPath -Force | Out-Null
        }
        New-ItemProperty -LiteralPath $runPath -Name $name -Value $value -PropertyType String -Force | Out-Null
        Write-SlipLog 'Quick receive startup entry registered.'
        return $true
    } catch {
        Write-SlipLog "Quick receive startup entry failed: $($_.Exception.Message)"
        return $false
    }
}

function Find-OpenTransferPort {
    param([string]$Address)
    foreach ($candidate in $script:PortFirst..$script:PortLast) {
        if (Test-TcpOpen $Address $candidate) { return $candidate }
    }
    return 0
}

function Read-QuickReceiveTargetByIp {
    $ip = Read-Host 'Quick receive IP'
    if ([string]::IsNullOrWhiteSpace($ip)) { return $null }
    $ip = $ip.Trim()
    Write-Host "Checking $ip..." -ForegroundColor DarkGray
    $port = Find-OpenTransferPort -Address $ip
    if ($port -le 0) {
        Write-Host 'No Quick receive port answered on that IP.' -ForegroundColor Yellow
        Write-Host 'On that PC, run the updater or turn Quick receive off and on, then try again.'
        Wait-Enter
        return $null
    }
    return [pscustomobject]@{
        IP = $ip
        Port = $port
        Display = $ip
        Windows = 'manual'
    }
}

