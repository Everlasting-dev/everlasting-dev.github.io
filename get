function Get-UniqueFilePath {
    param([string]$Directory, [string]$Name)
    $leaf = [IO.Path]::GetFileName($Name)
    if (-not $leaf) { $leaf = "$($script:AppName)-download" }
    $dest = Join-Path $Directory $leaf
    $base = [IO.Path]::GetFileNameWithoutExtension($leaf)
    $ext = [IO.Path]::GetExtension($leaf)
    $i = 1
    while (Test-Path -LiteralPath $dest) {
        $dest = Join-Path $Directory ("{0} ({1}){2}" -f $base, $i, $ext)
        $i++
    }
    return $dest
}

function Save-RemoteFile {
    param([string]$Url, [string]$Directory)
    Add-Type -AssemblyName System.Net.Http
    if (-not (Test-Path -LiteralPath $Directory)) {
        New-Item -ItemType Directory -Force -Path $Directory | Out-Null
    }
    $client = New-Object System.Net.Http.HttpClient
    $client.Timeout = [TimeSpan]::FromHours(6)
    try {
        $resp = $client.GetAsync($Url, [System.Net.Http.HttpCompletionOption]::ResponseHeadersRead).GetAwaiter().GetResult()
        if (-not $resp.IsSuccessStatusCode) {
            $errText = ''
            try { $errText = $resp.Content.ReadAsStringAsync().GetAwaiter().GetResult() } catch {}
            throw "Download failed ($([int]$resp.StatusCode)). $errText"
        }
        $total = $resp.Content.Headers.ContentLength
        $disposition = $resp.Content.Headers.ContentDisposition
        $name = $null
        if ($disposition) {
            if ($disposition.FileNameStar) { $name = $disposition.FileNameStar.Trim('"') }
            elseif ($disposition.FileName) { $name = $disposition.FileName.Trim('"') }
        }
        if (-not $name) { $name = "$($script:AppName)-download" }
        $dest = Get-UniqueFilePath $Directory $name
        $inputStream = $resp.Content.ReadAsStreamAsync().GetAwaiter().GetResult()
        $output = [IO.File]::Create($dest)
        try {
            $buf = New-Object byte[] (1MB)
            $readTotal = 0L
            while (($n = $inputStream.Read($buf, 0, $buf.Length)) -gt 0) {
                $output.Write($buf, 0, $n)
                $readTotal += $n
                if ($total -and $total -gt 0) {
                    $pct = [int](($readTotal * 100) / $total)
                    if ($pct -gt 100) { $pct = 100 }
                    Write-Progress -Activity 'Receiving' -Status $name -PercentComplete $pct
                }
            }
        } finally {
            $output.Dispose()
            $inputStream.Dispose()
            Write-Progress -Activity 'Receiving' -Completed
        }
        return $dest
    } finally {
        $client.Dispose()
    }
}

function Show-ReceiveFiles {
    Clear-Host
    Write-Host 'Receive files' -ForegroundColor Cyan
    Write-Host ''
    Write-Host (Get-ReceiveStepsText)
    Write-Host ''
    Write-Host 'Looking for a PC that is sending...'
    $shares = @(Receive-Beacons -Seconds 5)
    if ($shares.Count -eq 0) {
        Write-Host 'Nobody is sending right now. Start Send on the other PC, then try again.' -ForegroundColor Yellow
        Wait-Enter
        return
    }
    $chosen = $null
    if ($shares.Count -eq 1) {
        $chosen = $shares[0]
    } else {
        for ($i = 0; $i -lt $shares.Count; $i++) {
            $share = $shares[$i]
            Write-Host ("  [{0}] {1} ({2})  {3}  {4}" -f ($i + 1), $share.Display, $share.Windows, $share.File, (Format-ByteSize $share.Size))
        }
        $pick = Read-Host 'Number'
        if ($pick -notmatch '^\d+$') { return }
        $idx = [int]$pick - 1
        if ($idx -lt 0 -or $idx -ge $shares.Count) { return }
        $chosen = $shares[$idx]
    }
    $ping = Test-Icmp $chosen.IP
    $tcp = Test-TcpOpen $chosen.IP $chosen.Port
    Write-Host ''
    Write-Host ("{0} ({1})" -f $chosen.Display, $chosen.Windows)
    Write-Host ("{0}  ({1})" -f $chosen.File, (Format-ByteSize $chosen.Size))
    Write-Host ("ping {0}   transfer port {1}" -f (Format-Check $ping), (Format-Check $tcp))
    if (-not $tcp) {
        Write-Host 'The transfer port is not open from here.' -ForegroundColor Yellow
    }
    $tries = 0
    while ($tries -lt 3) {
        $pin = Read-Host 'PIN'
        if (-not $pin) { return }
        $pin = $pin.Trim()
        $url = "http://$($chosen.IP):$($chosen.Port)/d/$($chosen.Token)?pin=$([Uri]::EscapeDataString($pin))"
        try {
            $saved = Save-RemoteFile -Url $url -Directory (Get-InboxPath)
            Write-Host ''
            Write-Host "Saved to $saved" -ForegroundColor Green
            Wait-Enter
            return
        } catch {
            $tries++
            Write-Host $_.Exception.Message -ForegroundColor Red
            if ($tries -ge 3) { Wait-Enter; return }
        }
    }
}

