function Invoke-RemoveSlip {
    Clear-Host
    Write-Host 'Remove' -ForegroundColor Cyan
    Write-Host ''
    Write-Host "This removes the $($script:AppName) firewall rules and the $($script:CommandName) command."
    Write-Host 'Outbox, Inbox, and the how-to stay on disk. Files are not deleted.' -ForegroundColor Green
    Write-Host ''
    $answer = Read-Host '[Y] Remove  [N] Back'
    if ($answer -notmatch '^[Yy]') { return }
    Remove-ProfileBlock
    if ((Test-FirewallRule $script:RuleTcp) -or (Test-FirewallRule $script:RuleUdp)) {
        if (Test-IsAdmin) {
            Uninstall-FirewallRules
        } else {
            Write-Host 'Windows needs approval to remove the firewall rules.' -ForegroundColor Yellow
            [void](Invoke-ElevatedEntry -Entry 'unfirewall')
        }
    }
    Write-Host ''
    if ((Test-FirewallRule $script:RuleTcp) -or (Test-FirewallRule $script:RuleUdp)) {
        Write-Host 'Firewall rules are still present.' -ForegroundColor Red
    } else {
        Write-Host 'Firewall rules and the command are removed. Your files are still there.' -ForegroundColor Green
    }
    Wait-Enter
}

function Show-Status {
    Clear-Host
    Write-Host 'Status' -ForegroundColor Cyan
    Write-Host ''
    Write-Host "Windows name: $env:COMPUTERNAME"
    Write-Host ("Shown as:     " + (Get-DisplayName))
    $ips = @(Get-LanIPv4)
    if ($ips.Count -eq 0) { Write-Host 'LAN address:  none' }
    else { Write-Host ("LAN address:  " + ($ips -join ', ')) }
    Write-Host ''
    if (Test-SlipInstalled) { Write-Host 'Setup marker: present' -ForegroundColor Green }
    else { Write-Host 'Setup marker: not installed' -ForegroundColor Yellow }
    foreach ($rule in @($script:RuleTcp, $script:RuleUdp)) {
        if (Test-FirewallRule $rule) { Write-Host "Firewall:     $rule  ok" -ForegroundColor Green }
        else { Write-Host "Firewall:     $rule  missing" -ForegroundColor Yellow }
    }
    Show-NetworkWarning
    Write-Host ''
    foreach ($pair in @(
        @{ Label = 'Outbox'; Path = (Get-OutboxPath) },
        @{ Label = 'Inbox'; Path = (Get-InboxPath) }
    )) {
        if (Test-Path -LiteralPath $pair.Path) {
            $files = @(Get-ChildItem -LiteralPath $pair.Path -Force -File -ErrorAction SilentlyContinue)
            $sum = 0L
            foreach ($file in $files) { $sum += [long]$file.Length }
            Write-Host ("{0}: {1}" -f $pair.Label, $pair.Path)
            Write-Host ("       {0} files, {1}" -f $files.Count, (Format-ByteSize $sum))
        } else {
            Write-Host ("{0}: missing  {1}" -f $pair.Label, $pair.Path) -ForegroundColor Yellow
        }
    }
    Wait-Enter
}

