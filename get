function Get-OctaneLatestRelease {
    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
    try {
        $r = Invoke-RestMethod -Headers @{ 'User-Agent' = 'octane-cli' } -Uri "https://api.github.com/repos/$($script:OctaneRepo)/releases/latest" -TimeoutSec 15
        return [pscustomobject]@{ Version = ([string]$r.tag_name).TrimStart('v'); Release = $r }
    } catch { return $null }
