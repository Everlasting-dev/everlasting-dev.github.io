}

function Read-PickerAction {
    if ([Console]::IsInputRedirected) { return (Read-Host 'Choice') }
    $key = [Console]::ReadKey($true)
    switch ($key.Key) {
        'UpArrow' { return 'UP' }
        'DownArrow' { return 'DOWN' }
        'Spacebar' { return 'TOGGLE' }
        'Enter' { return 'C' }
        'Escape' { return 'Q' }
    }
    $chars = [string]$key.KeyChar
    if ($chars -match '\d') {
        $watch = [Diagnostics.Stopwatch]::StartNew()
        while ($watch.ElapsedMilliseconds -lt 450) {
            if ([Console]::KeyAvailable) {
                $next = [Console]::ReadKey($true)
                if ($next.KeyChar -match '\d') {
                    $chars += $next.KeyChar
                    $watch.Restart()
                }
                else { break }
            }
            Start-Sleep -Milliseconds 20
        }
        return $chars
    }
    return $chars
}

function Read-ArrowMenu {
    param(
        [string[]]$Items,
        [string]$Title,
        [string[]]$Lines = @(),
        [string]$ZeroLabel = 'Back',
        [string]$Hint = 'Arrows move. Enter chooses. A number chooses too. 0 goes back.'
    )
    $index = 0
    while ($true) {
        Clear-Host
        if ($Title) {
            Write-Host $Title -ForegroundColor Cyan
            Write-Host ''
        }
        foreach ($line in $Lines) {
            if ($line) { Write-Host $line }
            else { Write-Host '' }
        }
        if ($Lines.Count -gt 0) { Write-Host '' }
        for ($i = 0; $i -lt $Items.Count; $i++) {
            if ($i -eq $index -and -not [Console]::IsInputRedirected) {
                Write-Host ("  > [{0}] {1}" -f ($i + 1), $Items[$i]) -ForegroundColor Green
            }
            else {
                Write-Host ("    [{0}] {1}" -f ($i + 1), $Items[$i])
            }
        }
        Write-Host ''
        if ($ZeroLabel) { Write-Host ("    [0] {0}" -f $ZeroLabel) }
        Write-Host ''
        Write-Host $Hint -ForegroundColor DarkGray
        if ([Console]::IsInputRedirected) {
            $typed = Read-Host 'Choice'
            if ([string]::IsNullOrWhiteSpace($typed)) { return -1 }
            if ($typed -eq '0') { return -1 }
            if ($typed -match '^\d+$') {
                $n = [int]$typed
                if ($n -ge 1 -and $n -le $Items.Count) { return ($n - 1) }
            }
            continue
        }
        $key = [Console]::ReadKey($true)
        switch ($key.Key) {
            'UpArrow' { if ($index -gt 0) { $index-- } else { $index = $Items.Count - 1 }; continue }
            'DownArrow' { if ($index -lt ($Items.Count - 1)) { $index++ } else { $index = 0 }; continue }
            'Enter' { return $index }
            'Escape' { return -1 }
        }
        if ($key.KeyChar -eq '0') { return -1 }
        if ($key.KeyChar -match '\d') {
            $n = [int][string]$key.KeyChar
            if ($n -ge 1 -and $n -le $Items.Count) { return ($n - 1) }
        }
    }
}

function Get-QuickPath { Join-Path (Get-SlipRoot) 'quick.txt' }
function Get-ListenPidPath { Join-Path (Get-SlipCommandDir) 'listen.pid' }

function Test-QuickReceive {
    $path = Get-QuickPath
    if (-not (Test-Path -LiteralPath $path)) { return $false }
    return ((Get-Content -LiteralPath $path -Raw -ErrorAction SilentlyContinue) -match 'on')
}

function Set-QuickReceiveFlag {
    param([bool]$On)
    Ensure-SlipFiles | Out-Null
    $value = if ($On) { 'on' } else { 'off' }
    Set-Content -LiteralPath (Get-QuickPath) -Value $value -Encoding ASCII
}

function Open-InboxFront {
    $path = Get-InboxPath
    if (-not (Test-Path -LiteralPath $path)) { New-Item -ItemType Directory -Path $path -Force | Out-Null }
    $full = [IO.Path]::GetFullPath($path)
    try {
        $shell = New-Object -ComObject Shell.Application
        foreach ($window in @($shell.Windows())) {
            try {
                $location = [string]$window.Document.Folder.Self.Path
            }
            catch { continue }
            if ($location -and ([IO.Path]::GetFullPath($location) -ieq $full)) {
                $hwnd = [IntPtr]$window.HWND
                $restore = Add-Type -MemberDefinition '[DllImport("user32.dll")] public static extern bool ShowWindow(IntPtr hWnd, int nCmdShow); [DllImport("user32.dll")] public static extern bool SetForegroundWindow(IntPtr hWnd);' -Name SlipWindow -Namespace SlipWin -PassThru -ErrorAction SilentlyContinue
                if (-not $restore) { $restore = [SlipWin.SlipWindow] }
                [void]$restore::ShowWindow($hwnd, 9)
                [void]$restore::SetForegroundWindow($hwnd)
                return
            }
        }
    }
    catch { }
    Start-Process explorer.exe $full
}

function Send-PresenceBeacon {
    param([string]$Kind, [int]$Port)
    $udp = New-Object System.Net.Sockets.UdpClient
    try {
        $udp.EnableBroadcast = $true
        $payload = '{0}|{1}|{2}|{3}|{4}|0|{5}' -f $script:BeaconPrefix, $Kind, $Port, (ConvertTo-BeaconField (Get-DisplayName)), (ConvertTo-BeaconField $env:COMPUTERNAME), $Kind.ToLower()
        $bytes = [Text.Encoding]::UTF8.GetBytes($payload)
        [void]$udp.Send($bytes, $bytes.Length, '255.255.255.255', $script:BeaconPort)
    }
    finally { $udp.Close() }
}

function Start-PresenceLoop {
    $stopFile = Join-Path $env:TEMP ("slip-presence-{0}.stop" -f $PID)
    if (Test-Path -LiteralPath $stopFile) { Remove-Item -LiteralPath $stopFile -Force }
    $ps = [PowerShell]::Create()
    [void]$ps.AddScript({
        param($StopFile, $Name, $Computer, $Port, $Prefix)
        $udp = New-Object System.Net.Sockets.UdpClient
        $udp.EnableBroadcast = $true
        try {
            while (-not (Test-Path -LiteralPath $StopFile)) {
                $payload = '{0}|OPEN|0|{1}|{2}|0|open' -f $Prefix, $Name, $Computer
                $bytes = [Text.Encoding]::UTF8.GetBytes($payload)
                try {
                    [void]$udp.Send($bytes, $bytes.Length, '255.255.255.255', $Port)
                } catch { }
                $left = 10
                while ($left -gt 0 -and -not (Test-Path -LiteralPath $StopFile)) {
                    Start-Sleep -Milliseconds 100
                    $left--
                }
            }
        }
        finally { $udp.Close() }
    }).AddArgument($stopFile).AddArgument((ConvertTo-BeaconField (Get-DisplayName))).AddArgument((ConvertTo-BeaconField $env:COMPUTERNAME)).AddArgument($script:BeaconPort).AddArgument($script:BeaconPrefix)
    $handle = $ps.BeginInvoke()
    return @{ PowerShell = $ps; Handle = $handle; StopFile = $stopFile }
}

function Stop-PresenceLoop {
    param($Loop)
    if (-not $Loop) { return }
    try { Set-Content -LiteralPath $Loop.StopFile -Value 'stop' -Encoding ASCII } catch { }
    $deadline = (Get-Date).AddSeconds(3)
    while (-not $Loop.Handle.IsCompleted -and (Get-Date) -lt $deadline) {
        Start-Sleep -Milliseconds 100
    }
    try {
        if ($Loop.Handle.IsCompleted) { $Loop.PowerShell.EndInvoke($Loop.Handle) | Out-Null }
    } catch { }
    try { $Loop.PowerShell.Dispose() } catch { }
    Remove-Item -LiteralPath $Loop.StopFile -Force -ErrorAction SilentlyContinue
}

function Start-QuickReceiveTask {
    $cmd = Join-Path (Get-SlipCommandDir) 'slip-listen.cmd'
    $action = "schtasks /Create /TN `"Slip Quick Receive`" /SC ONLOGON /RL LIMITED /F /TR `"$cmd`""
    cmd /c $action | Out-Null
}

function Stop-QuickReceive {
    $flag = Get-QuickPath
    if (Test-Path -LiteralPath $flag) {
        Set-Content -LiteralPath $flag -Value 'off' -Encoding ASCII
    }
    $pidPath = Get-ListenPidPath
    if (Test-Path -LiteralPath $pidPath) {
        $listenPid = 0
        if ([int]::TryParse((Get-Content -LiteralPath $pidPath -Raw).Trim(), [ref]$listenPid)) {
            Stop-Process -Id $listenPid -Force -ErrorAction SilentlyContinue
        }
        Remove-Item -LiteralPath $pidPath -Force -ErrorAction SilentlyContinue
    }
    cmd /c 'schtasks /Delete /TN "Slip Quick Receive" /F' | Out-Null
}

function Set-QuickReceive {
    param([bool]$On)
    if ($On) {
        Stop-QuickReceive
        Set-QuickReceiveFlag $true
        Install-SlipCommand
        Start-QuickReceiveTask
        $cmd = Join-Path (Get-SlipCommandDir) 'slip-listen.cmd'
        Start-Process -FilePath $cmd -WindowStyle Hidden
        Write-Host 'Quick receive is on. This PC can take a file with no PIN.' -ForegroundColor Green
    }
    else {
        Set-QuickReceiveFlag $false
        Stop-QuickReceive
        Write-Host 'Quick receive is off.' -ForegroundColor Green
    }
    Read-Host 'Press Enter'
}

function Invoke-QuickUpload {
    param(
        [string]$Address,
        [int]$Port,
        [string]$FilePath,
        [string]$DownloadName
    )
    $file = Get-Item -LiteralPath $FilePath
    $client = New-Object System.Net.Sockets.TcpClient
    try {
        $client.Connect($Address, $Port)
        $stream = $client.GetStream()
        $header = "POST /quick HTTP/1.1`r`nHost: {0}`r`nContent-Length: {1}`r`nX-File-Name: {2}`r`nConnection: close`r`n`r`n" -f $Address, $file.Length, $DownloadName
        $headBytes = [Text.Encoding]::ASCII.GetBytes($header)
        $stream.Write($headBytes, 0, $headBytes.Length)
        $input = [IO.File]::OpenRead($file.FullName)
        try {
            $buffer = New-Object byte[] (1024 * 1024)
            $sent = 0L
            while (($read = $input.Read($buffer, 0, $buffer.Length)) -gt 0) {
                $stream.Write($buffer, 0, $read)
                $sent += $read
                $pct = [int](($sent * 100) / [Math]::Max($file.Length, 1))
                Write-Host ("`rSending {0,-30} {1,3}%" -f (Get-ShortText $DownloadName 30), $pct) -NoNewline
            }
        }
        finally { $input.Dispose() }
        $stream.Flush()
        Write-Host ''
        $reader = New-Object IO.StreamReader($stream)
        $status = $reader.ReadLine()
        if ($status -notmatch ' 200 ') { throw "The other PC did not accept the file ($status)." }
        Write-Host ("Sent to the other PC: {0}" -f $DownloadName) -ForegroundColor Green
    }
    finally {
        try { $client.Close() } catch { }
    }
}

function Start-QuickListener {
    $root = Get-SlipRoot
    if (-not (Test-Path -LiteralPath $root)) { return }
    $flag = Join-Path $root 'quick.txt'
    $pidFile = Get-ListenPidPath
    $dir = Split-Path -Parent $pidFile
    if (-not (Test-Path -LiteralPath $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }
    Set-Content -LiteralPath $pidFile -Value $PID -Encoding ASCII
    $udp = New-Object System.Net.Sockets.UdpClient
    $udp.EnableBroadcast = $true
    $listener = New-Object System.Net.Sockets.TcpListener ([Net.IPAddress]::Any, 0)
    $listener.Start()
    $port = ([Net.IPEndPoint]$listener.LocalEndpoint).Port
    try {
        while ((Get-Content -LiteralPath $flag -Raw -ErrorAction SilentlyContinue) -match 'on') {
            $name = 'Slip'
            $nameFile = Join-Path $root 'name.txt'
            if (Test-Path -LiteralPath $nameFile) {
                $stored = (Get-Content -LiteralPath $nameFile -Raw).Trim()
                if ($stored) { $name = $stored }
            }
            $payload = '{0}|QUICK|{1}|{2}|{3}|0|quick' -f 'SLIP1', $port, (ConvertTo-BeaconField $name), (ConvertTo-BeaconField $env:COMPUTERNAME)
            $bytes = [Text.Encoding]::UTF8.GetBytes($payload)
            try {
                $endpoint = New-Object System.Net.IPEndPoint ([Net.IPAddress]::Broadcast, 47654)
                [void]$udp.Send($bytes, $bytes.Length, $endpoint)
            }
            catch { }
            if (-not $listener.Pending()) {
                Start-Sleep -Milliseconds 200
                continue
            }
            $client = $listener.AcceptTcpClient()
            try {
                $stream = $client.GetStream()
                $headerText = ''
                $buffer = New-Object byte[] 1
                while ($headerText -notmatch "`r`n`r`n" -and $headerText.Length -lt 8192) {
                    $n = $stream.Read($buffer, 0, 1)
                    if ($n -le 0) { break }
                    $headerText += [Text.Encoding]::ASCII.GetString($buffer, 0, 1)
                }
                if ($headerText -notmatch 'POST /quick') { continue }
                $length = 0L
                $fileName = 'slip-file.bin'
                foreach ($line in ($headerText -split "`r`n")) {
                    if ($line -match '^Content-Length:\s*(\d+)') { $length = [int64]$Matches[1] }
                    if ($line -match '^X-File-Name:\s*(.+)$') { $fileName = $Matches[1].Trim() }
                }
                $fileName = [IO.Path]::GetFileName($fileName)
                if ([string]::IsNullOrWhiteSpace($fileName)) { $fileName = 'slip-file.bin' }
                $inbox = Join-Path $root 'Inbox'
                if (-not (Test-Path -LiteralPath $inbox)) { New-Item -ItemType Directory -Path $inbox -Force | Out-Null }
                $dest = Join-Path $inbox $fileName
                if (Test-Path -LiteralPath $dest) {
                    $stem = [IO.Path]::GetFileNameWithoutExtension($fileName)
                    $ext = [IO.Path]::GetExtension($fileName)
                    $dest = Join-Path $inbox ("{0}-{1}{2}" -f $stem, (Get-Date -Format 'yyyyMMdd-HHmmss'), $ext)
                }
                $output = [IO.File]::Create($dest)
                try {
                    $left = $length
                    $chunk = New-Object byte[] (1024 * 1024)
                    while ($left -gt 0) {
                        $take = [Math]::Min($chunk.Length, $left)
                        $read = $stream.Read($chunk, 0, $take)
                        if ($read -le 0) { break }
                        $output.Write($chunk, 0, $read)
                        $left -= $read
                    }
                }
                finally { $output.Dispose() }
                $ok = "HTTP/1.1 200 OK`r`nContent-Length: 2`r`nConnection: close`r`n`r`nOK"
                $okBytes = [Text.Encoding]::ASCII.GetBytes($ok)
                $stream.Write($okBytes, 0, $okBytes.Length)
                Open-InboxFront
            }
            catch { }
            finally { $client.Close() }
        }
    }
    finally {
        $listener.Stop()
        $udp.Close()
        Remove-Item -LiteralPath $pidFile -Force -ErrorAction SilentlyContinue
    }
}

function Test-OwnAddress {
    param([string]$Address)
    if (-not $Address) { return $true }
    if ($Address -eq '127.0.0.1' -or $Address -eq '::1') { return $true }
    return (@(Get-LanIPv4) -contains $Address)
}

function Show-CheckConnection {
    Clear-Host
    Write-Host 'Check connection' -ForegroundColor Cyan
    Write-Host ''
    Write-Host ("This PC: {0} ({1})" -f (Get-DisplayName), $env:COMPUTERNAME)
    $mine = @(Get-LanIPv4)
    if ($mine.Count -eq 0) { Write-Host 'LAN address: none' }
    else { Write-Host ("LAN address: " + ($mine -join ', ')) }
    Write-Host ''
    Write-Host 'Looking for other PCs...'
    $raw = @(Receive-Beacons -Seconds 4 | Where-Object { -not (Test-OwnAddress $_.IP) })
    $best = @{}
    foreach ($share in $raw) {
        $rank = 1
        if ($share.Token -eq 'QUICK') { $rank = 2 }
        elseif ($share.Token -ne 'OPEN') { $rank = 3 }
        $prev = $best[$share.IP]
        if (-not $prev -or $rank -ge $prev.Rank) {
            $share.Rank = $rank
            $best[$share.IP] = $share
        }
    }
    $shares = @($best.Values)
    if ($shares.Count -eq 0) {
        Write-Host 'No other PC is listed. The other PC needs Slip open, or Quick receive turned on.' -ForegroundColor Yellow
    }
    foreach ($share in $shares) {
        $ping = Test-Icmp $share.IP
        Write-Host ''
        Write-Host ("{0} ({1})" -f $share.Display, $share.Windows) -ForegroundColor Cyan
        if ($share.Token -eq 'OPEN' -or $share.Port -le 0) {
            Write-Host ("  {0}  ping {1}  Slip is open" -f $share.IP, (Format-Check $ping))
        }
        elseif ($share.Token -eq 'QUICK') {
            $tcp = Test-TcpOpen $share.IP $share.Port
            Write-Host ("  {0}:{1}  ping {2}  quick receive {3}" -f $share.IP, $share.Port, (Format-Check $ping), (Format-Check $tcp))
        }
        else {
            $tcp = Test-TcpOpen $share.IP $share.Port
            Write-Host ("  {0}:{1}  ping {2}  transfer port {3}  {4}" -f $share.IP, $share.Port, (Format-Check $ping), (Format-Check $tcp), $share.File)
        }
    }
    Write-Host ''
    Write-Host 'Ping can fail on Windows even when a transfer would work. The transfer port is the result that matters.'
    $ip = Read-Host 'Type an IP to check, or press Enter to go back'
    if ($ip) {
        $ip = $ip.Trim()
        $ping = Test-Icmp $ip
        $open = $null
        foreach ($candidate in $script:PortFirst..$script:PortLast) {
            if (Test-TcpOpen $ip $candidate) { $open = $candidate; break }
        }
        Write-Host ''
        Write-Host ("{0}  ping {1}" -f $ip, (Format-Check $ping))
        if ($open) { Write-Host "Transfer port ${open}: ok" -ForegroundColor Green }
        else { Write-Host 'Transfer port: not open. That PC may not be sending right now.' -ForegroundColor Yellow }
        Wait-Enter
    }
}

function Get-UniqueFilePath {
    param([string]$Directory, [string]$Name)
    $leaf = [IO.Path]::GetFileName($Name)
    if (-not $leaf) { $leaf = "$($script:AppName)-download" }
    $dest = Join-Path $Directory $leaf
    $base = [IO.Path]::GetFileNameWithoutExtension($leaf)
    $ext = [IO.Path]::GetExtension($leaf)
    $i = 1
    while (Test-Path -LiteralPath $dest) {
        $dest = Join-Path $Directory ("{0} ({1}){2}" -f $base, $i, $ext)
        $i++
    }
    return $dest
}

function Save-RemoteFile {
    param([string]$Url, [string]$Directory, [switch]$Quiet)
    Add-Type -AssemblyName System.Net.Http
    if (-not (Test-Path -LiteralPath $Directory)) {
        New-Item -ItemType Directory -Force -Path $Directory | Out-Null
    }
    $client = New-Object System.Net.Http.HttpClient
    $client.Timeout = [TimeSpan]::FromHours(6)
    try {
        $resp = $client.GetAsync($Url, [System.Net.Http.HttpCompletionOption]::ResponseHeadersRead).GetAwaiter().GetResult()
        if (-not $resp.IsSuccessStatusCode) {
            $errText = ''
            try { $errText = $resp.Content.ReadAsStringAsync().GetAwaiter().GetResult() } catch {}
            throw "Download failed ($([int]$resp.StatusCode)). $errText"
        }
        $total = $resp.Content.Headers.ContentLength
        $disposition = $resp.Content.Headers.ContentDisposition
        $name = $null
        if ($disposition) {
            if ($disposition.FileNameStar) { $name = $disposition.FileNameStar.Trim('"') }
            elseif ($disposition.FileName) { $name = $disposition.FileName.Trim('"') }
        }
        if (-not $name) { $name = "$($script:AppName)-download" }
        $dest = Get-UniqueFilePath $Directory $name
        $inputStream = $resp.Content.ReadAsStreamAsync().GetAwaiter().GetResult()
        $output = [IO.File]::Create($dest)
        $last = -1
        try {
            $buf = New-Object byte[] (1MB)
            $readTotal = 0L
            while (($n = $inputStream.Read($buf, 0, $buf.Length)) -gt 0) {
                $output.Write($buf, 0, $n)
                $readTotal += $n
                if (-not $Quiet -and $total -and $total -gt 0) {
                    $pct = [int](($readTotal * 100) / $total)
                    if ($pct -gt 100) { $pct = 100 }
                    if ($pct -ne $last) {
                        Write-PercentLine -Label ("Receiving " + (Get-ShortText $name 32)) -Percent $pct
                        $last = $pct
                    }
                }
            }
            if (-not $Quiet -and $last -ge 0) { Write-Host '' }
        } finally {
            $output.Dispose()
            $inputStream.Dispose()
        }
        return $dest
    } finally {
        $client.Dispose()
    }
}

function Show-ReceiveFiles {
    Clear-Host
    Write-Host 'Receive files' -ForegroundColor Cyan
    Write-Host ''
    Write-Host (Get-ReceiveStepsText)
    Write-Host ''
    Write-Host 'Looking for a PC that is sending...'
    $shares = @(Receive-Beacons -Seconds 5 | Where-Object {
        $_.Token -ne 'OPEN' -and $_.Token -ne 'QUICK' -and $_.Port -gt 0 -and -not (Test-OwnAddress $_.IP)
    })
    if ($shares.Count -eq 0) {
        Write-Host 'Nobody is sending right now. Start Send on the other PC, then try again.' -ForegroundColor Yellow
        Wait-Enter
        return
    }
    $chosen = $null
    if ($shares.Count -eq 1) {
        $chosen = $shares[0]
    } else {
        $labels = @($shares | ForEach-Object {
            "{0} ({1})  {2}  {3}" -f $_.Display, $_.Windows, $_.File, (Format-ByteSize $_.Size)
        })
        $pick = Read-ArrowMenu -Title 'Receive files' -Lines @('Pick a PC that is sending.') -Items $labels -ZeroLabel 'Back'
        if ($pick -lt 0) { return }
        $chosen = $shares[$pick]
    }
    $ping = Test-Icmp $chosen.IP
    $tcp = Test-TcpOpen $chosen.IP $chosen.Port
    Write-Host ''
    Write-Host ("{0} ({1})" -f $chosen.Display, $chosen.Windows)
    Write-Host ("{0}  ({1})" -f $chosen.File, (Format-ByteSize $chosen.Size))
    Write-Host ("ping {0}   transfer port {1}" -f (Format-Check $ping), (Format-Check $tcp))
    if (-not $tcp) {
        Write-Host 'The transfer port is not open from here.' -ForegroundColor Yellow
    }
    $tries = 0
    while ($tries -lt 3) {
        $pin = Read-Host 'PIN'
        if (-not $pin) { return }
        $pin = $pin.Trim()
        $url = "http://$($chosen.IP):$($chosen.Port)/d/$($chosen.Token)?pin=$([Uri]::EscapeDataString($pin))"
        try {
            $saved = Save-RemoteFile -Url $url -Directory (Get-InboxPath)
            Write-Host ''
            Write-Host "Saved to $saved" -ForegroundColor Green
            Open-InboxFront
            Wait-Enter
            return
        } catch {
            $tries++
            Write-Host $_.Exception.Message -ForegroundColor Red
            if ($tries -ge 3) { Wait-Enter; return }
        }
    }
}

