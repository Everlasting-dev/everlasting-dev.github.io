}

# Pack wins on id or name clashes; this PC's other templates are kept.
function Merge-OctaneTemplates {
    param([object[]]$Pack = @(), [object[]]$Local = @())
    $ids = @{}; $names = @{}
    foreach ($t in $Pack) { $ids[[string]$t.id] = $true; $names[([string]$t.name).ToLowerInvariant()] = $true }
    $kept = @($Local | Where-Object { -not $ids.ContainsKey([string]$_.id) -and -not $names.ContainsKey(([string]$_.name).ToLowerInvariant()) })
    return [pscustomobject]@{ Merged = @(@($Pack) + @($kept)); Kept = $kept.Count }
}

