function Show-OctaneRepair {
    Clear-Host
    Write-Host 'Check & repair Octane' -ForegroundColor Cyan
    Write-Host ''
    $problems = 0
    $needsReinstall = $false
    $ok = { param($t) Write-Host ("  OK    {0}" -f $t) -ForegroundColor Green }
    $bad = { param($t) Write-Host ("  FIX   {0}" -f $t) -ForegroundColor Yellow }

    $inst = Get-OctaneInstall
    if (-not $inst) {
        & $bad 'Octane is not installed.'
        $problems++; $needsReinstall = $true
    } else {
        $exe = Join-Path $inst.Dir 'Octane.exe'
        $asar = Join-Path $inst.Dir 'resources\app.asar'
        $lic = Join-Path $inst.Dir 'resources\LICENSE'
        if (Test-Path -LiteralPath $exe) { & $ok ("Octane {0} at {1}" -f $inst.Version, $inst.Dir) } else { & $bad 'Octane.exe is missing.'; $problems++; $needsReinstall = $true }
        if (Test-Path -LiteralPath $asar) { & $ok 'App files present' } else { & $bad 'App files (app.asar) are missing.'; $problems++; $needsReinstall = $true }
        if (Test-Path -LiteralPath $lic) { & $ok 'LICENSE present' } else { & $bad 'LICENSE file is missing.'; $problems++; $needsReinstall = $true }
        $latest = Get-OctaneLatestRelease
        if ($latest -and $latest.Version -ne $inst.Version) { & $bad ("Update available: {0} -> {1}" -f $inst.Version, $latest.Version); $problems++; $needsReinstall = $true }
        elseif ($latest) { & $ok 'Latest version' }
    }

    $tpl = Get-OctaneTemplatesPath
    if (Test-Path -LiteralPath $tpl) {
        try {
            $null = Read-OctaneTemplates -Text ([IO.File]::ReadAllText($tpl))
            & $ok 'Templates file is valid'
        } catch {
            $stamp = (Get-Date).ToString('yyyyMMdd-HHmmss')
            $bak = Get-ChildItem -Path (Split-Path $tpl -Parent) -Filter 'templates.json.bak-*' -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending | Select-Object -First 1
            Move-Item -LiteralPath $tpl -Destination "$tpl.corrupt-$stamp" -Force
            if ($bak) { Copy-Item -LiteralPath $bak.FullName -Destination $tpl -Force; & $bad ("Templates file was damaged; restored {0}" -f $bak.Name) }
            else { & $bad 'Templates file was damaged; Octane will rebuild the built-in templates on next start' }
            $problems++
        }
    } else { & $ok 'No templates file yet (Octane creates it on first start)' }

    $session = Join-Path $env:APPDATA 'Octane\auth-session.dat'
    if ((Test-Path -LiteralPath $session) -and (Get-Item -LiteralPath $session).Length -eq 0) {
        Remove-Item -LiteralPath $session -Force
        & $bad 'Empty sign-in file removed (sign in again)'
        $problems++
    } else { & $ok 'Sign-in file' }

    try {
        $p = Get-ItemProperty $script:OctaneAnchorKey -ErrorAction Stop
        & $ok ("License lock on this PC since {0}" -f $p.FirstSeen)
    } catch {
        & $bad 'This PC has no license lock yet (use "Verify & lock license on this PC")'
    }

    Write-Host ''
    if ($problems -eq 0) { Write-Host 'Everything looks good.' -ForegroundColor Green }
    if ($needsReinstall) {
        $answer = Read-Host '[Y] Reinstall the latest Octane now  [N] Back'
        if ($answer -match '^[Yy]') {
            try {
                if (Test-OctaneRunning) { Get-Process -Name 'Octane' | Stop-Process -Force; Start-Sleep -Seconds 2 }
                Uninstall-PreviousOctane
                Install-LatestOctane
            } catch { Write-Host $_.Exception.Message -ForegroundColor Red }
        }
    }
    Wait-Enter
}

function Get-OctaneAnchorCommand {
    # Runs elevated: creates the machine license anchor once and makes it read-only for users.
    @'
$ErrorActionPreference = 'Stop'
$path = 'HKLM:\SOFTWARE\EverlastingDev\Octane'
if (-not (Test-Path $path)) { New-Item -Path $path -Force | Out-Null }
$p = Get-ItemProperty -Path $path -ErrorAction SilentlyContinue
if (-not $p.FirstSeen) { New-ItemProperty -Path $path -Name FirstSeen -PropertyType String -Value ((Get-Date).ToUniversalTime().ToString('o')) -Force | Out-Null }
if (-not $p.MachineId) { New-ItemProperty -Path $path -Name MachineId -PropertyType String -Value '__MACHINEID__' -Force | Out-Null }
$acl = Get-Acl $path
$acl.SetAccessRuleProtection($true, $false)
foreach ($r in @($acl.Access)) { [void]$acl.RemoveAccessRule($r) }
$full = [Security.AccessControl.RegistryRights]::FullControl
$read = [Security.AccessControl.RegistryRights]::ReadKey
$inh = [Security.AccessControl.InheritanceFlags]::ContainerInherit
$none = [Security.AccessControl.PropagationFlags]::None
$allow = [Security.AccessControl.AccessControlType]::Allow
foreach ($sid in @('S-1-5-18', 'S-1-5-32-544')) {
    $acl.AddAccessRule((New-Object Security.AccessControl.RegistryAccessRule((New-Object Security.Principal.SecurityIdentifier($sid)), $full, $inh, $none, $allow)))
}
foreach ($sid in @('S-1-5-32-545', 'S-1-5-11')) {
    $acl.AddAccessRule((New-Object Security.AccessControl.RegistryAccessRule((New-Object Security.Principal.SecurityIdentifier($sid)), $read, $inh, $none, $allow)))
}
Set-Acl -Path $path -AclObject $acl
'@ -replace '__MACHINEID__', (Get-OctaneMachineId)
}

function Show-OctaneLicenseLock {
    Clear-Host
    Write-Host 'Verify & lock license on this PC' -ForegroundColor Cyan
    Write-Host ''
    Write-Host 'Each Octane account has 15 days from its first ever sign-in.'
    Write-Host 'Locking this PC stores a permanent first-seen date that standard'
    Write-Host 'users cannot change, so reinstalling or deleting app data never'
    Write-Host 'restarts the clock. Windows asks for administrator approval once.'
    Write-Host ''
    $existing = $null
    try { $existing = Get-ItemProperty $script:OctaneAnchorKey -ErrorAction Stop } catch { }
    if ($existing) {
        Write-Host ("This PC is locked since {0}." -f $existing.FirstSeen) -ForegroundColor Green
    } else {
        $answer = Read-Host '[Y] Lock this PC (admin prompt)  [N] Skip'
        if ($answer -match '^[Yy]') {
            $encoded = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes((Get-OctaneAnchorCommand)))
            try {
                $proc = Start-Process -FilePath 'powershell.exe' -ArgumentList @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-EncodedCommand', $encoded) -Verb RunAs -Wait -PassThru -WindowStyle Hidden
                if ($proc.ExitCode -eq 0) { Write-Host 'This PC is now locked.' -ForegroundColor Green }
                else { Write-Host ("The lock did not finish (exit {0})." -f $proc.ExitCode) -ForegroundColor Yellow }
            } catch {
                Write-Host 'Administrator approval was declined, so the lock was not set.' -ForegroundColor Yellow
            }
        }
    }
    Write-Host ''
    $answer = Read-Host '[Y] Check my account license  [N] Back'
    if ($answer -match '^[Yy]') {
        $s = Connect-OctaneAccount
        if ($s) { Write-OctaneLicense $s.License }
    }
    Wait-Enter
}

function Show-OctaneTemplatePack {
    Clear-Host
    Write-Host 'Get template pack' -ForegroundColor Cyan
    Write-Host ''
    Write-Host 'Installs the shared Octane template pack on this PC.'
    Write-Host 'First, this PC''s current templates are backed up privately to the'
    Write-Host 'Octane owner and to a local .bak file. Templates with the same name'
    Write-Host 'are replaced by the pack; your other templates are kept.'
    Write-Host ''
    $answer = Read-Host '[Y] Continue  [N] Back'
    if ($answer -notmatch '^[Yy]') { return }
    $s = Connect-OctaneAccount
    if (-not $s) { Wait-Enter; return }
    $tpl = Get-OctaneTemplatesPath
    $stamp = (Get-Date).ToUniversalTime().ToString('yyyyMMdd-HHmmss')
    $local = @()
    try {
        if (Test-Path -LiteralPath $tpl) {
            $text = [IO.File]::ReadAllText($tpl)
            Copy-Item -LiteralPath $tpl -Destination "$tpl.bak-$stamp" -Force
            $local = @(Read-OctaneTemplates -Text $text)
            $name = ('{0}/{1}-{2}.json' -f $s.UserId, ($env:COMPUTERNAME -replace '[^A-Za-z0-9_-]', '_'), $stamp)
            Invoke-OctaneStorage -Method Post -Path "object/octane-template-backups/$name" -InFile $tpl | Out-Null
            Write-Host ("Backed up {0} template(s) from this PC." -f $local.Count) -ForegroundColor Green
        } else {
            Write-Host 'No templates on this PC yet; nothing to back up.'
        }
    } catch {
        Write-Host ("Backup failed, nothing was changed: {0}" -f (Get-OctaneApiError $_)) -ForegroundColor Red
        Wait-Enter
        return
    }
    $tmp = Join-Path $env:TEMP "octane-pack-$stamp.json"
    try {
        Invoke-OctaneStorage -Path 'object/authenticated/octane-templates/pack.json' -OutFile $tmp | Out-Null
        $pack = @(Read-OctaneTemplates -Text ([IO.File]::ReadAllText($tmp)))
    } catch {
        Write-Host ("Could not download the template pack: {0}" -f (Get-OctaneApiError $_)) -ForegroundColor Red
        Wait-Enter
        return
    } finally {
        Remove-Item -LiteralPath $tmp -Force -ErrorAction SilentlyContinue
    }
    if ($pack.Count -eq 0) { Write-Host 'The template pack is empty.' -ForegroundColor Yellow; Wait-Enter; return }
    $result = Merge-OctaneTemplates -Pack $pack -Local $local
    Write-Utf8NoBom -Path $tpl -Text (ConvertTo-Json -InputObject @($result.Merged) -Depth 12)
    Write-Host ("Installed {0} template(s) from the pack, kept {1} of your own." -f $pack.Count, $result.Kept) -ForegroundColor Green
    if (Test-OctaneRunning) { Write-Host 'Restart Octane to see them.' -ForegroundColor Yellow }
    Wait-Enter
}

function Show-OctanePublishPack {
