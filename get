function Invoke-QuickUpload {
    param(
        [string]$Address,
        [int]$Port,
        [string]$FilePath,
        [string]$DownloadName,
        [string]$TargetName
    )
    $file = Get-Item -LiteralPath $FilePath
    $who = if ($TargetName) { $TargetName } else { $Address }
    Write-Host ''
    Write-Host ("Sending {0}  ({1})  to {2}" -f $DownloadName, (Format-ByteSize $file.Length), $who)
    Write-Host 'Connecting...'
    Write-TransferDebug 'send.quick.start' @{ target = $who; address = $Address; port = $Port; file = $DownloadName; size = $file.Length }
    $client = New-Object System.Net.Sockets.TcpClient
    try {
        $wait = $client.BeginConnect($Address, $Port, $null, $null)
        if (-not $wait.AsyncWaitHandle.WaitOne(5000, $false)) {
            throw "Could not reach $who. On that PC, turn Quick receive off and on, then try again."
        }
        $client.EndConnect($wait)
        $stream = $client.GetStream()
        $stream.ReadTimeout = 20000
        $stream.WriteTimeout = 20000
        $encodedName = [Uri]::EscapeDataString($DownloadName)
        $encodedName64 = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($DownloadName))
        $header = "POST /quick HTTP/1.1`r`nHost: {0}`r`nContent-Length: {1}`r`nX-File-Name: {2}`r`nX-File-Name64: {3}`r`nConnection: close`r`n`r`n" -f $Address, $file.Length, $encodedName, $encodedName64
        $headBytes = [Text.Encoding]::ASCII.GetBytes($header)
        $stream.Write($headBytes, 0, $headBytes.Length)
        $input = [IO.File]::OpenRead($file.FullName)
        try {
            $buffer = New-Object byte[] (1024 * 1024)
            $sent = 0L
            while (($read = $input.Read($buffer, 0, $buffer.Length)) -gt 0) {
                $stream.Write($buffer, 0, $read)
                $sent += $read
                $pct = [int](($sent * 100) / [Math]::Max($file.Length, 1))
                Write-PercentLine -Label ("Sending " + (Get-ShortText $DownloadName 28)) -Percent $pct -Size $file.Length
            }
        }
        finally { $input.Dispose() }
        $stream.Flush()
        Write-Host ''
        $reader = New-Object IO.StreamReader($stream)
        $status = $reader.ReadLine()
        if ($status -notmatch ' 200 ') { throw "The other PC did not accept the file ($status)." }
        Write-Host ("Sent {0} ({1}) to {2}" -f $DownloadName, (Format-ByteSize $file.Length), $who) -ForegroundColor Green
        Write-TransferDebug 'send.quick.completed' @{ target = $who; address = $Address; port = $Port; file = $DownloadName; size = $file.Length; status = $status }
    }
    catch {
        Write-TransferDebug 'send.quick.failed' @{ target = $who; address = $Address; port = $Port; file = $DownloadName; size = $file.Length; error = $_.Exception.Message }
        throw
    }
    finally {
        try { $client.Close() } catch { }
    }
}

function Read-SlipRequest {
    param($Stream)
    $ms = New-Object System.IO.MemoryStream
    $one = New-Object byte[] 1
    $sawLine = $false
    while ($ms.Length -lt 16384) {
        $n = $Stream.Read($one, 0, 1)
        if ($n -le 0) { break }
        $ms.Write($one, 0, 1)
        $len = [int]$ms.Length
        $buffer = $ms.GetBuffer()
        if (-not $sawLine -and $buffer[$len - 1] -eq 10) {
            $line = [Text.Encoding]::ASCII.GetString($buffer, 0, $len).Trim()
            if ($line -match '^(?i)ENABLE\s+(chat|quick)$') {
                return @{ Kind = 'enable'; Which = $Matches[1].ToLower() }
            }
            $sawLine = $true
        }
        if ($len -ge 4 -and $buffer[$len - 4] -eq 13 -and $buffer[$len - 3] -eq 10 -and $buffer[$len - 2] -eq 13 -and $buffer[$len - 1] -eq 10) { break }
    }
    return @{ Kind = 'http'; Header = [Text.Encoding]::ASCII.GetString($ms.ToArray()) }
}

function New-SlipTcpListener {
    foreach ($candidate in $script:PortFirst..$script:PortLast) {
        $tryListen = $null
        try {
            $tryListen = New-Object System.Net.Sockets.TcpListener ([Net.IPAddress]::Any, $candidate)
            $tryListen.Start()
            return $tryListen
        } catch {
            if ($tryListen) { try { $tryListen.Stop() } catch { } }
        }
    }
    throw "No free port between $($script:PortFirst) and $($script:PortLast)."
}

function Start-QuickListener {
    $root = Get-SlipRoot
    if (-not (Test-Path -LiteralPath $root)) { return }
    $flag = Join-Path $root 'quick.txt'
    $pidFile = Get-ListenPidPath
    $dir = Split-Path -Parent $pidFile
    if (-not (Test-Path -LiteralPath $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }
    Set-Content -LiteralPath $pidFile -Value $PID -Encoding ASCII
    $listener = New-SlipTcpListener
    $port = ([Net.IPEndPoint]$listener.LocalEndpoint).Port
    Set-Content -LiteralPath (Get-ListenPortPath) -Value $port -Encoding ASCII
    Write-TransferDebug 'quick.listener.started' @{ port = $port; pid = $PID; name = (Get-DisplayName) }
    try {
        while ((Get-Content -LiteralPath $flag -Raw -ErrorAction SilentlyContinue) -match 'on') {
            $name = $script:AppName
            $nameFile = Join-Path $root 'name.txt'
            if (Test-Path -LiteralPath $nameFile) {
                $stored = (Get-Content -LiteralPath $nameFile -Raw).Trim()
                if ($stored) { $name = $stored }
            }
            $payload = '{0}|QUICK|{1}|{2}|{3}|0|quick' -f $script:BeaconPrefix, $port, (ConvertTo-BeaconField $name), (ConvertTo-BeaconField $env:COMPUTERNAME)
            try { [void](Send-BeaconPayload -Payload $payload -Port $script:BeaconPort) } catch { }
            if (-not $listener.Pending()) {
                Start-Sleep -Milliseconds 100
                continue
            }
            $client = $listener.AcceptTcpClient()
            $savedPath = $null
            try {
                $remote = 'unknown'
                try { $remote = [string]$client.Client.RemoteEndPoint } catch { }
                $stream = $client.GetStream()
                $stream.ReadTimeout = 20000
                $stream.WriteTimeout = 20000
                $request = Read-SlipRequest $stream
                if ($request.Kind -eq 'enable') {
                    if ($request.Which -eq 'chat') { Enable-AutoChat -Quiet }
                    $ack = [Text.Encoding]::ASCII.GetBytes("OK`n")
                    $stream.Write($ack, 0, $ack.Length)
                    $stream.Flush()
                    Write-TransferDebug 'quick.enable' @{ remote = $remote; which = $request.Which }
                    continue
                }
                $headerText = $request.Header
                $firstLine = ($headerText -split "`r`n")[0]
                Write-TransferDebug 'quick.receive.request' @{ remote = $remote; request = $firstLine; port = $port }
                if ($headerText -notmatch '^POST\s+/quick\s+HTTP/') {
                    Send-HttpText $stream 404 'Not Found' 'text/plain' 'Not found'
                    Write-TransferDebug 'quick.receive.rejected' @{ remote = $remote; reason = 'not quick post'; request = $firstLine }
                    continue
                }
                $length = -1L
                $fileName = "$($script:CommandName)-file.bin"
                $fileName64 = $null
                foreach ($line in ($headerText -split "`r`n")) {
                    if ($line -match '^Content-Length:\s*(\d+)\s*$') {
                        if ($length -ge 0) { throw 'Duplicate Content-Length header.' }
                        $length = [int64]$Matches[1]
                    }
                    if ($line -match '^X-File-Name:\s*(.+)$') { $fileName = $Matches[1].Trim() }
                    if ($line -match '^X-File-Name64:\s*(.+)$') { $fileName64 = $Matches[1].Trim() }
                }
                if ($length -lt 0) { throw 'Missing or invalid Content-Length header.' }
                if ($fileName64) {
                    try { $fileName = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($fileName64)) } catch { }
                }
                elseif ($fileName) {
                    try { $fileName = [Uri]::UnescapeDataString($fileName) } catch { }
                }
                $fileName = ConvertTo-SafeFileName -Name $fileName -Fallback "$($script:CommandName)-file.bin"
                $inbox = Join-Path $root 'Inbox'
                if (-not (Test-Path -LiteralPath $inbox)) { New-Item -ItemType Directory -Path $inbox -Force | Out-Null }
                $dest = Get-UniqueFilePath -Directory $inbox -Name $fileName
                $output = [IO.File]::Open($dest, [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::None)
                try {
                    $left = $length
                    $chunk = New-Object byte[] (1024 * 1024)
                    while ($left -gt 0) {
                        $take = [Math]::Min($chunk.Length, $left)
                        $read = $stream.Read($chunk, 0, $take)
                        if ($read -le 0) { break }
                        $output.Write($chunk, 0, $read)
                        $left -= $read
                    }
                }
                finally {
                    $output.Dispose()
                    if ($left -ne 0) { Remove-Item -LiteralPath $dest -Force -ErrorAction SilentlyContinue }
                }
                if ($left -ne 0) {
                    Remove-Item -LiteralPath $dest -Force -ErrorAction SilentlyContinue
                    throw 'The file stopped before it finished.'
                }
                $ok = "HTTP/1.1 200 OK`r`nContent-Length: 2`r`nConnection: close`r`n`r`nOK"
                $okBytes = [Text.Encoding]::ASCII.GetBytes($ok)
                $stream.Write($okBytes, 0, $okBytes.Length)
                $stream.Flush()
                $savedPath = $dest
                Write-SlipLog "Quick receive saved: $dest"
                Write-TransferDebug 'quick.receive.saved' @{ remote = $remote; file = $fileName; path = $dest; size = $length }
            }
            catch {
                Write-SlipLog "Quick receive failed: $($_.Exception.Message)"
                Write-TransferDebug 'quick.receive.failed' @{ error = $_.Exception.Message }
            }
            finally {
                try { $client.Close() } catch { }
            }
            if ($savedPath) {
                try {
                    Open-ContainingFolder $savedPath
                } catch {
                    Write-SlipLog "Could not open Inbox for ${savedPath}: $($_.Exception.Message)"
                }
            }
        }
    }
    finally {
        try { $listener.Stop() } catch { }
        Remove-Item -LiteralPath $pidFile -Force -ErrorAction SilentlyContinue
        Remove-Item -LiteralPath (Get-ListenPortPath) -Force -ErrorAction SilentlyContinue
    }
}

function Test-OwnAddress {
    param([string]$Address)
    if (-not $Address) { return $true }
    if ($Address -eq '127.0.0.1' -or $Address -eq '::1') { return $true }
    return (@(Get-LanIPv4 -IncludeVirtual) -contains $Address)
}

function Show-CheckConnection {
    Clear-Host
    Write-Host 'Check connection' -ForegroundColor Cyan
    Write-Host ''
    Write-Host ("This PC: {0} ({1})" -f (Get-DisplayName), $env:COMPUTERNAME)
    $mine = @(Get-LanIPv4)
    if ($mine.Count -eq 0) { Write-Host 'LAN address: none' }
    else { Write-Host ("LAN address: " + ($mine -join ', ')) }
    $hidden = @(Get-LanIPv4 -IncludeVirtual | Where-Object { $mine -notcontains $_ })
    if ($hidden.Count -gt 0) {
        Write-Host ("Ignored (virtual adapter): " + ($hidden -join ', ')) -ForegroundColor DarkGray
    }
    if (@(Get-PublicNetworkProfiles).Count -gt 0) {
        Write-Host ''
        Show-NetworkWarning
    }
    Write-Host ''
    Write-Host 'Looking for other PCs...'
    $raw = @(Receive-Beacons -Seconds 4 | Where-Object { -not (Test-OwnAddress $_.IP) })
    $best = @{}
    foreach ($share in $raw) {
        $rank = 1
        if ($share.Token -eq 'QUICK' -or $share.Token -eq 'CHAT') { $rank = 2 }
        elseif ($share.Token -ne 'OPEN') { $rank = 3 }
        $prev = $best[$share.IP]
        if (-not $prev -or $rank -ge $prev.Rank) {
            $share.Rank = $rank
            $best[$share.IP] = $share
        }
    }
    $shares = @($best.Values)
    if ($shares.Count -eq 0) {
        Write-Host "No other PC is listed. The other PC needs $($script:AppName) open, or Quick receive turned on." -ForegroundColor Yellow
    }
    foreach ($share in $shares) {
        $ping = Test-Icmp $share.IP
        Write-Host ''
        Write-Host ("{0} ({1})" -f $share.Display, $share.Windows) -ForegroundColor Cyan
        if ($share.Token -eq 'OPEN' -or $share.Port -le 0) {
            Write-Host ("  {0}  ping {1}  {2} is open" -f $share.IP, (Format-Check $ping), $script:AppName)
        }
        elseif ($share.Token -eq 'QUICK') {
            $tcp = Test-TcpOpen $share.IP $share.Port
            Write-Host ("  {0}:{1}  ping {2}  quick receive {3}" -f $share.IP, $share.Port, (Format-Check $ping), (Format-Check $tcp))
        }
        elseif ($share.Token -eq 'CHAT') {
            $tcp = Test-TcpOpen $share.IP $share.Port
            Write-Host ("  {0}:{1}  ping {2}  auto chat {3}" -f $share.IP, $share.Port, (Format-Check $ping), (Format-Check $tcp))
        }
        else {
            $tcp = Test-TcpOpen $share.IP $share.Port
            Write-Host ("  {0}:{1}  ping {2}  transfer port {3}  {4}" -f $share.IP, $share.Port, (Format-Check $ping), (Format-Check $tcp), $share.File)
        }
    }
    Write-Host ''
    Write-Host 'Ping can fail on Windows even when a transfer would work. The transfer port is the result that matters.'
    $ip = Read-Host 'Type an IP to check, or press Enter to go back'
    if ($ip) {
        $ip = $ip.Trim()
        $ping = Test-Icmp $ip
        $open = $null
        foreach ($candidate in $script:PortFirst..$script:PortLast) {
            if (Test-TcpOpen $ip $candidate) { $open = $candidate; break }
        }
        Write-Host ''
        Write-Host ("{0}  ping {1}" -f $ip, (Format-Check $ping))
        if ($open) { Write-Host "Transfer port ${open}: ok" -ForegroundColor Green }
        else { Write-Host 'Transfer port: not open. That PC may not be sending right now.' -ForegroundColor Yellow }
        Wait-Enter
    }
}

function ConvertTo-SafeFileName {
    param([string]$Name, [string]$Fallback)
    $leaf = [IO.Path]::GetFileName($Name)
    if ([string]::IsNullOrWhiteSpace($leaf)) { $leaf = $Fallback }
    foreach ($ch in [IO.Path]::GetInvalidFileNameChars()) {
        $leaf = $leaf.Replace([string]$ch, '_')
    }
    $leaf = $leaf.Trim().TrimEnd('.')
    if ([string]::IsNullOrWhiteSpace($leaf)) { $leaf = $Fallback }
    $base = ($leaf -split '\.')[0].TrimEnd()
    if (@('CON', 'PRN', 'AUX', 'NUL', 'COM1', 'COM2', 'COM3', 'COM4', 'COM5', 'COM6', 'COM7', 'COM8', 'COM9', 'LPT1', 'LPT2', 'LPT3', 'LPT4', 'LPT5', 'LPT6', 'LPT7', 'LPT8', 'LPT9') -contains $base.ToUpperInvariant()) {
        $leaf = "_$leaf"
    }
    return $leaf
}

function Get-UniqueFilePath {
    param([string]$Directory, [string]$Name)
    $leaf = ConvertTo-SafeFileName -Name $Name -Fallback "$($script:AppName)-download"
    $dest = Join-Path $Directory $leaf
    $base = [IO.Path]::GetFileNameWithoutExtension($leaf)
    $ext = [IO.Path]::GetExtension($leaf)
    $i = 1
    while (Test-Path -LiteralPath $dest) {
        $dest = Join-Path $Directory ("{0} ({1}){2}" -f $base, $i, $ext)
        $i++
    }
    return $dest
}

function Save-RemoteFile {
    param([string]$Url, [string]$Directory, [switch]$Quiet)
    Add-Type -AssemblyName System.Net.Http
    if (-not (Test-Path -LiteralPath $Directory)) {
        New-Item -ItemType Directory -Force -Path $Directory | Out-Null
    }
    $uriInfo = $null
    try { $uriInfo = [Uri]$Url } catch { }
    if ($uriInfo) {
        Write-TransferDebug 'receive.pin.start' @{ address = $uriInfo.Host; port = $uriInfo.Port; directory = $Directory }
    } else {
        Write-TransferDebug 'receive.pin.start' @{ address = 'unknown'; directory = $Directory }
    }
    $client = New-Object System.Net.Http.HttpClient
    $client.Timeout = [TimeSpan]::FromHours(6)
    $dest = $null
    $ownsDestination = $false
    $resp = $null
    try {
        $resp = $client.GetAsync($Url, [System.Net.Http.HttpCompletionOption]::ResponseHeadersRead).GetAwaiter().GetResult()
        if (-not $resp.IsSuccessStatusCode) {
            $errText = ''
            try { $errText = $resp.Content.ReadAsStringAsync().GetAwaiter().GetResult() } catch {}
            throw "Download failed ($([int]$resp.StatusCode)). $errText"
        }
        $total = $resp.Content.Headers.ContentLength
        $disposition = $resp.Content.Headers.ContentDisposition
        $name = $null
        if ($disposition) {
            if ($disposition.FileNameStar) { $name = $disposition.FileNameStar.Trim('"') }
            elseif ($disposition.FileName) { $name = $disposition.FileName.Trim('"') }
        }
        if (-not $name) { $name = "$($script:AppName)-download" }
        $dest = Get-UniqueFilePath $Directory $name
        Write-TransferDebug 'receive.pin.headers' @{ file = $name; size = $total; path = $dest }
        $inputStream = $resp.Content.ReadAsStreamAsync().GetAwaiter().GetResult()
        $output = [IO.File]::Open($dest, [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::None)
        $ownsDestination = $true
        $last = -1
        $readTotal = 0L
        try {
            $buf = New-Object byte[] (1MB)
            while (($n = $inputStream.Read($buf, 0, $buf.Length)) -gt 0) {
                $output.Write($buf, 0, $n)
                $readTotal += $n
                if (-not $Quiet -and $total -and $total -gt 0) {
                    $pct = [int](($readTotal * 100) / $total)
                    if ($pct -gt 100) { $pct = 100 }
                    if ($pct -ne $last) {
                        Write-PercentLine -Label ("Receiving " + (Get-ShortText $name 28)) -Percent $pct -Size ([long]$total)
                        $last = $pct
                    }
                }
            }
            if (-not $Quiet -and $last -ge 0) { Write-Host '' }
        } finally {
            $output.Dispose()
            $inputStream.Dispose()
        }
        if ($total -and $total -gt 0 -and $readTotal -lt [long]$total) {
            Remove-Item -LiteralPath $dest -Force -ErrorAction SilentlyContinue
            throw "Download stopped early after $(Format-ByteSize $readTotal) of $(Format-ByteSize ([long]$total))."
        }
        Write-TransferDebug 'receive.pin.saved' @{ file = $name; path = $dest; bytes = $readTotal; expected = $total }
        return $dest
    } catch {
        if ($ownsDestination -and $dest) { Remove-Item -LiteralPath $dest -Force -ErrorAction SilentlyContinue }
        Write-TransferDebug 'receive.pin.failed' @{ error = $_.Exception.Message; directory = $Directory }
        throw
    } finally {
        if ($resp) { $resp.Dispose() }
        $client.Dispose()
    }
}

function Show-ReceiveFiles {
    while ($true) {
        $state = if (Test-QuickReceive) { 'On' } else { 'Off' }
        $pick = Read-ArrowMenu -Title 'Receive files' -Lines @(
            'Received files are saved in your Inbox.',
            ("Quick receive: {0} (no PIN needed)" -f $state)
        ) -Items @('Open Inbox', 'Receive with a PIN', ("Quick receive: {0}" -f $state)) -Descriptions @(
            'See files already received.',
            'Find a sender and enter the PIN shown on their PC.',
            'Toggle receiving in the background, including after restarting Windows.'
        ) -ZeroLabel 'Back'
        switch ($pick) {
            0 { Open-InboxFront }
            1 { Show-ReceiveWithPin }
            2 { Set-QuickReceive -On (-not (Test-QuickReceive)) }
            default { return }
        }
    }
}

function Show-ReceiveWithPin {
    Clear-Host
    Write-Host 'Receive files' -ForegroundColor Cyan
    Write-Host ''
    Write-Host (Get-ReceiveStepsText)
    Write-Host ''
    Write-Host 'Looking for a PC that is sending...'
    $shares = @(Receive-Beacons -Seconds 5 | Where-Object {
        $_.Token -match '^[a-fA-F0-9]{16}$' -and $_.Port -gt 0 -and -not (Test-OwnAddress $_.IP)
    })
    if ($shares.Count -eq 0) {
        Write-Host 'Nobody is sending right now. Start Send on the other PC, then try again.' -ForegroundColor Yellow
        Wait-Enter
        return
    }
    $chosen = $null
    if ($shares.Count -eq 1) {
        $chosen = $shares[0]
    } else {
        $labels = @($shares | ForEach-Object {
            "{0} ({1})  {2}  {3}" -f $_.Display, $_.Windows, $_.File, (Format-ByteSize $_.Size)
        })
        $pick = Read-ArrowMenu -Title 'Receive files' -Lines @('Pick a PC that is sending.') -Items $labels -Descriptions @($shares | ForEach-Object { 'Download what this PC is sending into your Inbox.' }) -ZeroLabel 'Back'
        if ($pick -lt 0) { return }
        $chosen = $shares[$pick]
    }
    $ping = Test-Icmp $chosen.IP
    $tcp = Test-TcpOpen $chosen.IP $chosen.Port
    Write-Host ''
    Write-Host ("{0} ({1})" -f $chosen.Display, $chosen.Windows)
    Write-Host ("{0}  ({1})" -f $chosen.File, (Format-ByteSize $chosen.Size))
    Write-Host ("ping {0}   transfer port {1}" -f (Format-Check $ping), (Format-Check $tcp))
    if (-not $tcp) {
        Write-Host 'The transfer port is not open from here.' -ForegroundColor Yellow
    }
    $tries = 0
    while ($tries -lt 3) {
        $pin = Read-Host 'PIN'
        if (-not $pin) { return }
        $pin = $pin.Trim()
        $url = "http://$($chosen.IP):$($chosen.Port)/d/$($chosen.Token)?pin=$([Uri]::EscapeDataString($pin))"
        try {
            $saved = Save-RemoteFile -Url $url -Directory (Get-InboxPath)
            Write-Host ''
            Write-Host "Saved to $saved" -ForegroundColor Green
            Open-ContainingFolder $saved
            Wait-Enter
            return
        } catch {
            $tries++
            Write-Host $_.Exception.Message -ForegroundColor Red
            if ($tries -ge 3) { Wait-Enter; return }
        }
    }
}

function Get-ChatFlagPath { Join-Path (Get-SlipRoot) 'chat.txt' }
function Get-ChatDir { Join-Path (Get-SlipRoot) 'Chat' }
function Get-ChatLogPath { Join-Path (Get-ChatDir) 'chat.log' }
function Get-ChatPidPath { Join-Path (Get-SlipCommandDir) 'chat.pid' }
function Get-ChatPortPath { Join-Path (Get-SlipCommandDir) 'chat.port' }
function Get-ChatRunName { "$($script:AppName)AutoChat" }

function Get-SlipLaunchPath {
    if ($PSCommandPath -and (Test-Path -LiteralPath $PSCommandPath)) { return $PSCommandPath }
    return (Get-InstalledScriptPath)
}

function Test-AutoChat {
    $path = Get-ChatFlagPath
    if (-not (Test-Path -LiteralPath $path)) { return $true }
    $raw = Get-Content -LiteralPath $path -Raw -ErrorAction SilentlyContinue
    if ($raw -match 'off') { return $false }
    return $true
}

function Set-AutoChatFlag {
    param([bool]$On)
    Ensure-SlipFiles | Out-Null
    $value = if ($On) { 'on' } else { 'off' }
    Set-Content -LiteralPath (Get-ChatFlagPath) -Value $value -Encoding ASCII
}

function Test-AutoChatListenerAlive {
    $chatPid = 0
    $path = Get-ChatPidPath
    if (Test-Path -LiteralPath $path) {
        [void][int]::TryParse((Get-Content -LiteralPath $path -Raw -ErrorAction SilentlyContinue).Trim(), [ref]$chatPid)
    }
    return $null -ne (Get-SlipListenerProcess -ProcessId $chatPid -Entry 'chatlisten')
}

function Start-AutoChatListener {
    $scriptPath = Get-InstalledScriptPath
    if (-not (Test-Path -LiteralPath $scriptPath)) { return $false }
    Remove-Item -LiteralPath (Get-ChatPidPath) -Force -ErrorAction SilentlyContinue
    Remove-Item -LiteralPath (Get-ChatPortPath) -Force -ErrorAction SilentlyContinue
    $proc = Start-SlipBackground 'chatlisten'
    Write-TransferDebug 'chat.auto.started' @{ pid = $proc.Id; script = $scriptPath }
    return $true
}

function Protect-ChatText {
    param([string]$Text)
    Add-Type -AssemblyName System.Security
    $bytes = [Text.Encoding]::UTF8.GetBytes($Text)
    $protected = [Security.Cryptography.ProtectedData]::Protect($bytes, $null, [Security.Cryptography.DataProtectionScope]::CurrentUser)
    return [Convert]::ToBase64String($protected)
}

function Unprotect-ChatText {
    param([string]$Stored)
    Add-Type -AssemblyName System.Security
    $bytes = [Convert]::FromBase64String($Stored.Trim())
    $plain = [Security.Cryptography.ProtectedData]::Unprotect($bytes, $null, [Security.Cryptography.DataProtectionScope]::CurrentUser)
    return [Text.Encoding]::UTF8.GetString($plain)
}

function Write-ChatLog {
    param([string]$Room, [string]$Kind, [string]$Name, [string]$Text)
    $dir = Get-ChatDir
    if (-not (Test-Path -LiteralPath $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }
    $line = '{0}|{1}|{2}|{3}|{4}' -f (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'), $Room, $Kind, ($Name -replace '\|', '/'), (($Text -replace '[\r\n]+', ' '))
    Add-Content -LiteralPath (Get-ChatLogPath) -Value (Protect-ChatText $line) -Encoding ASCII
}

function Show-ChatLog {
    Clear-Host
    Write-Host 'Chat log' -ForegroundColor Cyan
    Write-Host ("Version {0}" -f $script:Version) -ForegroundColor DarkGray
    Write-Host ''
    $path = Get-ChatLogPath
    if (-not (Test-Path -LiteralPath $path)) {
        Write-Host 'No chat log yet.' -ForegroundColor Yellow
        Wait-Enter
        return
    }
    $shown = 0
    foreach ($stored in @(Get-Content -LiteralPath $path -ErrorAction SilentlyContinue)) {
        if ([string]::IsNullOrWhiteSpace($stored)) { continue }
        try { $line = Unprotect-ChatText $stored } catch { continue }
        $parts = $line.Split('|')
        if ($parts.Length -lt 5) { continue }
        $when = $parts[0]
        $kind = $parts[2]
        $who = $parts[3]
        $text = ($parts[4..($parts.Length - 1)] -join '|')
        switch ($kind) {
            'msg' { Write-Host ("{0}  {1}: {2}" -f $when, $who, $text) }
            'joined' { Write-Host ("{0}  {1} joined" -f $when, $who) -ForegroundColor DarkGray }
            'left' { Write-Host ("{0}  {1} left" -f $when, $who) -ForegroundColor DarkGray }
            'closed' { Write-Host ("{0}  chat closed" -f $when) -ForegroundColor DarkGray }
        }
        $shown++
    }
    if ($shown -eq 0) { Write-Host 'The chat log could not be read on this Windows user.' -ForegroundColor Yellow }
    Wait-Enter
}

function Format-ChatNotice {
    param([string]$Kind, [string]$Name)
    switch ($Kind) {
        'joined' { return "$Name joined" }
        'left' { return "$Name left" }
        'closed' { return 'chat closed' }
        default { return $Kind }
    }
}

function Send-ChatWire {
    param($Stream, [string]$Line)
    $bytes = [Text.Encoding]::UTF8.GetBytes($Line + "`n")
    $Stream.Write($bytes, 0, $bytes.Length)
    $Stream.Flush()
}

function Receive-ChatWire {
    param($Member)
    $found = @()
    $stream = $Member.Stream
    if (-not $stream.DataAvailable) { return $found }
    $buf = New-Object byte[] 4096
    while ($stream.DataAvailable) {
        $n = $stream.Read($buf, 0, $buf.Length)
        if ($n -le 0) { break }
        $Member.Pending += [Text.Encoding]::UTF8.GetString($buf, 0, $n)
    }
    while ($Member.Pending.Contains("`n")) {
        $cut = $Member.Pending.IndexOf("`n")
        $line = $Member.Pending.Substring(0, $cut).TrimEnd("`r")
        $Member.Pending = $Member.Pending.Substring($cut + 1)
        if ($line) { $found += $line }
    }
    return $found
}

function Test-SocketDead {
    param($Client)
    if (-not $Client) { return $false }
    try {
        $sock = $Client.Client
        if (-not $sock) { return $true }
        # Poll returns true when the socket is readable. If it is readable but no
        # bytes are waiting, the other end has closed or reset the connection -
        # which is what happens when that PC closes the window or presses Ctrl+C.
        if ($sock.Poll(0, [System.Net.Sockets.SelectMode]::SelectRead) -and $sock.Available -eq 0) { return $true }
        return $false
    } catch { return $true }
}

function Start-ChatConsole {
    param([string]$EntryArgs, [string]$Title = 'Slip chat')
    # Open a normal Command Prompt window that hosts the chat, instead of taking
    # over the current Slip window or opening a PowerShell window. cmd.exe gives
    # the plain console; it runs the PowerShell chat entry inside it. The title
    # is stripped to safe characters so a peer's name can never inject a command.
    # EntryArgs only ever carries base64 fields plus an IP/port/room, none of
    # which are cmd metacharacters.
    $scriptPath = Get-SlipLaunchPath
    $safeTitle = ($Title -replace '[^\w \-]', '').Trim()
    if (-not $safeTitle) { $safeTitle = 'Slip chat' }
    if ($safeTitle.Length -gt 40) { $safeTitle = $safeTitle.Substring(0, 40) }
    $inner = 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "{0}" {1}' -f $scriptPath, $EntryArgs
    $full = '/c title {0} & {1}' -f $safeTitle, $inner
    Start-Process -FilePath $env:ComSpec -ArgumentList $full | Out-Null
}

function Start-ChatPopup {
    param([string]$Room, [string]$Address, [int]$Port, [string]$FromName, [string]$Text)
    $payload = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($Text))
    $from = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($FromName))
    $entryArgs = "chatjoin -Room $Room -Address $Address -Port $Port -PeerName $from -OpeningB64 $payload"
    Write-TransferDebug 'chat.popup.start' @{ remote = $Address; port = $Port; from = $FromName }
    Start-ChatConsole -EntryArgs $entryArgs -Title ("Slip chat - {0}" -f $FromName)
}

function Enable-AutoChat {
    param([switch]$Quiet)
    Set-AutoChatFlag $true
    Install-SlipCommand
    $scriptPath = Get-InstalledScriptPath
    $value = Get-BackgroundCommandLine 'chatlisten'
    $runPath = 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Run'
    try {
        if (-not (Test-Path -LiteralPath $runPath)) { New-Item -Path $runPath -Force | Out-Null }
        New-ItemProperty -LiteralPath $runPath -Name (Get-ChatRunName) -Value $value -PropertyType String -Force | Out-Null
    } catch { }
    if (-not (Test-AutoChatListenerAlive)) {
        [void](Start-AutoChatListener)
    } else {
        $chatPid = [int](Get-Content -LiteralPath (Get-ChatPidPath) -Raw -ErrorAction SilentlyContinue)
        Write-TransferDebug 'chat.auto.alive' @{ pid = $chatPid; script = $scriptPath }
    }
    if (-not $Quiet) {
        Write-Host 'Auto chat is on. A message from another PC opens a chat window.' -ForegroundColor Green
        Read-Host 'Press Enter'
    }
}

function Stop-AutoChat {
    $flag = Get-ChatFlagPath
    if (Test-Path -LiteralPath (Get-SlipRoot)) {
        if (Test-Path -LiteralPath $flag) { Set-Content -LiteralPath $flag -Value 'off' -Encoding ASCII }
    }
    if (Test-Path -LiteralPath (Get-ChatPidPath)) {
        $chatPid = 0
        if ([int]::TryParse((Get-Content -LiteralPath (Get-ChatPidPath) -Raw -ErrorAction SilentlyContinue).Trim(), [ref]$chatPid)) {
            Stop-SlipListenerProcess -ProcessId $chatPid -Entry 'chatlisten'
        }
        Remove-Item -LiteralPath (Get-ChatPidPath) -Force -ErrorAction SilentlyContinue
    }
    Remove-Item -LiteralPath (Get-ChatPortPath) -Force -ErrorAction SilentlyContinue
    try {
        Remove-ItemProperty -LiteralPath 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Run' -Name (Get-ChatRunName) -ErrorAction SilentlyContinue
    } catch { }
}

function Set-AutoChat {
    param([bool]$On)
    if ($On) { Enable-AutoChat }
    else {
        Stop-AutoChat
        Write-Host 'Auto chat is off.' -ForegroundColor Green
        Read-Host 'Press Enter'
    }
}

function Ensure-AutoChat {
    if (-not (Test-AutoChat)) { return }
    if (-not (Test-SlipInstalled)) { return }
    if (Test-AutoChatListenerAlive) { return }
    [void](Start-AutoChatListener)
}

function Start-ChatListener {
    $root = Get-SlipRoot
    if (-not (Test-Path -LiteralPath $root)) { return }
    $flag = Get-ChatFlagPath
    $pidFile = Get-ChatPidPath
    $portFile = Get-ChatPortPath
    $dir = Split-Path -Parent $pidFile
    if (-not (Test-Path -LiteralPath $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }
    Set-Content -LiteralPath $pidFile -Value $PID -Encoding ASCII
    $listener = New-SlipTcpListener
    $port = ([Net.IPEndPoint]$listener.LocalEndpoint).Port
    Set-Content -LiteralPath $portFile -Value $port -Encoding ASCII
    Write-TransferDebug 'chat.listener.started' @{ port = $port; pid = $PID; name = (Get-DisplayName) }
    try {
        while ((Get-Content -LiteralPath $flag -Raw -ErrorAction SilentlyContinue) -notmatch 'off') {
            $name = Get-DisplayName
            $payload = '{0}|CHAT|{1}|{2}|{3}|0|chat' -f $script:BeaconPrefix, $port, (ConvertTo-BeaconField $name), (ConvertTo-BeaconField $env:COMPUTERNAME)
            try { [void](Send-BeaconPayload -Payload $payload -Port $script:BeaconPort) } catch { }
            if (-not $listener.Pending()) {
                Start-Sleep -Milliseconds 100
                continue
            }
            $client = $listener.AcceptTcpClient()
            try {
                $stream = $client.GetStream()
                $stream.ReadTimeout = 5000
                $reader = New-Object IO.StreamReader($stream, [Text.Encoding]::UTF8, $false, 1024, $true)
                $line = $reader.ReadLine()
                if ($line -and $line -match '^(?i)ENABLE\s+quick$') {
                    Enable-QuickReceive -Quiet
                    $ack = [Text.Encoding]::ASCII.GetBytes("OK`n")
                    $stream.Write($ack, 0, $ack.Length)
                    Write-TransferDebug 'chat.enable' @{ remote = $client.Client.RemoteEndPoint.ToString(); which = 'quick' }
                }
                elseif ($line -and $line.StartsWith('INVITE|')) {
                    $parts = $line.Split('|')
                    if ($parts.Length -ge 5) {
                        $room = $parts[1]
                        $hostPort = 0
                        [void][int]::TryParse($parts[2], [ref]$hostPort)
                        $from = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($parts[3]))
                        $text = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($parts[4]))
                        $hostIp = $client.Client.RemoteEndPoint.Address.ToString()
                        if ($hostPort -gt 0 -and $text) {
                            Write-TransferDebug 'chat.invite.received' @{ remote = $hostIp; port = $hostPort; from = $from; bytes = $text.Length }
                            Start-ChatPopup -Room $room -Address $hostIp -Port $hostPort -FromName $from -Text $text
                            $ack = [Text.Encoding]::ASCII.GetBytes("OK`n")
                            $stream.Write($ack, 0, $ack.Length)
                        }
                    }
                }
            } catch { }
            finally { try { $client.Close() } catch { } }
        }
    }
    finally {
        $listener.Stop()
        Remove-Item -LiteralPath $pidFile -Force -ErrorAction SilentlyContinue
        Remove-Item -LiteralPath $portFile -Force -ErrorAction SilentlyContinue
        Write-TransferDebug 'chat.listener.stopped' @{ port = $port; pid = $PID }
    }
}

function Get-RemoteHelpFlagPath { Join-Path (Get-SlipRoot) 'remote-help.txt' }
function Get-RemoteHelpSecretPath { Join-Path (Get-SlipCommandDir) 'remote-help.key' }
function Get-RemoteHelpPidPath { Join-Path (Get-SlipCommandDir) 'remote-help.pid' }
function Get-RemoteHelpPortPath { Join-Path (Get-SlipCommandDir) 'remote-help.port' }

function Test-RemoteHelp {
    $path = Get-RemoteHelpFlagPath
    if (-not (Test-Path -LiteralPath $path)) { return $false }
    return ((Get-Content -LiteralPath $path -Raw -ErrorAction SilentlyContinue) -match 'on')
}

function ConvertTo-HexString {
    param([byte[]]$Bytes)
    return (($Bytes | ForEach-Object { $_.ToString('X2') }) -join '')
}

function ConvertFrom-HexString {
    param([string]$Text)
    $clean = ($Text -replace '[^0-9A-Fa-f]', '')
    if (($clean.Length % 2) -ne 0) { throw 'Invalid hexadecimal value.' }
    $bytes = New-Object byte[] ($clean.Length / 2)
    for ($index = 0; $index -lt $bytes.Length; $index++) {
        $bytes[$index] = [Convert]::ToByte($clean.Substring($index * 2, 2), 16)
    }
    return $bytes
}

function Get-RemoteHelpSecret {
    param([switch]$Create)
    $path = Get-RemoteHelpSecretPath
    if (Test-Path -LiteralPath $path) {
        try {
            Add-Type -AssemblyName System.Security | Out-Null
            $protected = [Convert]::FromBase64String((Get-Content -LiteralPath $path -Raw).Trim())
            return [Security.Cryptography.ProtectedData]::Unprotect($protected, $null, [Security.Cryptography.DataProtectionScope]::CurrentUser)
        } catch {
            if (-not $Create) { return $null }
        }
    }
    if (-not $Create) { return $null }
    $secret = New-Object byte[] 12
    $rng = New-Object Security.Cryptography.RNGCryptoServiceProvider
    try { $rng.GetBytes($secret) } finally { $rng.Dispose() }
    Add-Type -AssemblyName System.Security | Out-Null
    $protected = [Security.Cryptography.ProtectedData]::Protect($secret, $null, [Security.Cryptography.DataProtectionScope]::CurrentUser)
    $dir = Split-Path -Parent $path
    if (-not (Test-Path -LiteralPath $dir)) { New-Item -ItemType Directory -Force -Path $dir | Out-Null }
    Set-Content -LiteralPath $path -Value ([Convert]::ToBase64String($protected)) -Encoding ASCII
    return $secret
}

function Get-RemoteHelpKey {
    param([switch]$Create)
    $secret = Get-RemoteHelpSecret -Create:$Create
    if (-not $secret) { return $null }
    $sha = [Security.Cryptography.SHA256]::Create()
    try { return $sha.ComputeHash($secret) } finally { $sha.Dispose() }
}

function Get-RemoteHelpPairingCode {
    $secret = Get-RemoteHelpSecret -Create
    $hex = ConvertTo-HexString $secret
    return (($hex -split '(.{4})' | Where-Object { $_ }) -join '-')
}

function Test-FixedTimeBytes {
    param([byte[]]$Left, [byte[]]$Right)
    if (-not $Left -or -not $Right -or $Left.Length -ne $Right.Length) { return $false }
    $different = 0
    for ($index = 0; $index -lt $Left.Length; $index++) {
        $different = $different -bor ($Left[$index] -bxor $Right[$index])
    }
    return ($different -eq 0)
}

function Get-HmacBytes {
    param([byte[]]$Key, [byte[]]$Bytes)
    $hmac = New-Object Security.Cryptography.HMACSHA256 (,$Key)
    try { return $hmac.ComputeHash($Bytes) } finally { $hmac.Dispose() }
}

function Get-RemoteHelpSubkey {
    param([byte[]]$Key, [string]$Purpose)
    return (Get-HmacBytes -Key $Key -Bytes ([Text.Encoding]::UTF8.GetBytes("Slip remote help $Purpose")))
}

function Protect-RemoteHelpResult {
    param([byte[]]$Key, [string]$Text)
    $encryptionKey = Get-RemoteHelpSubkey -Key $Key -Purpose 'encryption'
    $responseKey = Get-RemoteHelpSubkey -Key $Key -Purpose 'response authentication'
    $aes = [Security.Cryptography.Aes]::Create()
    try {
        $aes.Key = $encryptionKey
        $aes.Mode = [Security.Cryptography.CipherMode]::CBC
        $aes.Padding = [Security.Cryptography.PaddingMode]::PKCS7
        $aes.GenerateIV()
        $plain = [Text.Encoding]::UTF8.GetBytes($Text)
        $encryptor = $aes.CreateEncryptor()
        try { $cipher = $encryptor.TransformFinalBlock($plain, 0, $plain.Length) } finally { $encryptor.Dispose() }
        $signed = New-Object byte[] ($aes.IV.Length + $cipher.Length)
        [Array]::Copy($aes.IV, 0, $signed, 0, $aes.IV.Length)
        [Array]::Copy($cipher, 0, $signed, $aes.IV.Length, $cipher.Length)
        $mac = Get-HmacBytes -Key $responseKey -Bytes $signed
        return 'RESULT1|{0}|{1}|{2}' -f [Convert]::ToBase64String($aes.IV), [Convert]::ToBase64String($cipher), (ConvertTo-HexString $mac)
    } finally { $aes.Dispose() }
}

function Read-RemoteHelpLine {
    param($Stream, [int]$Maximum = 4096)
    $memory = New-Object IO.MemoryStream
    $one = New-Object byte[] 1
    try {
        while ($memory.Length -lt $Maximum) {
            $read = $Stream.Read($one, 0, 1)
            if ($read -le 0) { break }
            if ($one[0] -eq 10) { break }
            if ($one[0] -ne 13) { $memory.WriteByte($one[0]) }
        }
        return [Text.Encoding]::UTF8.GetString($memory.ToArray())
    } finally { $memory.Dispose() }
}

function Get-ListenerReport {
    param([string]$PidPath, [string]$PortPath, [bool]$Enabled)
