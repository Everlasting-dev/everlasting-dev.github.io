function Get-ProfilePaths {
    $doc = Join-Path $env:USERPROFILE 'Documents'
    $win = Join-Path (Join-Path $doc 'WindowsPowerShell') 'Microsoft.PowerShell_profile.ps1'
    $ps7 = Join-Path (Join-Path $doc 'PowerShell') 'Microsoft.PowerShell_profile.ps1'
    $list = @($win)
    if (Test-Path -LiteralPath $ps7) { $list += $ps7 }
    return @($list | Select-Object -Unique)
}

function Get-SlipFunctionBlock {
@"
# >>> $($script:CommandName) >>>
function $($script:CommandName) {
    `$tmp = Join-Path `$env:TEMP '$($script:CommandName)-get.ps1'
    Invoke-RestMethod -Uri '$($script:SourceUrl)' -OutFile `$tmp
    try {
        & powershell.exe -NoProfile -ExecutionPolicy Bypass -File `$tmp menu @args
    } finally {
        Remove-Item -LiteralPath `$tmp -Force -ErrorAction SilentlyContinue
    }
}
# <<< $($script:CommandName) <<<
"@
}

function Set-ProfileBlock {
    $block = (Get-SlipFunctionBlock).Trim() + "`r`n"
    $pattern = "(?s)# >>> $($script:CommandName) >>>.*?# <<< $($script:CommandName) <<<\s*"
    foreach ($path in (Get-ProfilePaths)) {
        $dir = Split-Path -Parent $path
        if (-not (Test-Path -LiteralPath $dir)) {
            New-Item -ItemType Directory -Force -Path $dir | Out-Null
        }
        $existing = ''
        if (Test-Path -LiteralPath $path) {
            $existing = [IO.File]::ReadAllText($path)
        }
        if ($existing -match $pattern) {
            $updated = [regex]::Replace($existing, $pattern, $block)
        } else {
            $prefix = $existing
            if ($prefix -and -not $prefix.EndsWith("`n")) { $prefix += "`r`n" }
            if ($prefix) { $prefix += "`r`n" }
            $updated = $prefix + $block
        }
        [IO.File]::WriteAllText($path, $updated)
    }
}

function Remove-ProfileBlock {
    $pattern = "(?s)# >>> $($script:CommandName) >>>.*?# <<< $($script:CommandName) <<<\s*"
    foreach ($path in (Get-ProfilePaths)) {
        if (-not (Test-Path -LiteralPath $path)) { continue }
        $existing = [IO.File]::ReadAllText($path)
        if ($existing -notmatch $pattern) { continue }
        $updated = [regex]::Replace($existing, $pattern, '')
        [IO.File]::WriteAllText($path, $updated)
    }
}

function Test-FirewallRule {
    param([string]$Name)
    try {
        $rules = @(Get-NetFirewallRule -DisplayName $Name -ErrorAction Stop | Where-Object { $_.DisplayName -eq $Name })
        return ($rules.Count -gt 0)
    } catch {
        return $false
    }
}

function Install-FirewallRules {
    if (-not (Test-FirewallRule $script:RuleTcp)) {
        New-NetFirewallRule -DisplayName $script:RuleTcp -Direction Inbound -Action Allow -Protocol TCP -LocalPort "$($script:PortFirst)-$($script:PortLast)" -Profile Private | Out-Null
    }
    if (-not (Test-FirewallRule $script:RuleUdp)) {
        New-NetFirewallRule -DisplayName $script:RuleUdp -Direction Inbound -Action Allow -Protocol UDP -LocalPort $script:BeaconPort -Profile Private | Out-Null
    }
}

function Uninstall-FirewallRules {
    foreach ($name in @($script:RuleTcp, $script:RuleUdp)) {
        if (Test-FirewallRule $name) {
            Remove-NetFirewallRule -DisplayName $name -ErrorAction SilentlyContinue
        }
    }
}

function Invoke-ElevatedEntry {
    param([string]$Entry)
    if ($PSCommandPath) {
        $argList = "-NoProfile -ExecutionPolicy Bypass -File `"$PSCommandPath`" $Entry"
    } else {
        $cmd = "`$env:SLIP_ENTRY='$Entry'; iex ((Invoke-RestMethod -Uri '$($script:SourceUrl)').ToString())"
        $argList = "-NoProfile -ExecutionPolicy Bypass -Command `"$cmd`""
    }
    try {
        $proc = Start-Process -FilePath powershell.exe -Verb RunAs -Wait -PassThru -ArgumentList $argList
        if ($proc -and $null -ne $proc.ExitCode) { return [int]$proc.ExitCode }
        return 1
    } catch {
        return 1
    }
}

function Ensure-SlipFiles {
    param([string]$DisplayName)
    foreach ($dir in @((Get-SlipRoot), (Get-OutboxPath), (Get-InboxPath))) {
        if (-not (Test-Path -LiteralPath $dir)) {
            New-Item -ItemType Directory -Force -Path $dir | Out-Null
        }
    }
    Set-Content -LiteralPath (Get-HowToPath) -Value (Get-HowToText) -Encoding ASCII
    if ($DisplayName) {
        Set-Content -LiteralPath (Get-NamePath) -Value $DisplayName.Trim() -Encoding ASCII
    } elseif (-not (Test-Path -LiteralPath (Get-NamePath))) {
        Set-Content -LiteralPath (Get-NamePath) -Value $env:COMPUTERNAME -Encoding ASCII
    }
    Set-ProfileBlock
}

function Complete-SlipSetup {
    param([string]$DisplayName)
    Ensure-SlipFiles -DisplayName $DisplayName
    $ready = (Test-FirewallRule $script:RuleTcp) -and (Test-FirewallRule $script:RuleUdp)
    if (-not $ready) {
        if (Test-IsAdmin) {
            Install-FirewallRules
        } else {
            Write-Host 'Windows needs approval to allow this app on private networks.' -ForegroundColor Yellow
            $code = Invoke-ElevatedEntry -Entry 'firewall'
            if ($code -ne 0) {
                Write-Host 'Firewall rules were not added. Setup is not finished.' -ForegroundColor Red
                return $false
            }
        }
    }
    $ready = (Test-FirewallRule $script:RuleTcp) -and (Test-FirewallRule $script:RuleUdp)
    if (-not $ready) {
        Write-Host 'Firewall rules are still missing. Setup is not finished.' -ForegroundColor Red
        return $false
    }
    Set-Content -LiteralPath (Get-InstalledPath) -Value (Get-Date -Format 'o') -Encoding ASCII
    return $true
}

function Read-CleanName {
    param([string]$Fallback)
    $entered = Read-Host "Display name (Enter keeps $Fallback)"
    if ([string]::IsNullOrWhiteSpace($entered)) { return $Fallback }
    $clean = ($entered -replace '[|\r\n]', ' ').Trim()
    if ($clean.Length -gt 40) { $clean = $clean.Substring(0, 40).Trim() }
    if (-not $clean) { return $Fallback }
    return $clean
}

function Show-NetworkWarning {
    try {
        $profiles = @(Get-NetConnectionProfile -ErrorAction Stop | Where-Object {
            $_.NetworkCategory -ne 'Private' -and $_.NetworkCategory -ne 'DomainAuthenticated'
        })
        foreach ($item in $profiles) {
            Write-Host "This network ($($item.Name)) is $($item.NetworkCategory). Firewall rules apply to Private networks." -ForegroundColor Yellow
        }
    } catch {}
}

function Invoke-GetSlipFromLauncher {
    $installed = Test-SlipInstalled
    Clear-Host
    Write-Host "Get $($script:AppName)" -ForegroundColor Cyan
    Write-Host ''
    Write-Host "Windows name: $env:COMPUTERNAME"
    Write-Host ("Shown to other PCs as: " + (Get-DisplayName))
    Write-Host ''
    if (-not $installed) {
        Write-Host "$($script:AppName) is not on this PC yet." -ForegroundColor Yellow
        Write-Host ''
        Write-Host "Install will allow $($script:AppName) on private networks, create"
        Write-Host "Documents\$($script:AppName)\Outbox and Inbox, save the how-to,"
        Write-Host "and add the command: $($script:CommandName)"
        Write-Host ''
        Write-Host 'Nothing of yours is deleted.'
        Write-Host ''
        $name = Read-CleanName -Fallback $env:COMPUTERNAME
        $answer = Read-Host '[Y] Install  [N] Back'
        if ($answer -notmatch '^[Yy]') { return }
        Write-Host ''
        if (Complete-SlipSetup -DisplayName $name) {
            Write-Host ''
            Write-Host "$($script:AppName) is installed." -ForegroundColor Green
            Write-Host 'Next time, type this in a new PowerShell window:' -ForegroundColor Green
            Write-Host "  $($script:CommandName)" -ForegroundColor Green
            Show-NetworkWarning
            Write-Host ''
            Write-Host (Get-HowToText)
            Wait-Enter
            Show-SlipMenu -CanReturn
        } else {
            Wait-Enter
        }
        return
    }

    Write-Host "$($script:AppName) is already on this PC." -ForegroundColor Yellow
    Write-Host ''
    Write-Host 'Repair puts the firewall rules and the command back,'
    Write-Host 'and recreates Outbox or Inbox if those folders are missing.'
    Write-Host ''
    Write-Host 'Repair will not delete files in Outbox or Inbox.' -ForegroundColor Green
    Write-Host ''
    $answer = Read-Host '[Y] Repair  [N] Back'
    if ($answer -notmatch '^[Yy]') { return }
    Write-Host ''
    if (Complete-SlipSetup -DisplayName $null) {
        Write-Host ''
        Write-Host 'Repair finished. Your Outbox and Inbox files are still there.' -ForegroundColor Green
        Wait-Enter
        Show-SlipMenu -CanReturn
    } else {
        Wait-Enter
    }
}

