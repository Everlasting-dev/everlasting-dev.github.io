function Stop-QuickReceive {
    $flag = Get-QuickPath
    if (Test-Path -LiteralPath $flag) {
        Set-Content -LiteralPath $flag -Value 'off' -Encoding ASCII
    }
    $pidPath = Get-ListenPidPath
    if (Test-Path -LiteralPath $pidPath) {
        $listenPid = 0
        if ([int]::TryParse((Get-Content -LiteralPath $pidPath -Raw).Trim(), [ref]$listenPid)) {
            Stop-Process -Id $listenPid -Force -ErrorAction SilentlyContinue
        }
        Remove-Item -LiteralPath $pidPath -Force -ErrorAction SilentlyContinue
    }
    Remove-Item -LiteralPath (Get-ListenPortPath) -Force -ErrorAction SilentlyContinue
    Remove-QuickReceiveTask
    Remove-QuickReceiveRunKey
}

function Enable-QuickReceive {
    param([switch]$Quiet)
    Stop-QuickReceive
    Set-QuickReceiveFlag $true
    Install-SlipCommand
    $startup = Register-QuickReceiveStartup
    try {
        Start-QuickReceiveProcess
        Write-SlipLog "Quick receive listener started; startup=$startup."
    } catch {
        Write-SlipLog "Quick receive listener start failed: $($_.Exception.Message)"
        if (-not $Quiet) {
            Write-Host "Quick receive is on, but the listener did not start: $($_.Exception.Message)" -ForegroundColor Yellow
        }
    }
    if (-not $Quiet) {
        Write-Host 'Quick receive is on. This PC can take a file with no PIN.' -ForegroundColor Green
        Write-Host "Startup: $startup" -ForegroundColor DarkGray
    }
}

function Set-QuickReceive {
