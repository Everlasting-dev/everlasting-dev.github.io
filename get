function Test-IsAdmin {
    $id = [Security.Principal.WindowsIdentity]::GetCurrent()
    $principal = New-Object Security.Principal.WindowsPrincipal($id)
    return $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
}

function Send-EnvironmentChanged {
    try {
        if (-not ('SlipWin.EnvNotify' -as [type])) {
            Add-Type -Namespace SlipWin -Name EnvNotify -MemberDefinition '[DllImport("user32.dll", SetLastError=true, CharSet=CharSet.Auto)] public static extern IntPtr SendMessageTimeout(IntPtr hWnd, uint Msg, UIntPtr wParam, string lParam, uint fuFlags, uint uTimeout, out UIntPtr lpdwResult);' | Out-Null
        }
        $result = [UIntPtr]::Zero
        [void][SlipWin.EnvNotify]::SendMessageTimeout([IntPtr]0xffff, 0x1A, [UIntPtr]::Zero, 'Environment', 0x0002, 5000, [ref]$result)
    } catch { }
}

function Format-ByteSize {
    param([long]$Bytes)
    if ($Bytes -ge 1GB) { return ('{0:N1} GB' -f ($Bytes / 1GB)) }
    if ($Bytes -ge 1MB) { return ('{0:N1} MB' -f ($Bytes / 1MB)) }
    if ($Bytes -ge 1KB) { return ('{0:N1} KB' -f ($Bytes / 1KB)) }
    return "$Bytes B"
}

function Get-ShortText {
    param([string]$Text, [int]$Max = 42)
    if ([string]::IsNullOrEmpty($Text)) { return '' }
    if ($Text.Length -le $Max) { return $Text }
    return $Text.Substring(0, $Max - 3) + '...'
}

function Wait-Enter {
    Write-Host ''
    Write-Host 'Press Enter to continue.' -ForegroundColor DarkGray
    [void](Read-Host)
}

# Network helpers are kept in one scriptblock so the background presence loop in
# Start-PresenceLoop can dot-source the same definitions into its runspace
# instead of carrying a second copy of them.
$script:NetHelpers = {
    function Test-VirtualAdapterAlias {
        param([string]$Alias)
        if (-not $Alias) { return $false }
        $pattern = '(?i)(vEthernet|WSL|Hyper-V|Default Switch|VirtualBox|VMware|Docker|Loopback|Bluetooth|TAP-Windows|Tailscale|ZeroTier|Npcap|Local Area Connection\* \d+)'
        return [bool]([regex]::IsMatch($Alias, $pattern))
    }

    function Get-SubnetBroadcast {
        param([string]$Address, [int]$PrefixLength)
        try {
            if ($PrefixLength -lt 1 -or $PrefixLength -gt 31) { return '255.255.255.255' }
            $bytes = ([Net.IPAddress]::Parse($Address)).GetAddressBytes()
            for ($i = 0; $i -lt 4; $i++) {
                $take = [Math]::Max(0, [Math]::Min(8, $PrefixLength - ($i * 8)))
                $maskByte = 0
                if ($take -gt 0) { $maskByte = (0xFF -shl (8 - $take)) -band 0xFF }
                $bytes[$i] = [byte](($bytes[$i] -band $maskByte) -bor ((-bnot $maskByte) -band 0xFF))
            }
            return ([Net.IPAddress]$bytes).ToString()
        } catch {
            return '255.255.255.255'
        }
    }

    function Get-LanAddressRows {
        $rows = @()
        try {
            $profiles = @{}
            try {
                foreach ($item in @(Get-NetConnectionProfile -ErrorAction Stop)) {
                    $profiles[[int]$item.InterfaceIndex] = $item
                }
            } catch { }
            $metrics = @{}
            try {
                foreach ($item in @(Get-NetIPInterface -AddressFamily IPv4 -ErrorAction Stop)) {
                    $metrics[[int]$item.InterfaceIndex] = [int]$item.InterfaceMetric
                }
            } catch { }
            foreach ($addr in @(Get-NetIPAddress -AddressFamily IPv4 -ErrorAction Stop)) {
                $ip = [string]$addr.IPAddress
                if ($ip -like '127.*' -or $ip -like '169.254.*') { continue }
                if ($addr.PrefixOrigin -eq 'WellKnown') { continue }
                if ($addr.SkipAsSource) { continue }
                $index = [int]$addr.InterfaceIndex
                $alias = [string]$addr.InterfaceAlias
                $metric = 9999
                if ($metrics.ContainsKey($index)) { $metric = $metrics[$index] }
                $category = ''
                if ($profiles.ContainsKey($index)) { $category = [string]$profiles[$index].NetworkCategory }
                $rows += New-Object psobject -Property @{
                    IPAddress      = $ip
                    InterfaceIndex = $index
                    InterfaceAlias = $alias
                    PrefixLength   = [int]$addr.PrefixLength
                    Metric         = $metric
                    NetworkCategory = $category
                    HasProfile     = $profiles.ContainsKey($index)
                    Virtual        = (Test-VirtualAdapterAlias $alias)
                }
            }
        } catch {
            $rows = @()
        }
        if ($rows.Count -eq 0) { return @() }
        # A real adapter that Windows knows as a network comes first, then lowest
        # interface metric, so the address another PC can reach is always [0].
        $sorted = $rows | Sort-Object -Property @(
            @{ Expression = { if ($_.Virtual) { 2 } elseif ($_.HasProfile) { 0 } else { 1 } } },
            @{ Expression = { $_.Metric } },
            @{ Expression = { $_.IPAddress } }
        )
        return @($sorted)
    }

    function Get-BroadcastTargets {
        $rows = @(Get-LanAddressRows)
        $real = @($rows | Where-Object { -not $_.Virtual })
        if ($real.Count -eq 0) { $real = @($rows | Where-Object { $_.HasProfile }) }
        $targets = @()
        foreach ($row in $real) {
            $targets += New-Object psobject -Property @{
                Local     = $row.IPAddress
                Broadcast = (Get-SubnetBroadcast -Address $row.IPAddress -PrefixLength $row.PrefixLength)
            }
        }
        if ($targets.Count -eq 0) {
            $targets += New-Object psobject -Property @{ Local = ''; Broadcast = '255.255.255.255' }
        }
        return @($targets)
    }

    function Send-BeaconPayload {
        param([string]$Payload, [int]$Port)
        # An unbound socket sends 255.255.255.255 out one interface only, whichever
        # one the routing table picks by metric. On a PC with WSL, Hyper-V, or
        # Wi-Fi Direct adapters that is often not the LAN, so the beacon never
        # leaves the machine. Bind a socket to each real address instead.
        $bytes = [Text.Encoding]::UTF8.GetBytes($Payload)
        $sent = 0
        foreach ($target in @(Get-BroadcastTargets)) {
            $udp = $null
            try {
                $udp = New-Object System.Net.Sockets.UdpClient
                $udp.EnableBroadcast = $true
                if ($target.Local) {
                    $udp.Client.Bind((New-Object System.Net.IPEndPoint ([Net.IPAddress]::Parse($target.Local), 0)))
                }
                [void]$udp.Send($bytes, $bytes.Length, $target.Broadcast, $Port)
                if ($target.Broadcast -ne '255.255.255.255') {
                    try { [void]$udp.Send($bytes, $bytes.Length, '255.255.255.255', $Port) } catch { }
                }
                $sent++
            } catch { }
            finally { if ($udp) { try { $udp.Close() } catch { } } }
        }
        return $sent
    }
}
. $script:NetHelpers

function Get-LanIPv4 {
    param([switch]$IncludeVirtual)
    $rows = @(Get-LanAddressRows)
    if ($rows.Count -gt 0) {
        if (-not $IncludeVirtual) {
            $real = @($rows | Where-Object { -not $_.Virtual })
            if ($real.Count -gt 0) { return @($real | ForEach-Object { $_.IPAddress }) }
        }
        return @($rows | ForEach-Object { $_.IPAddress })
    }
    $ips = @()
    try {
        $ips = @([Net.Dns]::GetHostAddresses([Net.Dns]::GetHostName()) |
            Where-Object {
                $_.AddressFamily -eq 'InterNetwork' -and
                $_.ToString() -notlike '127.*' -and
                $_.ToString() -notlike '169.254.*'
            } |
            ForEach-Object { $_.ToString() })
    } catch {
        $ips = @()
    }
    return $ips
}

function Get-ActiveNetworkProfiles {
    $rows = @()
    try {
        foreach ($item in @(Get-NetConnectionProfile -ErrorAction Stop)) {
            if (Test-VirtualAdapterAlias ([string]$item.InterfaceAlias)) { continue }
            $rows += $item
        }
    } catch {
        $rows = @()
    }
    return @($rows)
}

function Get-PublicNetworkProfiles {
    return @(Get-ActiveNetworkProfiles | Where-Object {
        $_.NetworkCategory -ne 'Private' -and $_.NetworkCategory -ne 'DomainAuthenticated'
    })
}

function Set-ActiveNetworksPrivate {
    $changed = 0
    foreach ($item in (Get-PublicNetworkProfiles)) {
        try {
            Set-NetConnectionProfile -InterfaceIndex $item.InterfaceIndex -NetworkCategory Private -ErrorAction Stop
            $changed++
        } catch { }
    }
    return $changed
}

function Get-DisplayName {
    $path = Get-NamePath
    if (Test-Path -LiteralPath $path) {
        $name = Get-Content -LiteralPath $path -Raw -ErrorAction SilentlyContinue
        if ($name) { $name = $name.Trim() }
        if ($name) { return $name }
    }
    return $env:COMPUTERNAME
}

